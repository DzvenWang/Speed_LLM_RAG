#!/bin/bash
#PBS -P mh20
#PBS -q normal
#PBS -l ncpus=12
#PBS -l mem=64GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
# Read-only frozen weights. TEST cache preparation may write new test-only cache chunks.
set -euo pipefail
ROOT="${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-}}"
[[ -d "$ROOT/TCRR-STLA" ]] || { echo "Project root unavailable: $ROOT" >&2; exit 2; }
cd "$ROOT"
source TCRR-STLA/pbs/runtime.sh
: "${TARGET:?TARGET=speed or flow required}"
: "${BACKBONE_CHECKPOINT:?BACKBONE_CHECKPOINT required}"
: "${ANALYSIS_SHA256:?Submission SHA required}"
ACTUAL="$($PYTHON -c 'import hashlib,pathlib; p=pathlib.Path("TCRR-STLA/scripts/c1_frozen_analysis.py"); print(hashlib.sha256(p.read_bytes()).hexdigest())')"
[[ "$ACTUAL" == "$ANALYSIS_SHA256" ]] || {
 echo "Analysis source was modified while queued. Submit a frozen source copy; refusing to run." >&2
 exit 9
}
MODE="${MODE:-all}"
DATASET="${DATASET:-TraffiDent_Net_06}"
SEED="${SEED:-10}"
BACKBONE_MODE="${BACKBONE_MODE:-incomplete}"
export TRAFFIDENT_TARGET="$TARGET" BACKBONE_MODE
RUN_DIR="${RUN_DIR:-$ROOT/TCRR-STLA_exps/$TARGET/$BACKBONE_MODE/$DATASET/v7_1_0_c1/formal/seed$SEED}"
OUT="$ROOT/TCRR-STLA_logs/$TARGET/$BACKBONE_MODE/v7_1_0_c1/frozen"
mkdir -p "$OUT"
LOG="$OUT/C1_Frozen.${TARGET}.${PBS_JOBID:-local}.live.log"
ARGS=(--mode "$MODE" --target "$TARGET" --dataset "$DATASET" --seed "$SEED"
  --backbone-checkpoint "$BACKBONE_CHECKPOINT" --run-dir "$RUN_DIR"
  --device cpu --threads "${CPU_THREADS:-8}" --eval-batch-size "${EVAL_BATCH_SIZE:-8}"
  --bootstrap "${BOOTSTRAP:-400}" --block-steps "${BLOCK_STEPS:-288}"
  --severities "${SEVERITIES:-20:40:60:90}")
[[ "${CACHE_ONLY:-0}" == 1 ]] && ARGS+=(--cache-only)
[[ "${NO_ORIGINAL_STLA:-0}" == 1 ]] && ARGS+=(--no-original-stla)
set +e
"$PYTHON" -u TCRR-STLA/scripts/c1_frozen_analysis.py "${ARGS[@]}" 2>&1 | tee -a "$LOG"
CODES=("${PIPESTATUS[@]}")
set -e
for status in "${CODES[@]}"; do
 [[ "$status" == 0 ]] || { echo "C1_FROZEN_PBS_FAIL status=$status" | tee -a "$LOG"; exit "$status"; }
done
echo "C1_FROZEN_PBS_PASS target=$TARGET mode=$MODE" | tee -a "$LOG"
