#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
set -euo pipefail
ROOT="${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-}}"
[[ -d "$ROOT/TCRR-STLA" ]] || { echo "Cannot locate project root" >&2;exit 2; }
cd "$ROOT"
source TCRR-STLA/pbs/runtime.sh
: "${TARGET:?speed or flow required}"
: "${BACKBONE_CHECKPOINT:?absolute STLAformer best.pt required}"
DATASET="${DATASET:-TraffiDent_Net_06}"
SEED="${SEED:-10}"
BACKBONE_MODE="${BACKBONE_MODE:-incomplete}"
export SPEED_LLM_RAG_ROOT="$ROOT" BACKBONE_MODE TRAFFIDENT_TARGET="$TARGET"
export PYTHONPATH="$ROOT/TCRR-STLA:$ROOT/Backbone:$ROOT/Base_SupportBench:${PYTHONPATH:-}"
mkdir -p "TCRR-STLA_logs/$TARGET/$BACKBONE_MODE/v7_1_0_c1"
LOG="TCRR-STLA_logs/$TARGET/$BACKBONE_MODE/v7_1_0_c1/TCRR_v7.1.${TARGET}.${DATASET}.seed${SEED}.${PBS_JOBID:-local}.live.log"
GPUPID=""
if command -v nvidia-smi >/dev/null 2>&1; then
 nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,memory.used,memory.total --format=csv -l 30 > "${LOG%.live.log}.gpu.csv" 2>&1 & GPUPID=$!
fi
cleanup(){ if [[ -n "$GPUPID" ]]; then kill "$GPUPID" 2>/dev/null || true;wait "$GPUPID" 2>/dev/null || true; fi; }
trap cleanup EXIT
# Verify identity inside allocated job before creating the first GPU context.
"$PYTHON" -u TCRR-STLA/scripts/run_v7.py --target "$TARGET" --dataset "$DATASET" \
  --seed "$SEED" --backbone-checkpoint "$BACKBONE_CHECKPOINT" \
  --run-dir "${RUN_DIR:-$ROOT/TCRR-STLA_exps/$TARGET/$BACKBONE_MODE/$DATASET/v7_1_0_c1/formal/seed$SEED}" \
  --batch-size "${BATCH_SIZE:-16}" --workers "${TRAIN_WORKERS:-4}" --end-stage c1 --check-run-identity
ARGS=(--target "$TARGET" --dataset "$DATASET" --seed "$SEED" --backbone-checkpoint "$BACKBONE_CHECKPOINT" --end-stage c1)
[[ -z "${RUN_DIR:-}" ]] || ARGS+=(--run-dir "$RUN_DIR")
[[ -z "${BATCH_SIZE:-}" ]] || ARGS+=(--batch-size "$BATCH_SIZE")
[[ -z "${TRAIN_WORKERS:-}" ]] || ARGS+=(--workers "$TRAIN_WORKERS")
# Derive preflight dimensions from the actual checkpoint, not Net_06 constants.
META=$("$PYTHON" -c 'import sys,torch;c=torch.load(sys.argv[1],map_location="cpu",weights_only=False);m=c["model_config"];print(int(c["num_nodes"]),int(m.get("input_embedding_dim",32))+int(m.get("tow_embedding_dim",32)))' "$BACKBONE_CHECKPOINT")
read -r PREFLIGHT_NODES PREFLIGHT_MODEL_DIM <<< "$META"
C1_META=$("$PYTHON" -c 'import sys,yaml;c=yaml.safe_load(open(sys.argv[1]));print(int(c["model"]["top_k"]),int(c["model"]["hidden"]))' TCRR-STLA/configs/tcrr_stla_v7.yaml)
read -r PREFLIGHT_K PREFLIGHT_HIDDEN <<< "$C1_META"
# Allocated-GPU contract test BEFORE starting expensive teacher/replay work.
"$PYTHON" -u TCRR-STLA/scripts/preflight_c1_v71.py \
  --nodes "$PREFLIGHT_NODES" --model-dim "$PREFLIGHT_MODEL_DIM" \
  --top-k "$PREFLIGHT_K" --hidden "$PREFLIGHT_HIDDEN" \
  --device cuda --amp --batch-size 2
set +e
"$PYTHON" -u TCRR-STLA/scripts/run_v7.py "${ARGS[@]}" 2>&1 | "$PYTHON" -u TCRR-STLA/scripts/timestamp_filter.py | tee -a "$LOG"
CODES=("${PIPESTATUS[@]}")
set -e
for code in "${CODES[@]}"; do
 [[ "$code" == 0 ]] || { echo "V7_PBS_FAILED status=$code" | tee -a "$LOG"; exit "$code"; }
done
echo "V7_PBS_PASS" | tee -a "$LOG"
