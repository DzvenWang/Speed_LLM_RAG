#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
set -euo pipefail
_R="${PBS_O_WORKDIR:-$PWD}"
while [[ "$_R" != / && ! -f "$_R/TCRR-STLA/pbs/runtime.sh" ]]; do _R="$(dirname "$_R")"; done
[[ -f "$_R/TCRR-STLA/pbs/runtime.sh" ]] || { echo 'Missing runtime.sh' >&2; exit 2; }
source "$_R/TCRR-STLA/pbs/runtime.sh"
: "${CHECKPOINT:?Set checkpoint to best_c12.pt or selected best_* checkpoint}"
[[ -f "$CHECKPOINT" ]] || { echo "Missing checkpoint: $CHECKPOINT" >&2; exit 2; }
# One comprehensive correct/correct baseline; the other controls target only
# the full C1/C2/C3 mode, limiting unnecessary GPU work.
case "$CHECKPOINT" in
  *best_c12.pt) FULL_MODE=M11 ;;
  *) FULL_MODE=M111 ;;
esac
"$PYTHON" -u TCRR-STLA/scripts/evaluate_v5.py \
  --checkpoint "$CHECKPOINT" --split validation \
  --controller-mode auto --batch-size 8 --diagnostics
for params in 'shuffled correct' 'wrong_mask correct' 'correct coverage' 'correct shuffled'; do
  read -r cf sup <<< "$params"
  echo "V5_DIAGNOSTIC_START cf=$cf support=$sup"
  "$PYTHON" -u TCRR-STLA/scripts/evaluate_v5.py \
    --checkpoint "$CHECKPOINT" --split validation --modes "$FULL_MODE" \
    --controller-mode auto --cf-control "$cf" --support-control "$sup" \
    --batch-size 8 --diagnostics
  echo "V5_DIAGNOSTIC_PASS cf=$cf support=$sup"
done
