#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=96GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
set -euo pipefail
_RUNTIME=""
for _dir in "${SPEED_LLM_RAG_ROOT:-}" "${PBS_O_WORKDIR:-}" "${PWD:-}"; do
  [[ -n "$_dir" && -d "$_dir" ]] || continue
  _dir="$(cd "$_dir" && pwd -P)"
  while :; do
    if [[ -f "$_dir/TCRR-STLA/pbs/runtime.sh" ]]; then
      _RUNTIME="$_dir/TCRR-STLA/pbs/runtime.sh";break 2
    fi
    [[ "$_dir" == / ]] && break
    _dir="$(dirname "$_dir")"
  done
done
[[ -n "$_RUNTIME" ]] || { echo "TCRR runtime.sh unavailable" >&2;exit 2; }
source "$_RUNTIME"
TARGET=${TARGET:-speed}
SEED=${SEED:-10}
DATASET=${DATASET:-TraffiDent_Net_06}
BACKBONE_MODE=${BACKBONE_MODE:?Set BACKBONE_MODE=incomplete or complete}
BACKBONE_CHECKPOINT=${BACKBONE_CHECKPOINT:?Set original STLAformer best.pt}
case "$BACKBONE_MODE" in incomplete|complete) ;; *) exit 2;;esac
case "$TARGET" in speed|flow) ;; *) exit 2;;esac
[[ "$BACKBONE_CHECKPOINT" == /* ]] || BACKBONE_CHECKPOINT="$ROOT/$BACKBONE_CHECKPOINT"
[[ -f "$BACKBONE_CHECKPOINT" ]] || { echo "Missing $BACKBONE_CHECKPOINT" >&2;exit 2; }
case "$BACKBONE_CHECKPOINT" in "$ROOT/Backbone_exps/$TARGET/STLAformer/$DATASET/"*) ;; *) echo 'Checkpoint must be original STLAformer' >&2;exit 2;; esac
case "$BACKBONE_MODE:$BACKBONE_CHECKPOINT" in complete:*/formal_complete/*|incomplete:*/formal/*) ;; *) echo 'Backbone mode mismatch' >&2; exit 2;;esac
export TRAFFIDENT_TARGET="$TARGET" BACKBONE_MODE BACKBONE_CHECKPOINT PYTHONUNBUFFERED=1
mkdir -p "TCRR-STLA_logs/$TARGET/$BACKBONE_MODE/v5"
STAMP=${RUN_STAMP:-$(date +%Y%m%d_%H%M%S)}
LOG="TCRR-STLA_logs/$TARGET/$BACKBONE_MODE/v5/TCRR_v5.${TARGET}.${DATASET}.seed${SEED}.${PBS_JOBID:-local}.${STAMP}.live.log"
timestamp_stream(){ awk '{print strftime("[%Y-%m-%d %H:%M:%S]"),$0;fflush();}'; }
run_logged(){ "$@" 2>&1 | timestamp_stream | tee -a "$LOG"; return "${PIPESTATUS[0]}"; }
GPU_MON_PID=""
if command -v nvidia-smi >/dev/null; then
  nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,memory.used,memory.total --format=csv -l 30 > "${LOG%.live.log}.gpu.csv" 2>&1 & GPU_MON_PID=$!
fi
cleanup(){ [[ -z "$GPU_MON_PID" ]] || { kill "$GPU_MON_PID" 2>/dev/null || true; wait "$GPU_MON_PID" 2>/dev/null || true; }; }
trap cleanup EXIT
printf 'START v5 TARGET=%s DATASET=%s BACKBONE_MODE=%s\n' "$TARGET" "$DATASET" "$BACKBONE_MODE" | timestamp_stream | tee -a "$LOG"
run_logged "$PYTHON" -u TCRR-STLA/scripts/preflight.py --config TCRR-STLA/configs/tcrr_stla_v5.yaml --target "$TARGET" --dataset "$DATASET" --backbone-checkpoint "$BACKBONE_CHECKPOINT"
ARGS=(--target "$TARGET" --dataset "$DATASET" --seed "$SEED" --backbone-checkpoint "$BACKBONE_CHECKPOINT" --run-stamp "$STAMP")
[[ -z "${BATCH_SIZE:-}" ]] || ARGS+=(--batch-size "$BATCH_SIZE")
# Run a true-data GPU smoke in the same environment and cache namespace,
# but isolate it from formal run artifacts and stop after the tiny smoke plan.
if [[ "${SMOKE:-0}" == "1" ]]; then
  ARGS+=(--smoke --skip-evaluate --skip-diagnostics)
  if [[ "${SMOKE_PROFILE_FULL_BATCH:-0}" == "1" ]]; then
    [[ -n "${BATCH_SIZE:-}" ]] || { echo "Full-batch smoke needs BATCH_SIZE" >&2; exit 2; }
    ARGS+=(--smoke-full-batch)
  fi
fi
[[ -z "${RESUME_CHECKPOINT:-}" ]] || ARGS+=(--resume "$RESUME_CHECKPOINT")
[[ -z "${SKIP_EVALUATE:-}" ]] || ARGS+=(--skip-evaluate)
[[ -z "${SKIP_DIAGNOSTICS:-}" ]] || ARGS+=(--skip-diagnostics)
[[ -z "${DIAGNOSTIC_MAX_BATCHES:-}" ]] || ARGS+=(--diagnostic-max-batches "$DIAGNOSTIC_MAX_BATCHES")
[[ -z "${DIAGNOSTIC_PRIMARY_MAX_BATCHES:-}" ]] || ARGS+=(--diagnostic-primary-max-batches "$DIAGNOSTIC_PRIMARY_MAX_BATCHES")
run_logged "$PYTHON" -u TCRR-STLA/scripts/train_v5.py "${ARGS[@]}"
printf 'V5_PBS_FINISH\n' | timestamp_stream | tee -a "$LOG"
