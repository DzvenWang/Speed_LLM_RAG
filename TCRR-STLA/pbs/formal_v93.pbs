#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=96GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
set -euo pipefail
_RUNTIME=""
for _p in "${SPEED_LLM_RAG_ROOT:-}" "${PBS_O_WORKDIR:-}" "${PWD:-}"; do
  [[ -n "$_p" && -d "$_p" ]] || continue
  _p="$(cd "$_p" && pwd -P)"
  while :; do
    if [[ -f "$_p/TCRR-STLA/pbs/runtime.sh" ]]; then _RUNTIME="$_p/TCRR-STLA/pbs/runtime.sh";break 2;fi
    [[ "$_p" == / ]] && break
    _p="$(dirname "$_p")"
  done
done
[[ -n "$_RUNTIME" && -f "$_RUNTIME" ]] || { echo 'V93 ERROR: runtime.sh missing' >&2;exit 2; }
source "$_RUNTIME"
TARGET="${TARGET:?TARGET=speed/flow is required}"
DATASET="${DATASET:-TraffiDent_Net_06}"
SEED="${SEED:-10}"
BACKBONE_CHECKPOINT="${BACKBONE_CHECKPOINT:?Specify original STLAformer best.pt}"
V93_STAGE="${V93_STAGE:-all}"
case "$TARGET" in speed|flow) ;; *)echo 'Invalid TARGET' >&2;exit 2;;esac
case "$V93_STAGE" in all|prepare|train|diagnose) ;; *)echo 'Invalid V93_STAGE' >&2;exit 2;;esac
case "$BACKBONE_CHECKPOINT" in /*) ;; *)BACKBONE_CHECKPOINT="$ROOT/$BACKBONE_CHECKPOINT";;esac
[[ -f "$BACKBONE_CHECKPOINT" ]] || { echo "Missing backbone $BACKBONE_CHECKPOINT" >&2;exit 2; }
mkdir -p "TCRR-STLA_logs/$TARGET/v9_3"
STAMP="${RUN_STAMP:-$(date +%Y%m%d_%H%M%S)}"
LOG="TCRR-STLA_logs/$TARGET/v9_3/${TARGET}.${DATASET}.${V93_STAGE}.${PBS_JOBID:-local}.${STAMP}.live.log"
export PYTHONUNBUFFERED=1 TRAFFIDENT_TARGET="$TARGET"
cleanup(){ [[ -z "${GPU_MON_PID:-}" ]] || { kill "$GPU_MON_PID" 2>/dev/null || true;wait "$GPU_MON_PID" 2>/dev/null || true; }; }
trap cleanup EXIT
if command -v nvidia-smi >/dev/null 2>&1;then
 nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,memory.used,memory.total --format=csv -l 30 > "${LOG%.live.log}.gpu.csv" 2>&1 & GPU_MON_PID=$!
fi
logged(){ "$@" 2>&1 | awk '{print strftime("[%Y-%m-%d %H:%M:%S]"),$0;fflush();}' | tee -a "$LOG";return "${PIPESTATUS[0]}"; }
ARGS=(--target "$TARGET" --dataset "$DATASET" --seed "$SEED" --backbone-checkpoint "$BACKBONE_CHECKPOINT" --stage "$V93_STAGE")
[[ -z "${V93_ADAPTER_CHECKPOINT:-}" ]] || ARGS+=(--adapter-checkpoint "$V93_ADAPTER_CHECKPOINT")
[[ -z "${V93_TEACHER_ROOT:-}" ]] || ARGS+=(--teacher-root "$V93_TEACHER_ROOT")
[[ -z "${V93_RUN_DIR:-}" ]] || ARGS+=(--output "$V93_RUN_DIR")
[[ -z "${V93_RESUME:-}" ]] || ARGS+=(--resume "$V93_RESUME")
[[ -z "${V93_MODE:-}" ]] || ARGS+=(--mode "$V93_MODE")
[[ -z "${V93_GRAPH_MODE:-}" ]] || ARGS+=(--graph-mode "$V93_GRAPH_MODE")
[[ "${SMOKE:-0}" != 1 ]] || ARGS+=(--smoke)
[[ "${V93_AUTO_DIAGNOSE:-1}" != 0 ]] || ARGS+=(--no-auto-diagnose)
[[ -z "${BATCH_SIZE:-}" ]] || ARGS+=(--batch-size "$BATCH_SIZE")
[[ -z "${PREP_BATCH:-}" ]] || ARGS+=(--prep-batch "$PREP_BATCH")
[[ -z "${DATA_WORKERS:-}" ]] || ARGS+=(--workers "$DATA_WORKERS")
PF=(--target "$TARGET" --dataset "$DATASET" --backbone-checkpoint "$BACKBONE_CHECKPOINT")
[[ "${SMOKE:-0}" == 1 ]] || PF+=(--require-gpu)
logged "$PYTHON" -u TCRR-STLA/scripts/preflight_v93.py "${PF[@]}"
logged "$PYTHON" -u TCRR-STLA/scripts/train_v93.py "${ARGS[@]}"
echo "V93_PBS_FINISH target=$TARGET stage=$V93_STAGE" | tee -a "$LOG"
