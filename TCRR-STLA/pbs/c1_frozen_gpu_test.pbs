#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
# Optional faster FIRST-PASS TEST cache build + frozen C1 evaluation; no training.
set -euo pipefail
ROOT="${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-}}"
cd "$ROOT"
source TCRR-STLA/pbs/runtime.sh
: "${TARGET:?}"; : "${BACKBONE_CHECKPOINT:?}"; : "${ANALYSIS_SHA256:?}"
ACTUAL="$($PYTHON -c 'import hashlib,pathlib; p=pathlib.Path("TCRR-STLA/scripts/c1_frozen_analysis.py"); print(hashlib.sha256(p.read_bytes()).hexdigest())')"
[[ "$ACTUAL" == "$ANALYSIS_SHA256" ]] || { echo 'Analysis source changed while queued' >&2; exit 9; }
DATASET="${DATASET:-TraffiDent_Net_06}"
SEED="${SEED:-10}"
BACKBONE_MODE="${BACKBONE_MODE:-incomplete}"
export TRAFFIDENT_TARGET="$TARGET" BACKBONE_MODE
RUN_DIR="${RUN_DIR:-$ROOT/TCRR-STLA_exps/$TARGET/$BACKBONE_MODE/$DATASET/v7_1_0_c1/formal/seed$SEED}"
OUT="$ROOT/TCRR-STLA_logs/$TARGET/$BACKBONE_MODE/v7_1_0_c1/frozen"
mkdir -p "$OUT"
"$PYTHON" -u TCRR-STLA/scripts/c1_frozen_analysis.py \
  --mode test --target "$TARGET" --dataset "$DATASET" --seed "$SEED" \
  --backbone-checkpoint "$BACKBONE_CHECKPOINT" --run-dir "$RUN_DIR" \
  --device cuda --threads 8 --eval-batch-size "${EVAL_BATCH_SIZE:-8}" \
  --severities "${SEVERITIES:-20:40:60:90}" \
  2>&1 | tee -a "$OUT/C1_Frozen_GPU_Test.${TARGET}.${PBS_JOBID:-local}.live.log"
echo "C1_FROZEN_GPU_TEST_PASS target=$TARGET"
