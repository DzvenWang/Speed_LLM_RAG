#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=96GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
set -euo pipefail
source "${PBS_O_WORKDIR:?}/TCRR-STLA/pbs/runtime.sh"
: "${RUN_DIR:?Set RUN_DIR to the completed v5 formal run}"
[[ -f "$RUN_DIR/best_c12.pt" ]] || { echo 'Missing best C12 checkpoint' >&2;exit 2; }
mkdir -p "$RUN_DIR/postprocess_logs"
"$PYTHON" -u TCRR-STLA/scripts/evaluate_v5.py \
  --checkpoint "$RUN_DIR/best_c12.pt" --controller-mode fixed --diagnostics \
  2>&1 | tee "$RUN_DIR/postprocess_logs/c12_test.live.log"
for STAGE in controller joint; do
  [[ -f "$RUN_DIR/best_${STAGE}.pt" ]] || continue
  "$PYTHON" -u TCRR-STLA/scripts/evaluate_v5.py \
    --checkpoint "$RUN_DIR/best_${STAGE}.pt" \
    --modes M000 M001 M010 M011 M100 M101 M110 M111 \
    --controller-mode auto --diagnostics \
    2>&1 | tee "$RUN_DIR/postprocess_logs/${STAGE}_test.live.log"
done
echo V53_TEST_PASS
