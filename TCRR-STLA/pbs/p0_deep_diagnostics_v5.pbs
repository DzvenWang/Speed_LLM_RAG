#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=12:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
# P0 is an immutable, read-only controller-checkpoint diagnostic; no training.
set -euo pipefail
source "${PBS_O_WORKDIR:?}/TCRR-STLA/pbs/runtime.sh"
: "${RUN_DIR:?Set RUN_DIR to a finalized v5.3 formal experiment}"
for name in best_controller.pt best_c12.pt s0_shared_adapter.pt summary.json validation_partitions.json; do
  [[ -s "$RUN_DIR/$name" ]] || { echo "P0_PREFLIGHT_FAILED missing=$RUN_DIR/$name" >&2; exit 2; }
done

P0_BATCH_SIZE="${P0_BATCH_SIZE:-8}"
P0_MAX_BATCHES="${P0_MAX_BATCHES:-0}"
P0_VALIDATION_SECTION="${P0_VALIDATION_SECTION:-selection}"
P0_RUN_TEST="${P0_RUN_TEST:-1}"
[[ "$P0_BATCH_SIZE" =~ ^[1-9][0-9]*$ ]] || { echo 'Invalid P0_BATCH_SIZE' >&2; exit 2; }
[[ "$P0_MAX_BATCHES" =~ ^[0-9]+$ ]] || { echo 'Invalid P0_MAX_BATCHES' >&2; exit 2; }
[[ "$P0_RUN_TEST" == 0 || "$P0_RUN_TEST" == 1 ]] || { echo 'Invalid P0_RUN_TEST' >&2; exit 2; }
[[ "$P0_VALIDATION_SECTION" == selection || "$P0_VALIDATION_SECTION" == calibration || "$P0_VALIDATION_SECTION" == check ]] || { echo 'Invalid validation section' >&2; exit 2; }

mkdir -p "$RUN_DIR/p0_diagnostics"
args=( --checkpoint "$RUN_DIR/best_controller.pt"
       --modes M000 M100 M110 M111
       --controller-mode auto --p0-deep
       --batch-size "$P0_BATCH_SIZE" --max-batches "$P0_MAX_BATCHES" )

echo "V53_P0_START stage=validation section=$P0_VALIDATION_SECTION batch=$P0_BATCH_SIZE"
"$PYTHON" -u TCRR-STLA/scripts/evaluate_v5.py \
  "${args[@]}" --split validation --validation-section "$P0_VALIDATION_SECTION" \
  --output-tag "p0_deep_${P0_VALIDATION_SECTION}" \
  2>&1 | tee "$RUN_DIR/p0_diagnostics/validation_${P0_VALIDATION_SECTION}.live.log"
echo V53_P0_VALIDATION_PASS

if [[ "$P0_RUN_TEST" == 1 ]]; then
  echo 'V53_P0_START stage=test diagnostic_only=true'
  "$PYTHON" -u TCRR-STLA/scripts/evaluate_v5.py \
    "${args[@]}" --split test --output-tag p0_deep_test_readonly \
    2>&1 | tee "$RUN_DIR/p0_diagnostics/test.live.log"
  echo V53_P0_TEST_PASS
fi

echo V53_P0_PASS
