#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=96GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
set -euo pipefail
_RUNTIME=""
for _p in "${SPEED_LLM_RAG_ROOT:-}" "${PBS_O_WORKDIR:-}" "${PWD:-}"; do
  [[ -n "$_p" && -d "$_p" ]] || continue
  _p="$(cd "$_p" && pwd -P)"
  while :; do
    if [[ -f "$_p/TCRR-STLA/pbs/runtime.sh" ]]; then _RUNTIME="$_p/TCRR-STLA/pbs/runtime.sh";break 2;fi
    [[ "$_p" == / ]] && break
    _p="$(dirname "$_p")"
  done
done
[[ -f "$_RUNTIME" ]] || { echo 'v9 ERROR: Cannot find PBS runtime.sh' >&2;exit 2; }
source "$_RUNTIME"
TARGET="${TARGET:?TARGET=speed/flow required}"
DATASET="${DATASET:-TraffiDent_Net_06}"
SEED="${SEED:-10}"
BACKBONE_CHECKPOINT="${BACKBONE_CHECKPOINT:?Set original STLAformer best.pt}"
V9_STAGE="${V9_STAGE:-all}"
case "$TARGET" in speed|flow) ;; *)echo 'Invalid TARGET' >&2;exit 2;;esac
case "$V9_STAGE" in prepare|train|all|evaluate) ;; *)echo 'Invalid V9_STAGE' >&2;exit 2;;esac
case "$BACKBONE_CHECKPOINT" in /*) ;; *)BACKBONE_CHECKPOINT="$ROOT/$BACKBONE_CHECKPOINT";;esac
[[ -f "$BACKBONE_CHECKPOINT" ]] || { echo "Missing backbone: $BACKBONE_CHECKPOINT" >&2;exit 2; }
mkdir -p "TCRR-STLA_logs/$TARGET/v9_1"
STAMP="${RUN_STAMP:-$(date +%Y%m%d_%H%M%S)}"
LOG="TCRR-STLA_logs/$TARGET/v9_1/${TARGET}.${DATASET}.${V9_STAGE}.${PBS_JOBID:-local}.${STAMP}.live.log"
export PYTHONUNBUFFERED=1 TRAFFIDENT_TARGET="$TARGET"
cleanup(){ if [[ -n "${GPU_MON_PID:-}" ]];then kill "$GPU_MON_PID" 2>/dev/null || true;wait "$GPU_MON_PID" 2>/dev/null || true;fi; }
trap cleanup EXIT
if command -v nvidia-smi >/dev/null 2>&1; then
  nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,memory.used,memory.total \
   --format=csv -l 30 > "${LOG%.live.log}.gpu.csv" 2>&1 & GPU_MON_PID=$!
fi
logged(){ "$@" 2>&1 | awk '{print strftime("[%Y-%m-%d %H:%M:%S]"),$0;fflush();}' | tee -a "$LOG";return "${PIPESTATUS[0]}"; }
COMMON=(--target "$TARGET" --dataset "$DATASET" --seed "$SEED" \
        --backbone-checkpoint "$BACKBONE_CHECKPOINT")
[[ -z "${V9_PHYSICAL_GRAPH:-}" ]] || COMMON+=(--physical-graph "$V9_PHYSICAL_GRAPH" --node-ids "${V9_NODE_IDS:?V9_NODE_IDS required}")
[[ -z "${V9_REGIONS:-}" ]] || COMMON+=(--regions "$V9_REGIONS")
[[ -z "${V9_ADAPTER_CHECKPOINT:-}" ]] || COMMON+=(--adapter-checkpoint "$V9_ADAPTER_CHECKPOINT")
[[ -z "${V9_RUN_DIR:-}" ]] || COMMON+=(--output "$V9_RUN_DIR")
[[ -z "${V9_RESUME:-}" ]] || COMMON+=(--resume "$V9_RESUME")
[[ "${SMOKE:-0}" != 1 ]] || COMMON+=(--smoke)
if [[ "$V9_STAGE" != evaluate ]];then
  PF=(--target "$TARGET" --dataset "$DATASET" --backbone-checkpoint "$BACKBONE_CHECKPOINT" --require-gpu)
  [[ -z "${V9_PHYSICAL_GRAPH:-}" ]] || PF+=(--physical-graph "$V9_PHYSICAL_GRAPH" --node-ids "${V9_NODE_IDS:?}")
  logged "$PYTHON" -u TCRR-STLA/scripts/preflight_v9.py "${PF[@]}"
  logged "$PYTHON" -u TCRR-STLA/scripts/train_v9.py "${COMMON[@]}" \
    --stage "$V9_STAGE" --batch-size "${BATCH_SIZE:-32}" \
    --prep-batch "${PREP_BATCH:-4}" --workers "${DATA_WORKERS:-4}" \
    --normal-epochs "${NORMAL_EPOCHS:-8}" --transfer-epochs "${TRANSFER_EPOCHS:-15}" \
    --utility-epochs "${UTILITY_EPOCHS:-15}" --cross-epochs "${CROSS_EPOCHS:-4}"
else
  [[ -n "${V9_CHECKPOINT:-}" && -n "${V9_RUN_IDENTITY:-}" ]] || { echo 'Evaluation requires V9_CHECKPOINT and V9_RUN_IDENTITY' >&2;exit 2; }
  for severity in 20 40 60 90; do
    ARGS=(--checkpoint "$V9_CHECKPOINT" --run-identity "$V9_RUN_IDENTITY" \
          --severity "$severity" --batch-size "${EVAL_BATCH_SIZE:-16}")
    [[ "${SMOKE:-0}" != 1 ]] || ARGS+=(--smoke)
    logged "$PYTHON" -u TCRR-STLA/scripts/evaluate_v9.py "${ARGS[@]}"
  done
fi
printf 'V9_PBS_FINISH stage=%s target=%s\n' "$V9_STAGE" "$TARGET" | tee -a "$LOG"
