#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=12:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -N PatchRetrDiag
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_StateRetrieval_Diagnostic_logs/out/
set -eo pipefail

ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_StateRetrieval_Diagnostic
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_StateRetrieval_Diagnostic_logs
STAGE=${STAGE:-development}
QUERIES=${QUERIES:-256}
MAX_WINDOWS=${MAX_WINDOWS:-12000}
TOP_K=${TOP_K:-50}
SCOPES=${SCOPES:-1,3,6,12}
FORECAST_ORACLE_TRANSPORT=${FORECAST_ORACLE_TRANSPORT:-affine_alignment}
SAME_EPISODE_POOL_CAP=${SAME_EPISODE_POOL_CAP:-512}
EVAL_BATCH_SIZE=${EVAL_BATCH_SIZE:-64}

mkdir -p "$LOGROOT" "$LOGROOT/out" /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_StateRetrieval_Diagnostic_exps
STAMP=$(date +%Y%m%d_%H%M%S)
JOB_ID=${PBS_JOBID:-manual}; JOB_NUM=${JOB_ID%%.*}
LIVE_LOG="$LOGROOT/PatchRetrDiag.${STAGE}.${STAMP}.${JOB_NUM}.gadi-pbs.live.log"
export PYTHONUNBUFFERED=1 PYTHONIOENCODING=UTF-8
exec > >(while IFS= read -r line || [[ -n "$line" ]]; do printf '[%(%Y-%m-%d %H:%M:%S)T] %s\n' -1 "$line"; done | tee -a "$LIVE_LOG") 2>&1

on_exit(){ status=$?; trap - EXIT; echo "SCRIPT_EXIT_STATUS=$status"; echo "LIVE_LOG=$LIVE_LOG"; exit "$status"; }; trap on_exit EXIT
set +u; source ~/.bashrc; conda activate TFP; set -u
cd "$ROOT"
python "$ROOT/../Backbone/scripts/verify_official_sources.py"

python -m pytest -q tests/test_patch_level.py
python scripts/run_local_pipeline.py \
  --stage "$STAGE" \
  --queries "$QUERIES" \
  --max-windows "$MAX_WINDOWS" \
  --top-k "$TOP_K" \
  --scopes "$SCOPES" \
  --oracle-k-values 1,5,10,20,50 \
  --oracle-transport affine_alignment \
  --transport-methods raw_copy,delta_anchor,affine_alignment \
  --weighted-k 5,10 \
  --transport-oracle-k 20 \
  --forecast-oracle-transport "$FORECAST_ORACLE_TRANSPORT" \
  --forecast-oracle-k-values 1,5,10,20,50 \
  --same-episode-pool-cap "$SAME_EPISODE_POOL_CAP" \
  --eval-batch-size "$EVAL_BATCH_SIZE"
