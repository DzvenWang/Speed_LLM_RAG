#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
set -euo pipefail
# Exactly the original formal PBS runner, but with independently trained
# NO RETRIEVAL model/forecast adapter. Not an evidence-disabled full checkpoint.
export ABLATION=no_retrieval
ROOT=${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}
cd "$ROOT"
exec bash Mask_RAST-STLA/pbs/formal.pbs
