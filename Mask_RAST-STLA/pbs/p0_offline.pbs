#!/bin/bash
#PBS -P mh20
#PBS -q normal
#PBS -l ncpus=12
#PBS -l mem=32GB
#PBS -l walltime=04:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
set -euo pipefail
ROOT=${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}
ENVROOT=${TFP_ENV_ROOT:-/scratch/mh20/zw1165/envs/TFP}
: "${FULL_CHECKPOINT:?Set FULL_CHECKPOINT to FULL best.pt}"
cd "$ROOT"
export SPEED_LLM_RAG_ROOT="$ROOT" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$ROOT/Mask_RAST-STLA:$ROOT/Base_SupportBench:${PYTHONPATH:-}"
EXTRA=()
if [[ -n "${NO_RETRIEVAL_CHECKPOINT:-}" ]]; then
  EXTRA+=(--no-retrieval-checkpoint "$NO_RETRIEVAL_CHECKPOINT")
fi
exec "$ENVROOT/bin/python" -u Mask_RAST-STLA/scripts/p0_diagnose.py \
  --checkpoint "$FULL_CHECKPOINT" --severities 20 40 60 90 "${EXTRA[@]}"
