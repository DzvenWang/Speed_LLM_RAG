#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
set -euo pipefail

TARGET=${TARGET:-${TRAFFIDENT_TARGET:-speed}}
SEED=${SEED:-10}
case "$TARGET" in speed|flow) ;; *) echo "ERROR TARGET=$TARGET (expected speed|flow)"; exit 2;; esac
[[ "$SEED" == "10" ]] || { echo "ERROR Formal seed fixed to 10"; exit 2; }

ROOT=${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}
ENVROOT=${TFP_ENV_ROOT:-/scratch/mh20/zw1165/envs/TFP}
PYTHON="$ENVROOT/bin/python"
[[ -x "$PYTHON" ]] || { echo "ERROR Python not executable: $PYTHON"; exit 3; }

export SPEED_LLM_RAG_ROOT="$ROOT"
export TRAFFIDENT_TARGET="$TARGET"
export PYTHONUNBUFFERED=1
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$ROOT/Mask_RAST-STLA:$ROOT/Base_SupportBench:${PYTHONPATH:-}"
export PATH="$ENVROOT/bin:$PATH"

cd "$ROOT"
mkdir -p "Mask_RAST-STLA_logs/$TARGET"
STAMP=$(date +%Y%m%d_%H%M%S)
JOBID=${PBS_JOBID:-local}
LOG="Mask_RAST-STLA_logs/$TARGET/Mask_RAST-STLA.${TARGET}.formal.seed${SEED}.${JOBID}.${STAMP}.live.log"

echo "START model=Mask_RAST-STLA target=$TARGET seed=$SEED job=$JOBID host=$(hostname)" | tee -a "$LOG"
echo "ROOT=$ROOT PYTHON=$PYTHON" | tee -a "$LOG"
"$PYTHON" -V 2>&1 | tee -a "$LOG"
nvidia-smi 2>&1 | tee -a "$LOG" || true

# Gadi gpuvolta allocation requires 12 CPUs per V100; keep ncpus=12.
GPU_LOG="${LOG%.live.log}.gpu.csv"
GPU_MON_PID=""
if command -v nvidia-smi >/dev/null 2>&1; then
  nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,utilization.memory,memory.used,memory.total,power.draw --format=csv -l 30 > "$GPU_LOG" 2>&1 &
  GPU_MON_PID=$!
fi
cleanup_gpu_monitor() {
  if [[ -n "${GPU_MON_PID:-}" ]]; then kill "$GPU_MON_PID" 2>/dev/null || true; wait "$GPU_MON_PID" 2>/dev/null || true; fi
}
trap cleanup_gpu_monitor EXIT

"$PYTHON" -u Mask_RAST-STLA/scripts/preflight.py --target "$TARGET" 2>&1 | tee -a "$LOG"
echo "PERF_CONFIG project=Mask_RAST-STLA ncpus=12" | tee -a "$LOG"
"$PYTHON" -u Mask_RAST-STLA/scripts/train.py --target "$TARGET" --seed "$SEED" --run-stamp "$STAMP" 2>&1 | tee -a "$LOG"

echo "FINISH model=Mask_RAST-STLA target=$TARGET seed=$SEED" | tee -a "$LOG"
