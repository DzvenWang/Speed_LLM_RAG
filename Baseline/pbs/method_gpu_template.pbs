LOGROOT=${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Baseline_logs
PY=${PYTHON:-python}
METHOD=${METHOD:-MethodName}
STAGE=${STAGE:-formal}
SEED=${SEED:-10}
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "$METHOD" "$STAGE" "seed${SEED}"
baseline_install_exit_trap
cd "$ROOT"
echo "Template only: replace this line with the audited method runner."
exit 3
