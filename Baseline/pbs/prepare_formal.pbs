#!/bin/bash
#PBS -P mh20
#PBS -q normal
#PBS -l ncpus=4,mem=32GB,walltime=03:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs/out/
#PBS -N BaselineFormalPrep
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "BaselineFormalPrep" "formal"
baseline_install_exit_trap
cd "$ROOT"
echo "START Baseline formal preparation v1.0.0"
"$PY" scripts/preflight.py --stage formal
"$PY" scripts/prepare_data.py --stage formal
"$PY" scripts/validate_cache.py --stage formal
"$PY" scripts/retrieval_leakage_audit.py --stage formal

if [ -f /scratch/mh20/zw1165/Speed_LLM_RAG/Backbone_exps/FROZEN_BACKBONE.json ]; then
  if "$PY" scripts/validate_frozen_patchstg.py; then
    echo "PASS: Backbone frozen PatchSTG is ready for dependent baselines."
  else
    echo "INFO: a frozen-backbone file exists but is not yet compatible with Baseline v1.0.0; formal cache preparation itself is still valid."
  fi
else
  echo "INFO: Backbone FROZEN_BACKBONE.json not ready yet; non-PatchSTG baselines may still run after formal cache validation."
fi
