#!/bin/bash
#PBS -P mh20
#PBS -q normal
#PBS -l ncpus=2
#PBS -l mem=8GB
#PBS -l walltime=01:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs/out/
#PBS -N BaselineAudit
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "BaselineCompatibility" "audit"
baseline_install_exit_trap
cd "$ROOT"
echo "START Baseline compatibility audit v0.6.0"
"$PY" scripts/verify_official_sources.py
"$PY" scripts/audit_official_compatibility.py
"$PY" scripts/runtime_contract_audit.py
if [ -f /scratch/mh20/zw1165/Speed_LLM_RAG/ExperimentCache/TraffiDent_Net_06/development/cache_manifest.json ]; then
  "$PY" scripts/validate_cache.py --stage development
  "$PY" scripts/retrieval_leakage_audit.py --stage development
fi
"$PY" scripts/baseline_status.py
