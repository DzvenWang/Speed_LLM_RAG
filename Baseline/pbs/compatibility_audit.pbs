#!/bin/bash
#PBS -P mh20
#PBS -q normal
#PBS -l ncpus=2
#PBS -l mem=8GB
#PBS -l walltime=01:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N BaselineAudit
export TRAFFIDENT_TARGET="${TARGET:-speed}"
set -euo pipefail
ROOT=${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Baseline
LOGROOT=${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Baseline_logs
PY=${PYTHON:-python}
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "BaselineCompatibility" "audit"
baseline_install_exit_trap
cd "$ROOT"
echo "START Baseline compatibility audit v1.1.0"
"$PY" scripts/verify_official_sources.py
"$PY" scripts/audit_official_compatibility.py
"$PY" scripts/runtime_contract_audit.py
if [ -f ${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/ExperimentCache/TraffiDent_Net_06/development/cache_manifest.json ]; then
  "$PY" scripts/validate_cache.py --stage development
  "$PY" scripts/retrieval_leakage_audit.py --stage development
fi
"$PY" scripts/baseline_status.py
