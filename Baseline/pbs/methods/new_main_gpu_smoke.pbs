#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs/out/
#PBS -N BaseNewSmoke
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
METHOD=${METHOD:?Submit with -v METHOD=GinAR,RAFT,SARAF,ImputeFormer,or RAST}
case "$METHOD" in GinAR|RAFT|SARAF|ImputeFormer|RAST) ;; *) echo "Invalid METHOD=$METHOD"; exit 2;; esac
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "$METHOD" "gpu_smoke"
baseline_install_exit_trap
export PYTHONPATH="$ROOT:/scratch/mh20/zw1165/Speed_LLM_RAG/Protocol:/scratch/mh20/zw1165/Speed_LLM_RAG/TraffiDent_SupportBench:${PYTHONPATH:-}"
unset TRANSFORMERS_CACHE || true
cd "$ROOT"
echo "START $METHOD GPU SMOKE v0.6.0"
nvidia-smi
if [ "$METHOD" = "RAST" ]; then "$PY" scripts/check_rast_runtime.py; "$PY" tests/smoke_rast_import_contract.py; fi
"$PY" scripts/verify_official_sources.py
"$PY" scripts/validate_cache.py --stage development
if [ "$METHOD" = "GinAR" ]; then
  "$PY" baseline/runners/ginar_runner.py --stage development --seed 10 --smoke
elif [ "$METHOD" = "RAFT" ]; then
  "$PY" scripts/retrieval_leakage_audit.py --stage development
  "$PY" baseline/runners/raft_runner.py --stage development --seed 10 --smoke
elif [ "$METHOD" = "SARAF" ]; then
  "$PY" scripts/retrieval_leakage_audit.py --stage development
  "$PY" baseline/runners/saraf_runner.py --stage development --seed 10 --smoke
elif [ "$METHOD" = "RAST" ]; then
  "$PY" baseline/runners/rast_runner.py --stage development --seed 10 --variant native --smoke
else
  echo "ImputeFormer smoke requires formal PatchSTG registry/cache; use formal_main.pbs after formal prep."
  exit 3
fi
echo "NEW MAIN GPU SMOKE PASS method=$METHOD"
