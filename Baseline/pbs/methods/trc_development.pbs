#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=48GB,walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs/out/
#PBS -N BaseSecondaryTRC
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
: "${METHOD:?METHOD required: MoGERNN or SPRINT}"
SEED=${SEED:-10}
case "$METHOD" in MoGERNN|SPRINT) ;; *) echo "Invalid secondary METHOD=$METHOD"; exit 2;; esac
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "SecondaryTRCDevelopment" "$METHOD" "seed${SEED}" "development"
baseline_install_exit_trap
export PYTHONPATH="$ROOT:/scratch/mh20/zw1165/Speed_LLM_RAG/ExperimentCommon:/scratch/mh20/zw1165/Speed_LLM_RAG/Protocol:/scratch/mh20/zw1165/Speed_LLM_RAG/TraffiDent_SupportBench:${PYTHONPATH:-}"
cd "$ROOT"
echo "START Secondary TRC Development v1.1.0 method=$METHOD seed=$SEED"
nvidia-smi
if [[ "$METHOD" == "MoGERNN" ]]; then "$PY" scripts/check_mogernn_inference_contract.py --stage development --seed "$SEED"; fi
if [[ "$METHOD" == "SPRINT" ]]; then "$PY" scripts/check_sprint_runtime.py --stage development; "$PY" scripts/validate_frozen_patchstg.py; fi
"$PY" scripts/preflight.py --stage development --method "$METHOD"
case "$METHOD" in
  MoGERNN) "$PY" -u baseline/runners/mogernn_runner.py --stage development --seed "$SEED";;
  SPRINT) "$PY" -u baseline/runners/sprint_runner.py --stage development --seed "$SEED";;
esac
echo "SECONDARY TRC DEVELOPMENT PASS method=$METHOD seed=$SEED"
