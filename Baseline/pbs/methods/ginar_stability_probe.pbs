#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=32GB,walltime=04:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N GinARStability
export TRAFFIDENT_TARGET="${TARGET:-speed}"
set -euo pipefail
ROOT=${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Baseline
PY=${PYTHON:-python}
SEED=${SEED:-10}
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "GinARStability" "GinAR" "seed${SEED}" "formal"
baseline_install_exit_trap
export PYTHONPATH="$ROOT:${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Base_SupportBench:${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Base_SupportBench:${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Base_SupportBench:${PYTHONPATH:-}"
cd "$ROOT"
echo "START GinAR formal-population stability probe v1.1.0 seed=$SEED"
nvidia-smi
"$PY" scripts/preflight.py --stage formal --method GinAR
"$PY" -u baseline/runners/ginar_runner.py --stage formal --seed "$SEED" --stability-probe
echo "GINAR STABILITY PROBE PASS seed=$SEED"
