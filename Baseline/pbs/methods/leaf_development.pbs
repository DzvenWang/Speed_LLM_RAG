#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs/out/
#PBS -N LEAFDev
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline; LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs; PY=/scratch/mh20/zw1165/envs/TFP/bin/python
source "$ROOT/scripts/pbs_live_log.sh"; baseline_live_log_start "LEAF" "development" "seed10" "branches"; baseline_install_exit_trap
export PYTHONPATH="$ROOT:/scratch/mh20/zw1165/Speed_LLM_RAG/ExperimentCommon:/scratch/mh20/zw1165/Speed_LLM_RAG/TraffiDent_SupportBench:${PYTHONPATH:-}"
cd "$ROOT"; echo "START LEAF Development branches in shared TFP runtime"; nvidia-smi
"$PY" scripts/check_leaf_tfp_runtime.py
"$PY" tests/smoke_leaf_graph_compat.py
"$PY" scripts/verify_official_sources.py
"$PY" scripts/validate_cache.py --stage development
"$PY" -u baseline/runners/leaf_runner.py --stage development --seed 10 --phase branches
echo "LEAF BRANCH DEVELOPMENT PASS"
