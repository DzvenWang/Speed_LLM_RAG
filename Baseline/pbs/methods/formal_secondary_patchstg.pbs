#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=48GB,walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N BaseSecondaryPatch
export TRAFFIDENT_TARGET="${TARGET:-speed}"
set -euo pipefail
ROOT=${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Baseline
PY=${PYTHON:-python}
: "${METHOD:?METHOD required: SPRINT, RAFT-PatchSTG, SARAF-PatchSTG, or RAST-PatchSTG}"
: "${SEED:?SEED required}"
case "$METHOD" in
  SPRINT|RAFT-PatchSTG|SARAF-PatchSTG|RAST-PatchSTG) ;;
  *) echo "Invalid secondary METHOD=$METHOD"; exit 2;;
esac
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "SecondaryPatchFormal" "$METHOD" "seed${SEED}" "formal"
baseline_install_exit_trap
export PYTHONPATH="$ROOT:${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Base_SupportBench:${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Base_SupportBench:${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Base_SupportBench:${PYTHONPATH:-}"
cd "$ROOT"
echo "START Secondary PatchSTG Formal v1.1.0 method=$METHOD seed=$SEED"
"$PY" scripts/verify_official_sources.py
"$PY" scripts/validate_cache.py --stage formal
"$PY" scripts/validate_frozen_patchstg.py
"$PY" scripts/preflight.py --stage formal --method "$METHOD"
"$PY" scripts/preflight_formal.py --method "$METHOD" --seed "$SEED" --stage formal

case "$METHOD" in
  SPRINT)
    "$PY" scripts/check_sprint_runtime.py --stage formal
    "$PY" -u baseline/runners/sprint_runner.py --stage formal --seed "$SEED"
    ;;
  RAST-PatchSTG)
    "$PY" scripts/check_rast_runtime.py
    "$PY" -u baseline/runners/rast_runner.py --stage formal --seed "$SEED" --variant patchstg
    ;;
  RAFT-PatchSTG|SARAF-PatchSTG)
    "$PY" -u baseline/runners/retrieval_patchstg_control_runner.py \
      --method "$METHOD" --stage formal --seed "$SEED"
    ;;
esac

echo "SECONDARY PATCH FORMAL PASS method=$METHOD seed=$SEED"
