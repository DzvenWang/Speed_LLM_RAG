#!/bin/bash
# Compatibility entrypoint: finalized LEAF selector is LEAF-Qwen1.5B predict-select-supervise.
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N LEAFQwen15
export TRAFFIDENT_TARGET="${TARGET:-speed}"
set -euo pipefail
ROOT=${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Baseline; PY=${PYTHON:-python}
STAGE=${STAGE:-development}; SEED=${SEED:-10}
source "$ROOT/scripts/pbs_live_log.sh"; baseline_live_log_start "LEAF-Qwen1.5B" "$STAGE" "seed${SEED}" "predict_select_supervise"; baseline_install_exit_trap
export PYTHONPATH="$ROOT:${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Base_SupportBench:${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Base_SupportBench:${PYTHONPATH:-}"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
cd "$ROOT"; nvidia-smi
"$PY" scripts/check_leaf_qwen_runtime.py --gpu-load
"$PY" tests/smoke_leaf_qwen_contract.py
"$PY" scripts/verify_official_sources.py
"$PY" scripts/validate_cache.py --stage "$STAGE"
ARGS=(--stage "$STAGE" --seed "$SEED")
if [[ -n "${LEAF_RESUME_DIR:-}" ]]; then ARGS+=(--resume-dir "$LEAF_RESUME_DIR"); fi
"$PY" -u baseline/runners/leaf_qwen_runner.py "${ARGS[@]}"
echo "LEAF-QWEN1.5B SELECTOR PASS"
