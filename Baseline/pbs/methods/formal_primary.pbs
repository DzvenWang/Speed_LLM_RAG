#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=48GB,walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N BaselineFormal
export TRAFFIDENT_TARGET="${TARGET:-speed}"
set -euo pipefail
PROJECT_ROOT=${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}
ROOT="$PROJECT_ROOT/Baseline"
# Resolve the Python environment without assuming a machine-specific location.
# PBS_O_PATH is captured by PBS at qsub time, even if -V is not used.
resolve_tfp_environment() {
  local candidate part old_ifs
  for candidate in "${TFP_ENV_ROOT:-}" "${CONDA_PREFIX:-}"; do
    if [[ -n "$candidate" && -x "$candidate/bin/python" && -d "$candidate/conda-meta" ]]; then
      ENVROOT="$(cd "$candidate" && pwd -P)"; return 0
    fi
  done
  old_ifs="$IFS"; IFS=':'
  for part in ${PBS_O_PATH:-}; do
    if [[ "$part" == */bin && -x "$part/python" && -d "${part%/bin}/conda-meta" ]]; then
      ENVROOT="$(cd "${part%/bin}" && pwd -P)"; IFS="$old_ifs"; return 0
    fi
  done
  IFS="$old_ifs"
  echo "ERROR: No Conda Python environment found. Activate TFP before qsub, or pass -v TFP_ENV_ROOT=\$CONDA_PREFIX" >&2
  return 3
}
resolve_tfp_environment
PY="$ENVROOT/bin/python"
PY3="$ENVROOT/bin/python3"
[[ -x "$PY" ]] || { echo "ERROR Python not executable: $PY"; exit 3; }
[[ -x "$PY3" ]] || { echo "ERROR Python3 not executable: $PY3"; exit 3; }
export SPEED_LLM_RAG_ROOT="$PROJECT_ROOT"
export PATH="$ENVROOT/bin:$PATH"
: "${METHOD:?METHOD required}"
: "${SEED:?SEED required}"
case "$METHOD" in
  ImputeFormer|LRTC-TMCP|GinAR|RAFT|RAST|SARAF|ReMFT|RAST-PatchSTG|RAST-STLAformer|RAFT-PatchSTG|RAFT-STLAformer) ;;
  *) echo "METHOD=$METHOD is not supported by this Formal PBS"; exit 2;;
esac
case "$SEED" in 10) ;; *) echo "Formal v1.4.4 currently requires SEED=10"; exit 2;; esac
export BACKBONE_TRAIN_MODE="${BACKBONE_TRAIN_MODE:-incomplete}"
case "$BACKBONE_TRAIN_MODE" in
  incomplete|complete) ;;
  *) echo "ERROR BACKBONE_TRAIN_MODE must be incomplete or complete (got $BACKBONE_TRAIN_MODE)"; exit 2;;
esac
if [[ "$METHOD" == "RAST-PatchSTG" || "$METHOD" == "RAFT-PatchSTG" ]]; then
  BACKBONE="${BACKBONE:-PatchSTG}"
fi
if [[ "$METHOD" == "ImputeFormer" || "$METHOD" == "LRTC-TMCP" || "$METHOD" == "RAST-PatchSTG" || "$METHOD" == "RAST-STLAformer" || "$METHOD" == "RAFT-PatchSTG" || "$METHOD" == "RAFT-STLAformer" ]]; then
  : "${BACKBONE:?BACKBONE required for $METHOD (e.g. STLAformer or PatchSTG)}"
fi
if [[ "$METHOD" == "RAST-STLAformer" || "$METHOD" == "RAFT-STLAformer" ]]; then
  [[ "$BACKBONE" == "STLAformer" ]] || { echo "ERROR $METHOD requires BACKBONE=STLAformer"; exit 2; }
fi
if [[ "$METHOD" == "RAST-PatchSTG" || "$METHOD" == "RAFT-PatchSTG" ]]; then
  [[ "$BACKBONE" == "PatchSTG" ]] || { echo "ERROR $METHOD requires BACKBONE=PatchSTG"; exit 2; }
fi
if [[ "$METHOD" == "LRTC-TMCP" && "$SEED" != "10" ]]; then
  echo "LRTC-TMCP is deterministic; only seed10 is required"; exit 2
fi
USES_REFERENCE=0
case "$METHOD" in
  ImputeFormer|LRTC-TMCP|RAST-PatchSTG|RAST-STLAformer|RAFT-PatchSTG|RAFT-STLAformer) USES_REFERENCE=1;;
esac
if [[ "$USES_REFERENCE" != "1" && "$BACKBONE_TRAIN_MODE" == "complete" ]]; then
  echo "ERROR $METHOD does not consume a reference Backbone: BACKBONE_TRAIN_MODE=complete has no meaning"; exit 2
fi
source "$ROOT/scripts/pbs_live_log.sh"
if [[ "$USES_REFERENCE" == "1" ]]; then
  baseline_live_log_start "BaselineFormal" "$METHOD" "seed${SEED}" "$BACKBONE_TRAIN_MODE" "formal"
else
  baseline_live_log_start "BaselineFormal" "$METHOD" "seed${SEED}" "formal"
fi
baseline_install_exit_trap
export PYTHONPATH="$ROOT:$PROJECT_ROOT/Base_SupportBench:${PYTHONPATH:-}"
unset TRANSFORMERS_CACHE || true
cd "$ROOT"
echo "START Formal method=$METHOD target=$TRAFFIDENT_TARGET seed=$SEED reference_backbone_train_mode=$BACKBONE_TRAIN_MODE"
nvidia-smi
if [[ "$METHOD" == "ImputeFormer" || "$METHOD" == "LRTC-TMCP" || "$METHOD" == "RAST-PatchSTG" || "$METHOD" == "RAST-STLAformer" || "$METHOD" == "RAFT-PatchSTG" || "$METHOD" == "RAFT-STLAformer" ]]; then
  "$PY" scripts/preflight.py --stage formal --method "$METHOD" --backbone "$BACKBONE" --backbone-train-mode "$BACKBONE_TRAIN_MODE"
  "$PY" scripts/preflight_formal.py --method "$METHOD" --seed "$SEED" --stage formal --backbone "$BACKBONE" --backbone-train-mode "$BACKBONE_TRAIN_MODE"
else
  "$PY" scripts/preflight.py --stage formal --method "$METHOD"
  "$PY" scripts/preflight_formal.py --method "$METHOD" --seed "$SEED" --stage formal
fi
case "$METHOD" in
  ImputeFormer)
    "$PY" -u baseline/runners/imputeformer_runner.py --stage formal --seed "$SEED" --backbone "$BACKBONE" --backbone-train-mode "$BACKBONE_TRAIN_MODE";;
  LRTC-TMCP)
    "$PY" -u baseline/runners/lrtc_tmcp_runner.py --stage formal --seed "$SEED" --backbone "$BACKBONE" --backbone-train-mode "$BACKBONE_TRAIN_MODE";;
  GinAR) "$PY" -u baseline/runners/ginar_runner.py --stage formal --seed "$SEED";;
  RAFT) "$PY" -u baseline/runners/raft_runner.py --stage formal --seed "$SEED";;
  RAST) "$PY" scripts/check_rast_runtime.py; "$PY" -u baseline/runners/rast_runner.py --stage formal --seed "$SEED" --variant native;;
  SARAF) "$PY" -u baseline/runners/saraf_runner.py --stage formal --seed "$SEED";;
  ReMFT) "$PY" scripts/check_remft_runtime.py; "$PY" -u baseline/runners/remft_runner.py --stage formal --seed "$SEED";;
  RAST-PatchSTG) "$PY" scripts/check_rast_runtime.py; "$PY" -u baseline/runners/rast_runner.py --stage formal --seed "$SEED" --variant patchstg --backbone "$BACKBONE" --backbone-train-mode "$BACKBONE_TRAIN_MODE";;
  RAST-STLAformer) "$PY" scripts/check_rast_runtime.py; "$PY" -u baseline/runners/rast_runner.py --stage formal --seed "$SEED" --variant reference --backbone "$BACKBONE" --backbone-train-mode "$BACKBONE_TRAIN_MODE";;
  RAFT-PatchSTG) "$PY" -u baseline/runners/retrieval_reference_control_runner.py --method RAFT-PatchSTG --stage formal --seed "$SEED" --backbone "$BACKBONE" --backbone-train-mode "$BACKBONE_TRAIN_MODE";;
  RAFT-STLAformer) "$PY" -u baseline/runners/retrieval_reference_control_runner.py --method RAFT-STLAformer --stage formal --seed "$SEED" --backbone "$BACKBONE" --backbone-train-mode "$BACKBONE_TRAIN_MODE";;
esac
echo "PRIMARY FORMAL TRAINING PASS method=$METHOD seed=$SEED"

AUTO_EVAL="${AUTO_EVAL:-1}"
if [[ "$AUTO_EVAL" == "1" ]]; then
  if [[ "$METHOD" == "ImputeFormer" || "$METHOD" == "LRTC-TMCP" || "$METHOD" == "RAST-PatchSTG" || "$METHOD" == "RAST-STLAformer" || "$METHOD" == "RAFT-PatchSTG" || "$METHOD" == "RAFT-STLAformer" ]]; then
    FORMAL_PARENT="${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Baseline_exps/$TRAFFIDENT_TARGET/$METHOD/$BACKBONE"
    if [[ "$BACKBONE_TRAIN_MODE" == "complete" ]]; then FORMAL_PARENT="$FORMAL_PARENT/complete"; fi
    FORMAL_PARENT="$FORMAL_PARENT/TraffiDent_Net_06/formal"
  else
    FORMAL_PARENT="${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Baseline_exps/$TRAFFIDENT_TARGET/$METHOD/TraffiDent_Net_06/formal"
  fi
  FORMAL_RUN_DIR="$(ls -1dt "$FORMAL_PARENT"/*_seed"$SEED" 2>/dev/null | head -n 1 || true)"
  if [[ -z "$FORMAL_RUN_DIR" || ! -d "$FORMAL_RUN_DIR" || ! -f "$FORMAL_RUN_DIR/best.pt" || ! -f "$FORMAL_RUN_DIR/summary.json" ]]; then
    echo "ERROR invalid completed Formal run directory: $FORMAL_RUN_DIR"
    exit 3
  fi
  echo "AUTO_EVAL=1"
  echo "FORMAL_RUN_DIR=$FORMAL_RUN_DIR"
  echo "START DIRECT Core-5 EVALUATION method=$METHOD seed=$SEED severities=s20,s40,s60,s90"
  if [[ "$METHOD" == "ImputeFormer" || "$METHOD" == "LRTC-TMCP" || "$METHOD" == "RAST-PatchSTG" || "$METHOD" == "RAST-STLAformer" || "$METHOD" == "RAFT-PatchSTG" || "$METHOD" == "RAFT-STLAformer" ]]; then
    "$PY" -u scripts/run_evaluations.py --method "$METHOD" --seed "$SEED" --backbone "$BACKBONE" --backbone-train-mode "$BACKBONE_TRAIN_MODE" --formal-run-dir "$FORMAL_RUN_DIR"
  else
    "$PY" -u scripts/run_evaluations.py --method "$METHOD" --seed "$SEED" --formal-run-dir "$FORMAL_RUN_DIR"
  fi
  echo "DIRECT CORE5 EVALUATION PASS method=$METHOD seed=$SEED"
else
  echo "AUTO_EVAL=0; skipping post-Formal evaluation"
fi

echo "PRIMARY FORMAL PASS method=$METHOD seed=$SEED"
