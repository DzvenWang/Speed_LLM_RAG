#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=48GB,walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs/out/
#PBS -N BaseFormalPrimary
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
: "${METHOD:?METHOD required}"
: "${SEED:?SEED required}"
case "$METHOD" in
  ImputeFormer|LRTC-TMCP|GinAR|RAFT|RAST|SARAF|ReMFT) ;;
  *) echo "METHOD=$METHOD is not a primary Baseline"; exit 2;;
esac
case "$SEED" in 10|20|30) ;; *) echo "Invalid SEED=$SEED"; exit 2;; esac
if [[ "$METHOD" == "LRTC-TMCP" && "$SEED" != "10" ]]; then
  echo "LRTC-TMCP is deterministic; only seed10 is required"; exit 2
fi
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "BaselineFormal" "$METHOD" "seed${SEED}" "formal"
baseline_install_exit_trap
export PYTHONPATH="$ROOT:/scratch/mh20/zw1165/Speed_LLM_RAG/ExperimentCommon:/scratch/mh20/zw1165/Speed_LLM_RAG/Protocol:/scratch/mh20/zw1165/Speed_LLM_RAG/TraffiDent_SupportBench:${PYTHONPATH:-}"
unset TRANSFORMERS_CACHE || true
cd "$ROOT"
echo "START Primary Formal v1.0.0 method=$METHOD seed=$SEED"
nvidia-smi
"$PY" scripts/verify_official_sources.py
"$PY" scripts/preflight.py --stage formal --method "$METHOD"
"$PY" scripts/preflight_formal.py --method "$METHOD" --seed "$SEED" --stage formal
case "$METHOD" in
  ImputeFormer)
    "$PY" scripts/validate_frozen_patchstg.py
    "$PY" -u baseline/runners/imputeformer_runner.py --stage formal --seed "$SEED";;
  LRTC-TMCP)
    "$PY" scripts/validate_frozen_patchstg.py
    "$PY" -u baseline/runners/lrtc_tmcp_runner.py --stage formal --seed "$SEED";;
  GinAR) "$PY" -u baseline/runners/ginar_runner.py --stage formal --seed "$SEED";;
  RAFT) "$PY" -u baseline/runners/raft_runner.py --stage formal --seed "$SEED";;
  RAST) "$PY" scripts/check_rast_runtime.py; "$PY" tests/smoke_rast_import_contract.py; "$PY" -u baseline/runners/rast_runner.py --stage formal --seed "$SEED" --variant native;;
  SARAF) "$PY" -u baseline/runners/saraf_runner.py --stage formal --seed "$SEED";;
  ReMFT) "$PY" scripts/check_remft_runtime.py; "$PY" -u baseline/runners/remft_runner.py --stage formal --seed "$SEED";;
esac
echo "PRIMARY FORMAL PASS method=$METHOD seed=$SEED"
