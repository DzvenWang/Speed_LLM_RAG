#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=48GB,walltime=02:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs/out/
#PBS -N BaseSmokePrimary
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
: "${METHOD:?METHOD required}"
case "$METHOD" in ImputeFormer|LRTC-TMCP|GinAR|RAFT|RAST|SARAF|ReMFT) ;; *) exit 2;; esac
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "BaselineSmoke" "$METHOD" "seed10" "development"
baseline_install_exit_trap
export PYTHONPATH="$ROOT:/scratch/mh20/zw1165/Speed_LLM_RAG/ExperimentCommon:/scratch/mh20/zw1165/Speed_LLM_RAG/Protocol:/scratch/mh20/zw1165/Speed_LLM_RAG/TraffiDent_SupportBench:${PYTHONPATH:-}"
cd "$ROOT"
echo "START Primary Smoke v1.1.0 method=$METHOD"
nvidia-smi
"$PY" scripts/verify_official_sources.py
"$PY" scripts/preflight.py --stage development --method "$METHOD"
case "$METHOD" in
  ImputeFormer) "$PY" scripts/validate_frozen_patchstg.py; "$PY" -u baseline/runners/imputeformer_runner.py --stage development --seed 10 --smoke;;
  LRTC-TMCP) "$PY" scripts/validate_frozen_patchstg.py; "$PY" -u baseline/runners/lrtc_tmcp_runner.py --stage development --seed 10 --smoke;;
  GinAR) "$PY" -u baseline/runners/ginar_runner.py --stage development --seed 10 --smoke;;
  RAFT) "$PY" -u baseline/runners/raft_runner.py --stage development --seed 10 --smoke;;
  RAST) "$PY" scripts/check_rast_runtime.py; "$PY" -u baseline/runners/rast_runner.py --stage development --seed 10 --variant native --smoke;;
  SARAF) "$PY" -u baseline/runners/saraf_runner.py --stage development --seed 10 --smoke;;
  ReMFT) "$PY" scripts/check_remft_runtime.py; "$PY" -u baseline/runners/remft_runner.py --stage development --seed 10 --smoke;;
esac
echo "PRIMARY SMOKE PASS method=$METHOD"
