#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=12:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs/out/
#PBS -N RAFTDev
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
SEED=${SEED:-10}
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "RAFT" "development" "seed${SEED}"
baseline_install_exit_trap
export PYTHONPATH="$ROOT:/scratch/mh20/zw1165/Speed_LLM_RAG/Protocol:/scratch/mh20/zw1165/Speed_LLM_RAG/TraffiDent_SupportBench:${PYTHONPATH:-}"
unset TRANSFORMERS_CACHE || true
cd "$ROOT"
echo "START RAFT Development v0.6.0 seed=$SEED"
echo "SAFETY: Train-only retrieval memory; Development Train/Val only; no Test dataset is instantiated."
nvidia-smi
"$PY" scripts/verify_official_sources.py
"$PY" scripts/validate_cache.py --stage development
"$PY" scripts/retrieval_leakage_audit.py --stage development
"$PY" baseline/runners/raft_runner.py --stage development --seed "$SEED"
echo "RAFT DEVELOPMENT PASS"
