#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=48GB,walltime=02:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs/out/
#PBS -N BasePatchSmoke
set -euo pipefail

ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
: "${METHOD:?Submit with -v METHOD=ImputeFormer, LRTC-TMCP, SPRINT, RAFT-PatchSTG, SARAF-PatchSTG, or RAST-PatchSTG}"
case "$METHOD" in
  ImputeFormer|LRTC-TMCP|SPRINT|RAFT-PatchSTG|SARAF-PatchSTG|RAST-PatchSTG) ;;
  *) echo "Invalid METHOD=$METHOD"; exit 2;;
esac

source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "PatchSTGDependentSmoke" "$METHOD" "formal" "seed10"
baseline_install_exit_trap
export PYTHONPATH="$ROOT:/scratch/mh20/zw1165/Speed_LLM_RAG/ExperimentCommon:/scratch/mh20/zw1165/Speed_LLM_RAG/Protocol:/scratch/mh20/zw1165/Speed_LLM_RAG/TraffiDent_SupportBench:${PYTHONPATH:-}"
unset TRANSFORMERS_CACHE || true
cd "$ROOT"

echo "START PatchSTG-dependent GPU smoke v1.1.0 method=$METHOD"
nvidia-smi
"$PY" scripts/verify_official_sources.py
"$PY" scripts/validate_cache.py --stage formal
"$PY" scripts/validate_frozen_patchstg.py
"$PY" scripts/preflight.py --stage formal --method "$METHOD"
"$PY" scripts/preflight_formal.py --method "$METHOD" --seed 10 --stage formal

case "$METHOD" in
  RAST-PatchSTG)
    "$PY" scripts/check_rast_runtime.py
    "$PY" tests/smoke_rast_import_contract.py
    "$PY" -u baseline/runners/rast_runner.py --stage formal --seed 10 --variant patchstg --smoke
    ;;
  RAFT-PatchSTG|SARAF-PatchSTG)
    "$PY" -u baseline/runners/retrieval_patchstg_control_runner.py \
      --method "$METHOD" --stage formal --seed 10 --smoke
    ;;
  SPRINT)
    "$PY" scripts/check_sprint_runtime.py --stage formal
    "$PY" -u baseline/runners/sprint_runner.py --stage formal --seed 10 --smoke
    ;;
  LRTC-TMCP)
    "$PY" -u baseline/runners/lrtc_tmcp_runner.py --stage formal --seed 10 --smoke
    ;;
  ImputeFormer)
    "$PY" -u baseline/runners/imputeformer_runner.py --stage formal --seed 10 --smoke
    ;;
esac

echo "PATCHSTG-DEPENDENT GPU SMOKE PASS method=$METHOD"
