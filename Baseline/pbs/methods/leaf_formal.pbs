#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=36:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N LEAFFormal
export TRAFFIDENT_TARGET="${TARGET:-speed}"
set -euo pipefail
ROOT=${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Baseline; LOGROOT=${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Baseline_logs; PY=${PYTHON:-python}; SEED=${SEED:-10}
source "$ROOT/scripts/pbs_live_log.sh"; baseline_live_log_start "LEAF" "formal" "seed${SEED}" "branches"; baseline_install_exit_trap
export PYTHONPATH="$ROOT:${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Base_SupportBench:${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Base_SupportBench:${PYTHONPATH:-}"
cd "$ROOT"; nvidia-smi; "$PY" scripts/check_leaf_tfp_runtime.py; "$PY" scripts/verify_official_sources.py; "$PY" scripts/validate_cache.py --stage formal
"$PY" -u baseline/runners/leaf_runner.py --stage formal --seed "$SEED" --phase branches
echo "LEAF FORMAL BRANCH PASS"
