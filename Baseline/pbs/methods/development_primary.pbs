#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=48GB,walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs/out/
#PBS -N BaseDevPrimary
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
: "${METHOD:?METHOD required}"
: "${SEED:=10}"
case "$METHOD" in
  ImputeFormer|LRTC-TMCP|GinAR|RAFT|RAST|SARAF|ReMFT) ;;
  *) echo "METHOD=$METHOD is not a primary Baseline"; exit 2;;
esac
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "BaselineDevelopment" "$METHOD" "seed${SEED}" "development"
baseline_install_exit_trap
export PYTHONPATH="$ROOT:/scratch/mh20/zw1165/Speed_LLM_RAG/ExperimentCommon:/scratch/mh20/zw1165/Speed_LLM_RAG/Protocol:/scratch/mh20/zw1165/Speed_LLM_RAG/TraffiDent_SupportBench:${PYTHONPATH:-}"
unset TRANSFORMERS_CACHE || true
cd "$ROOT"
echo "START Primary Core-5 Development v1.1.0 method=$METHOD seed=$SEED"
nvidia-smi
"$PY" scripts/verify_official_sources.py
"$PY" scripts/preflight.py --stage development --method "$METHOD"
case "$METHOD" in
  ImputeFormer)
    "$PY" scripts/validate_frozen_patchstg.py
    "$PY" -u baseline/runners/imputeformer_runner.py --stage development --seed "$SEED";;
  LRTC-TMCP)
    [[ "$SEED" == "10" ]] || { echo "LRTC-TMCP is deterministic; use seed10"; exit 2; }
    "$PY" scripts/validate_frozen_patchstg.py
    "$PY" -u baseline/runners/lrtc_tmcp_runner.py --stage development --seed "$SEED";;
  GinAR) "$PY" -u baseline/runners/ginar_runner.py --stage development --seed "$SEED";;
  RAFT) "$PY" -u baseline/runners/raft_runner.py --stage development --seed "$SEED";;
  RAST) "$PY" scripts/check_rast_runtime.py; "$PY" tests/smoke_rast_import_contract.py; "$PY" -u baseline/runners/rast_runner.py --stage development --seed "$SEED" --variant native;;
  SARAF) "$PY" -u baseline/runners/saraf_runner.py --stage development --seed "$SEED";;
  ReMFT) "$PY" scripts/check_remft_runtime.py; "$PY" -u baseline/runners/remft_runner.py --stage development --seed "$SEED";;
esac
echo "PRIMARY DEVELOPMENT PASS method=$METHOD seed=$SEED"
