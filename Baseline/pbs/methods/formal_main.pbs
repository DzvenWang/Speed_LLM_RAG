#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=48GB,walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs/out/
#PBS -N BaselineFormal
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
: "${METHOD:?METHOD required}"
: "${SEED:?SEED required}"
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "BaselineFormal" "$METHOD" "seed${SEED}" "formal"
baseline_install_exit_trap
export PYTHONPATH="$ROOT:/scratch/mh20/zw1165/Speed_LLM_RAG/Protocol:/scratch/mh20/zw1165/Speed_LLM_RAG/TraffiDent_SupportBench:${PYTHONPATH:-}"
unset TRANSFORMERS_CACHE || true
cd "$ROOT"
echo "START Baseline Formal v0.6.0 method=$METHOD seed=$SEED"
nvidia-smi
if [[ "$METHOD" == "RAST" || "$METHOD" == "RAST-PatchSTG" ]]; then "$PY" scripts/check_rast_runtime.py; "$PY" tests/smoke_rast_import_contract.py; fi
"$PY" scripts/preflight.py --stage formal --method "$METHOD"
"$PY" scripts/preflight_formal.py --method "$METHOD" --seed "$SEED" --stage formal
case "$METHOD" in
  GinAR) "$PY" -u baseline/runners/ginar_runner.py --stage formal --seed "$SEED";;
  RAFT) "$PY" -u baseline/runners/raft_runner.py --stage formal --seed "$SEED";;
  SARAF) "$PY" -u baseline/runners/saraf_runner.py --stage formal --seed "$SEED";;
  ImputeFormer) "$PY" -u baseline/runners/imputeformer_runner.py --stage formal --seed "$SEED";;
  RAST) "$PY" -u baseline/runners/rast_runner.py --stage formal --seed "$SEED" --variant native;;
  RAST-PatchSTG) "$PY" -u baseline/runners/rast_runner.py --stage formal --seed "$SEED" --variant patchstg;;
  *) echo "unknown METHOD=$METHOD"; exit 2;;
esac
echo "BASELINE FORMAL PASS method=$METHOD seed=$SEED"
