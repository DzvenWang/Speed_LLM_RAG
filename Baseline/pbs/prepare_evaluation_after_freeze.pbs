#!/bin/bash
#PBS -P mh20
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=24GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs/out/
#PBS -N BaselineTestPrep
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
FREEZE=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_exps/FROZEN_BASELINE_PROTOCOL.json
SELECTION=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_exps/FORMAL_SELECTION.json
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "BaselineTestPrep" "evaluation"
baseline_install_exit_trap
if [ ! -f "$FREEZE" ]; then echo "REFUSE: missing $FREEZE"; exit 2; fi
if [ ! -f "$SELECTION" ]; then echo "REFUSE: missing $SELECTION"; exit 2; fi
cd "$ROOT"
echo "START Baseline evaluation-only cache v0.6.0"
"$PY" scripts/preflight.py --stage evaluation
"$PY" scripts/prepare_data.py --stage evaluation --force
"$PY" scripts/validate_cache.py --stage evaluation
