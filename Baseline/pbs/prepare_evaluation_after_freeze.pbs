#!/bin/bash
#PBS -P mh20
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=24GB
#PBS -l walltime=04:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs/out/
#PBS -N BaseCore5EvalPrep
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "BaselineCore5TestPrep" "evaluation"
baseline_install_exit_trap
cd "$ROOT"
echo "START Baseline Core-5 evaluation cache validation v1.1.0 (no Baseline freeze required)"
for s in 20 40 60 90; do
  "$PY" scripts/preflight.py --stage evaluation --severity "$s"
  "$PY" scripts/validate_cache.py --stage evaluation --severity "$s"
done
echo "BASELINE CORE5 EVALUATION CACHE VALIDATION PASS"
