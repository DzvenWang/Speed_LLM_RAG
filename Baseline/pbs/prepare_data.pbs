#!/bin/bash
#PBS -P mh20
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=24GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs/out/
#PBS -N BaselinePrep
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development}
FORCE=${FORCE:-0}
case "$STAGE" in development|formal|evaluation) ;; *) echo "Invalid STAGE=$STAGE"; exit 2;; esac
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "BaselinePrep" "$STAGE"
baseline_install_exit_trap
cd "$ROOT"
echo "START BaselinePrep v1.1.0 stage=$STAGE"
"$PY" scripts/preflight.py --stage "$STAGE"
if [ "$FORCE" = "1" ]; then
  "$PY" scripts/prepare_data.py --stage "$STAGE" --force
else
  "$PY" scripts/prepare_data.py --stage "$STAGE"
fi
"$PY" scripts/validate_cache.py --stage "$STAGE"
if [ "$STAGE" = development ] || [ "$STAGE" = formal ]; then
  "$PY" scripts/retrieval_leakage_audit.py --stage "$STAGE"
fi
