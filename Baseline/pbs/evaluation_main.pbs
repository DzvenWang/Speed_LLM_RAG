#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=48GB,walltime=12:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs/out/
#PBS -N BaselineEval
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Baseline_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
: "${METHOD:?METHOD required}"
: "${SEED:?SEED required}"
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "BaselineEvaluation" "$METHOD" "seed${SEED}" "evaluation"
baseline_install_exit_trap
export PYTHONPATH="$ROOT:/scratch/mh20/zw1165/Speed_LLM_RAG/Protocol:/scratch/mh20/zw1165/Speed_LLM_RAG/TraffiDent_SupportBench:${PYTHONPATH:-}"
unset TRANSFORMERS_CACHE || true
cd "$ROOT"
echo "START Baseline Evaluation v1.0.0 method=$METHOD seed=$SEED"
nvidia-smi
if [[ "$METHOD" == "ReMFT" ]]; then "$PY" scripts/check_remft_runtime.py; fi
"$PY" scripts/preflight.py --stage evaluation
"$PY" scripts/preflight_formal.py --method "$METHOD" --seed "$SEED" --stage evaluation
"$PY" -u scripts/run_evaluation.py --method "$METHOD" --seed "$SEED"
echo "BASELINE EVALUATION PASS method=$METHOD seed=$SEED"
