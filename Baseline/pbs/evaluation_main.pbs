#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=48GB,walltime=18:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N BaselineEvalCore5
export TRAFFIDENT_TARGET="${TARGET:-speed}"
set -euo pipefail
ROOT=${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Baseline
PY=${PYTHON:-python}
: "${METHOD:?METHOD required}"
: "${SEED:?SEED required}"
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "BaselineCore5Evaluation" "$METHOD" "seed${SEED}" "s20-s40-s60-s90"
baseline_install_exit_trap
export PYTHONPATH="$ROOT:${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Base_SupportBench:${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Base_SupportBench:${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}/Base_SupportBench:${PYTHONPATH:-}"
unset TRANSFORMERS_CACHE || true
cd "$ROOT"
echo "START Baseline Core-5 Multi-Severity Evaluation v1.1.0 method=$METHOD seed=$SEED"
nvidia-smi
if [[ "$METHOD" == "ReMFT" ]]; then "$PY" scripts/check_remft_runtime.py; fi
"$PY" -u scripts/run_evaluations.py --method "$METHOD" --seed "$SEED"
echo "BASELINE CORE5 EVALUATION PASS method=$METHOD seed=$SEED"
