#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=03:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -N PatchSTGOracle
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PatchSTG_Oracle_logs/out/
set -eo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PatchSTG_Oracle
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PatchSTG_Oracle_logs
STAGE=${STAGE:-development}; SEED=${SEED:-10}; RUN_TAG=${RUN_TAG:?RUN_TAG required}
mkdir -p "$LOGROOT" "$LOGROOT/out" /scratch/mh20/zw1165/Speed_LLM_RAG/PatchSTG_Oracle_exps
STAMP=$(date +%Y%m%d_%H%M%S); JOB_ID=${PBS_JOBID:-manual}; JOB_NUM=${JOB_ID%%.*}; LIVE_LOG="$LOGROOT/PatchSTGOracle.${STAGE}.seed${SEED}.${STAMP}.${JOB_NUM}.gadi-pbs.live.log"
export PYTHONUNBUFFERED=1 PYTHONIOENCODING=UTF-8
exec > >(while IFS= read -r line || [[ -n "$line" ]]; do printf '[%(%Y-%m-%d %H:%M:%S)T] %s\n' -1 "$line"; done | tee -a "$LIVE_LOG") 2>&1
echo "LIVE_LOG=$LIVE_LOG"; echo "PBS_JOBID=$JOB_ID"; echo "RUN_TAG=$RUN_TAG"
echo "================================================================================"
echo "START PatchSTG Complete-Observation / Oracle Information Ceiling Test"
echo "Scope: frozen PatchSTG; restore only canonical raw-valid history hidden by benchmark missingness."
echo "================================================================================"
on_exit(){ status=$?; trap - EXIT; echo "================================================================================"; [ "$status" -eq 0 ] && echo "PatchSTG Oracle PASS" || echo "PatchSTG Oracle FAIL"; echo "SCRIPT_EXIT_STATUS=$status"; echo "LIVE_LOG=$LIVE_LOG"; echo "================================================================================"; exit "$status"; }; trap on_exit EXIT
set +u; source ~/.bashrc; conda activate TFP; set -u
cd "$ROOT"
python "$ROOT/../Backbone/scripts/verify_official_sources.py"
python scripts/preflight.py --stage "$STAGE"
python scripts/run_oracle.py --stage "$STAGE" --run-tag "$RUN_TAG"
