#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
set -euo pipefail
# Find runtime helper from the submission working directory (PBS scripts can be spooled).
_RUNTIME=""
for _dir in "${SPEED_LLM_RAG_ROOT:-}" "${PBS_O_WORKDIR:-}" "${PWD:-}"; do
  [[ -n "$_dir" && -d "$_dir" ]] || continue
  _dir="$(cd "$_dir" && pwd -P)"
  while :; do
    if [[ -f "$_dir/PCFT-STLA/pbs/runtime.sh" ]]; then
      _RUNTIME="$_dir/PCFT-STLA/pbs/runtime.sh"; break 2
    fi
    [[ "$_dir" == / ]] && break
    _dir="$(dirname "$_dir")"
  done
done
[[ -n "$_RUNTIME" ]] || { echo 'ERROR: runtime.sh not found. Submit qsub from within repository tree or set SPEED_LLM_RAG_ROOT.' >&2; exit 2; }
source "$_RUNTIME"
: "${FULL_CHECKPOINT:?Set FULL_CHECKPOINT to the already-trained Full best.pt}"
[[ "$FULL_CHECKPOINT" = /* ]] || FULL_CHECKPOINT="$ROOT/$FULL_CHECKPOINT"
LOGDIR="$ROOT/PCFT-STLA_logs/p0"
mkdir -p "$LOGDIR"
exec "$PYTHON" -u "PCFT-STLA/scripts/p0_candidate_probe.py" \
  --checkpoint "$FULL_CHECKPOINT" \
  --max-queries "${P0_MAX_QUERIES:-0}" \
  --batch-size "${P0_BATCH_SIZE:-8}"
