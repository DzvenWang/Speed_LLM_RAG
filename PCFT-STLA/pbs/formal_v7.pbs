#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
set -euo pipefail
ROOT="${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
ROOT="$(cd "$ROOT" && pwd -P)"
[[ -f "$ROOT/PCFT-STLA/scripts/run_v7.py" && -d "$ROOT/Backbone" && -d "$ROOT/Base_SupportBench" ]] || { echo "V7_FATAL_INVALID_ROOT $ROOT"; exit 2; }
PYTHON="${TFP_ENV_ROOT:-/g/data/mh20/zw1165/envs/TFP}/bin/python"
[[ -x "$PYTHON" ]] || { echo "V7_FATAL_TFP_PYTHON $PYTHON"; exit 2; }
export SPEED_LLM_RAG_ROOT="$ROOT" PYTHONUNBUFFERED=1
export PYTHONPATH="$ROOT/PCFT-STLA:$ROOT/Backbone:$ROOT/Base_SupportBench:${PYTHONPATH:-}"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
cd "$ROOT"
TARGET="${TARGET:-speed}"; DATASET="${DATASET:-TraffiDent_Net_06}"; SEED="${SEED:-10}"
CHECKPOINT="${CHECKPOINT:-}"
[[ "$TARGET" == speed || "$TARGET" == flow ]] || { echo 'Invalid TARGET';exit 2; }
[[ -n "$CHECKPOINT" ]] || { echo 'CHECKPOINT required';exit 2; }
[[ "$CHECKPOINT" == /* ]] || CHECKPOINT="$ROOT/$CHECKPOINT"
[[ -f "$CHECKPOINT" ]] || { echo "V7_FATAL_MISSING_CHECKPOINT $CHECKPOINT";exit 2; }
mkdir -p "PCFT-STLA_logs/$TARGET/incomplete/v7"
STAMP="$(date +%Y%m%d_%H%M%S)"
NAME="${RUN_NAME:-${STAMP}_seed${SEED}}"
LOG="PCFT-STLA_logs/$TARGET/incomplete/v7/${NAME}.${PBS_JOBID:-local}.live.log"
MON="${LOG%.live.log}.gpu.csv"
monitor_pid=''
cleanup() { [[ -z "$monitor_pid" ]] || kill "$monitor_pid" 2>/dev/null || true; }
trap cleanup EXIT
if command -v nvidia-smi >/dev/null 2>&1; then
  nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used,memory.total --format=csv -l 30 > "$MON" 2>&1 & monitor_pid=$!
fi
{
  echo "START_PCFT_V7 $(date -Is) target=$TARGET dataset=$DATASET seed=$SEED"
  "$PYTHON" --version
  "$PYTHON" -c 'import torch;assert torch.cuda.is_available();print("V7_CUDA_READY",torch.cuda.get_device_name(0),flush=True)'
  args=(--target "$TARGET" --dataset "$DATASET" --seed "$SEED" --backbone-checkpoint "$CHECKPOINT" --run-name "$NAME")
  [[ -z "${BATCH_SIZE:-}" ]] || args+=(--batch-size "$BATCH_SIZE")
  [[ -z "${TRAIN_MASK_MODE:-}" ]] || args+=(--train-mask-mode "$TRAIN_MASK_MODE")
  [[ -z "${RESUME_CHECKPOINT:-}" ]] || args+=(--resume "$RESUME_CHECKPOINT")
  if [[ "${RUN_GPU_SMOKE_ONLY:-0}" == 1 ]]; then args+=(--gpu-smoke-only);fi
  "$PYTHON" -u PCFT-STLA/scripts/run_v7.py "${args[@]}"
  echo "FINISH_PCFT_V7 $(date -Is) target=$TARGET"
} 2>&1 | tee -a "$LOG"
# pipefail ensures Python nonzero exit survives tee.
