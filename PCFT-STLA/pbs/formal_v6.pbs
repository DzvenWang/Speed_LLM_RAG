#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
set -euo pipefail

find_root() {
  local p
  for p in "${SPEED_LLM_RAG_ROOT:-}" "${PBS_O_WORKDIR:-}" "$PWD"; do
    [[ -n "$p" && -d "$p" ]] || continue
    p="$(cd "$p" && pwd -P)"
    while :; do
      if [[ -f "$p/PCFT-STLA/scripts/run_v6.py" && -d "$p/Backbone" && -d "$p/Base_SupportBench" ]]; then
        ROOT="$p"; return 0
      fi
      [[ "$p" == / ]] && break
      p="$(dirname "$p")"
    done
  done
  echo 'ERROR: Cannot find repository root'; return 2
}
find_root
export SPEED_LLM_RAG_ROOT="$ROOT" PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}" MKL_NUM_THREADS="${MKL_NUM_THREADS:-4}" OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-4}"
export PYTHONPATH="$ROOT/PCFT-STLA:$ROOT/Base_SupportBench:$ROOT/Backbone:${PYTHONPATH:-}"
PYTHON="${TFP_ENV_ROOT:-/g/data/mh20/zw1165/envs/TFP}/bin/python"
[[ -x "$PYTHON" ]] || { echo "ERROR: missing TFP Python at $PYTHON";exit 2; }
cd "$ROOT"
TARGET="${TARGET:-speed}"
DATASET="${DATASET:-TraffiDent_Net_06}"
SEED="${SEED:-10}"
BACKBONE_CHECKPOINT="${BACKBONE_CHECKPOINT:-}"
[[ "$TARGET" == speed || "$TARGET" == flow ]] || { echo "Invalid TARGET=$TARGET"; exit 2; }
[[ -n "$BACKBONE_CHECKPOINT" ]] || { echo 'Set BACKBONE_CHECKPOINT to original Backbone STLAformer best.pt'; exit 2; }
if [[ "$BACKBONE_CHECKPOINT" != /* ]]; then BACKBONE_CHECKPOINT="$ROOT/$BACKBONE_CHECKPOINT"; fi
[[ -f "$BACKBONE_CHECKPOINT" ]] || { echo "Missing checkpoint: $BACKBONE_CHECKPOINT";exit 2; }
STAMP="$(date +%Y%m%d_%H%M%S)"
RUN_NAME="${RUN_NAME:-${STAMP}_seed${SEED}}"
mkdir -p "PCFT-STLA_logs/$TARGET/incomplete/v6"
LOG="PCFT-STLA_logs/$TARGET/incomplete/v6/${RUN_NAME}.${PBS_JOBID:-local}.live.log"
GPU_LOG="${LOG%.live.log}.gpu.csv"
mon_pid=""
cleanup() { [[ -n "$mon_pid" ]] && kill "$mon_pid" 2>/dev/null || true; }
trap cleanup EXIT
if command -v nvidia-smi >/dev/null 2>&1; then
 nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used,memory.total,power.draw --format=csv -l 30 > "$GPU_LOG" 2>&1 &
 mon_pid="$!"
fi
{
 echo "START_V6 $(date -Is) target=$TARGET dataset=$DATASET seed=$SEED checkpoint=$BACKBONE_CHECKPOINT root=$ROOT"
 "$PYTHON" --version
 "$PYTHON" -m compileall -q PCFT-STLA/pcft_stla/v6 PCFT-STLA/scripts/run_v6.py PCFT-STLA/scripts/preflight_v6.py
 "$PYTHON" -u PCFT-STLA/scripts/preflight_v6.py --target "$TARGET" --dataset "$DATASET" --seed "$SEED" --backbone-checkpoint "$BACKBONE_CHECKPOINT"
 if [[ "${RUN_PREFLIGHT_ONLY:-0}" == 1 ]]; then
   exec "$PYTHON" -u PCFT-STLA/scripts/run_v6.py --target "$TARGET" --dataset "$DATASET" --seed "$SEED" --backbone-checkpoint "$BACKBONE_CHECKPOINT" --preflight-only
 fi
 extra=()
 [[ -n "${RESUME_CHECKPOINT:-}" ]] && extra+=(--resume "$RESUME_CHECKPOINT")
 [[ -n "${BATCH_SIZE:-}" ]] && extra+=(--batch-size "$BATCH_SIZE")
 [[ -n "${NUM_WORKERS:-}" ]] && extra+=(--workers "$NUM_WORKERS")
 "$PYTHON" -u PCFT-STLA/scripts/run_v6.py --target "$TARGET" --dataset "$DATASET" --seed "$SEED" --backbone-checkpoint "$BACKBONE_CHECKPOINT" --run-name "$RUN_NAME" "${extra[@]}"
 echo "FINISH_V6 $(date -Is) target=$TARGET"
} 2>&1 | awk '{if (substr($0,1,1)=="[" && substr($0,5,1)=="-") print $0;else print strftime("[%Y-%m-%d %H:%M:%S]"), $0;fflush()}' | tee -a "$LOG"
# pipefail propagates any Python failures
