#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -l wd
set -Eeuo pipefail
cd "${PBS_O_WORKDIR:?}"
export SPEED_LLM_RAG_ROOT="$PWD"
# Match the successful Backbone/PCFT-v6 PBS jobs: mount both project stores.
# Do not rely on a login-node Python check to establish compute-node visibility.
if [[ ! -d "$PWD/Backbone" || ! -d "$PWD/Base_SupportBench" || ! -f "$PWD/PCFT-STLA/diagnostics/propagation_identifiability/scripts/run_diagnostic.py" ]]; then
  echo "FATAL_PROJECT_STORAGE_UNAVAILABLE: project files missing on compute node; PBS storage request must include scratch/mh20+gdata/mh20" >&2
  exit 122
fi
export PYTHONPATH="$PWD/Backbone:$PWD/Base_SupportBench:${PYTHONPATH:-}"
export OMP_NUM_THREADS=6 OPENBLAS_NUM_THREADS=6 MKL_NUM_THREADS=6
# PBS jobs do NOT inherit interactive conda activation. Never call /bin/python.
PYTHON_BIN="${TFP_PYTHON:-/g/data/mh20/zw1165/envs/TFP/bin/python}"
if [[ ! -x "$PYTHON_BIN" ]]; then
  echo "FATAL_TFP_PYTHON_NOT_EXECUTABLE: $PYTHON_BIN" >&2
  exit 120
fi
if [[ "$PYTHON_BIN" != /* ]]; then
  echo "FATAL_TFP_PYTHON_NOT_ABSOLUTE: $PYTHON_BIN" >&2
  exit 121
fi
export PYTHONUNBUFFERED=1

: "${TARGET:?TARGET must be speed or flow}"
: "${CHECKPOINT:?CHECKPOINT must point to official STLA best.pt}"
SEED="${SEED:-10}"
if [[ "$CHECKPOINT" != /* ]]; then CHECKPOINT="$PWD/$CHECKPOINT"; fi
[[ -f "$CHECKPOINT" ]] || { echo "FATAL_CHECKPOINT_NOT_VISIBLE: $CHECKPOINT" >&2; exit 123; }
LOGDIR="$PWD/PCFT-STLA_logs/propagation_identifiability"
mkdir -p "$LOGDIR"
LOG="$LOGDIR/${TARGET}.seed${SEED}.${PBS_JOBID:-manual}.live.log"
# Prefix only genuinely unprefixed lines (Python already prefixes its own logs).
{
  echo "PHYSICAL_DIAGNOSTIC_START target=$TARGET pbs=${PBS_JOBID:-none}"
  # Lightweight compute-node checks prevent costly failure after long statistics.
  "$PYTHON_BIN" - <<'PY_CHECK'
import sys,torch
print('PYTHON_EXECUTABLE',sys.executable,flush=True)
print('TORCH_VERSION',torch.__version__,flush=True)
if not torch.cuda.is_available():
    raise RuntimeError('GPU PBS resource allocated but CUDA is unavailable')
print('CUDA_DEVICE',torch.cuda.get_device_name(0),flush=True)
PY_CHECK
  "$PYTHON_BIN" -u PCFT-STLA/diagnostics/propagation_identifiability/scripts/run_diagnostic.py \
    --phase preflight --preflight-gpu --confirm-val --target "$TARGET" --seed "$SEED" --repo "$PWD" \
    --checkpoint "$CHECKPOINT"
  "$PYTHON_BIN" -u PCFT-STLA/diagnostics/propagation_identifiability/scripts/run_diagnostic.py \
    --target "$TARGET" --seed "$SEED" --repo "$PWD" \
    --phase all --confirm-val --checkpoint "$CHECKPOINT" \
    --batch-size 16
  echo "PHYSICAL_DIAGNOSTIC_END status=success"
} 2>&1 | awk '{ if ($0 ~ /^\[20[0-9][0-9]-[0-9][0-9]-[0-9][0-9][T ]/) print $0; else print strftime("[%Y-%m-%d %H:%M:%S]"),$0; fflush(); }' | tee "$LOG"
