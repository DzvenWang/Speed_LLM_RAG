#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=48GB,walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N BL_ReEval
set -euo pipefail
: "${METHOD:?METHOD required}"
: "${TARGET:?TARGET required}"
: "${FORMAL_RUN_DIR:?FORMAL_RUN_DIR required}"
SEED="${SEED:-10}"
MODE="${MODE:-incomplete}"
BACKBONE="${BACKBONE:-}"
case "$TARGET" in speed|flow) ;; *) echo "Invalid TARGET=$TARGET"; exit 2;; esac
case "$MODE" in incomplete|complete) ;; *) echo "Invalid MODE=$MODE"; exit 2;; esac
case "$METHOD" in
  GinAR|ImputeFormer|LRTC-TMCP|RAFT|RAST|SARAF|ReMFT|RAFT-PatchSTG|RAFT-STLAformer|RAST-PatchSTG|RAST-STLAformer) ;;
  *) echo "Unsupported eval method=$METHOD"; exit 2;;
esac
case "$METHOD" in
  ImputeFormer|LRTC-TMCP|RAFT-PatchSTG|RAFT-STLAformer|RAST-PatchSTG|RAST-STLAformer)
    [[ -n "$BACKBONE" ]] || { echo "Missing reference BACKBONE"; exit 2; };;
  *) [[ -z "$BACKBONE" ]] || { echo "Independent method must not set BACKBONE"; exit 2; }
     [[ "$MODE" == incomplete ]] || { echo "Independent method cannot set MODE=complete"; exit 2; };;
esac
PROJECT_ROOT="${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
ROOT="$PROJECT_ROOT/Baseline"
# Resolve the Python environment without assuming a machine-specific location.
# PBS_O_PATH is captured by PBS at qsub time, even if -V is not used.
resolve_tfp_environment() {
  local candidate part old_ifs
  for candidate in "${TFP_ENV_ROOT:-}" "${CONDA_PREFIX:-}"; do
    if [[ -n "$candidate" && -x "$candidate/bin/python" && -d "$candidate/conda-meta" ]]; then
      ENVROOT="$(cd "$candidate" && pwd -P)"; return 0
    fi
  done
  old_ifs="$IFS"; IFS=':'
  for part in ${PBS_O_PATH:-}; do
    if [[ "$part" == */bin && -x "$part/python" && -d "${part%/bin}/conda-meta" ]]; then
      ENVROOT="$(cd "${part%/bin}" && pwd -P)"; IFS="$old_ifs"; return 0
    fi
  done
  IFS="$old_ifs"
  echo "ERROR: No Conda Python environment found. Activate TFP before qsub, or pass -v TFP_ENV_ROOT=\$CONDA_PREFIX" >&2
  return 3
}
resolve_tfp_environment
PY="$ENVROOT/bin/python"
[[ -x "$PY" ]] || { echo "Python not found: $PY"; exit 3; }
[[ -f "$FORMAL_RUN_DIR/best.pt" && -f "$FORMAL_RUN_DIR/summary.json" ]] || { echo "Formal run missing best.pt or summary.json: $FORMAL_RUN_DIR"; exit 3; }
export SPEED_LLM_RAG_ROOT="$PROJECT_ROOT" TRAFFIDENT_TARGET="$TARGET" BACKBONE_TRAIN_MODE="$MODE"
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$ROOT:$PROJECT_ROOT/Base_SupportBench:${PYTHONPATH:-}"
export PATH="$ENVROOT/bin:$PATH"
unset TRANSFORMERS_CACHE || true
"$PY" - <<'PYCODE'
from experiment_common.metrics import MAPE_PROTOCOL, MAPE_MIN_TARGET_ABS
print('MAPE_PROTOCOL=',MAPE_PROTOCOL,'MAPE_MIN_TARGET_ABS=',MAPE_MIN_TARGET_ABS,flush=True)
PYCODE
LOGROOT="$PROJECT_ROOT/Baseline_logs/$TARGET"
source "$ROOT/scripts/pbs_live_log.sh"
baseline_live_log_start "BaselineReEval" "$METHOD" "$TARGET" "${BACKBONE:-native}" "$MODE" "seed${SEED}"
baseline_install_exit_trap
cd "$ROOT"
echo "START BASELINE EVAL ONLY method=$METHOD target=$TARGET backbone=${BACKBONE:-native} mode=$MODE seed=$SEED"
echo "FORMAL_RUN_DIR=$FORMAL_RUN_DIR"
cmd=("$PY" -u scripts/run_evaluations.py --method "$METHOD" --seed "$SEED" --formal-run-dir "$FORMAL_RUN_DIR")
if [[ -n "$BACKBONE" ]]; then
  cmd+=(--backbone "$BACKBONE" --backbone-train-mode "$MODE")
fi
"${cmd[@]}"
echo "BASELINE REEVALUATION PASS"
