#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=32GB,walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N FARE501_OOF
set -euo pipefail
ROOT="${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-}}"
if [[ -z "$ROOT" || ! -f "$ROOT/FARE/scripts/run_oof_pipeline.py" ]]; then echo "Invalid root" >&2;exit 2;fi
cd "$ROOT"
PYTHON="${FARE_PYTHON:-}"
if [[ -z "$PYTHON" || ! -x "$PYTHON" ]]; then echo "FARE_PYTHON must be absolute TFP interpreter" >&2;exit 2;fi
export PATH="$(dirname "$PYTHON"):$PATH"
export SPEED_LLM_RAG_ROOT="$ROOT"
export PYTHONPATH="$ROOT/FARE:$ROOT/Backbone:$ROOT/Base_SupportBench:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-6}"
"$PYTHON" -c 'import os,sys,torch;assert os.path.realpath(sys.executable)==os.path.realpath(os.environ["FARE_PYTHON"]);assert torch.cuda.is_available(),"GPU not visible";print("FARE_OOF_GPU",torch.cuda.get_device_name(0),flush=True)'
mkdir -p FARE_logs/oof
STAMP="$(date +%Y%m%d_%H%M%S)"
LOG="FARE_logs/oof/FARE5.OOF.${STAMP}.${PBS_JOBID:-manual}.live.log"
CMD=("$PYTHON" -u FARE/scripts/run_oof_pipeline.py --config "${FARE_CONFIG:-FARE/configs/formal.yaml}" --dataset "${DATASET:-TraffiDent_Net_06}" --target "${TARGET:-both}" --seed "${SEED:-10}" --nfolds "${OOF_FOLDS:-4}" --warmup "${OOF_WARMUP:-0.2}" --purge "${OOF_PURGE:-12}" --batch-size "${OOF_BATCH_SIZE:-64}" --workers "${OOF_WORKERS:-4}")
if [[ -n "${OOF_EPOCHS:-}" ]]; then CMD+=(--epochs "$OOF_EPOCHS"); fi
if [[ -n "${SPEED_CHECKPOINT:-}" ]]; then CMD+=(--speed-checkpoint "$SPEED_CHECKPOINT"); fi
if [[ -n "${FLOW_CHECKPOINT:-}" ]]; then CMD+=(--flow-checkpoint "$FLOW_CHECKPOINT"); fi
"${CMD[@]}" 2>&1 | awk '{print strftime("[%Y-%m-%d %H:%M:%S]"),$0;fflush()}' | tee "$LOG"
echo FARE503_OOF_PBS_PASS
