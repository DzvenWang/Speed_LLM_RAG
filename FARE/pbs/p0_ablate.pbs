#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=32GB,walltime=24:00:00
#PBS -l storage=scratch/mh20
#PBS -j oe

set -euo pipefail

cd /scratch/mh20/zw1165/Speed_LLM_RAG

export SPEED_LLM_RAG_ROOT="$PWD"
export PYTHONUNBUFFERED=1
export PYTHONPATH="$PWD:${PYTHONPATH:-}"

PYTHON=/scratch/mh20/zw1165/envs/TFP/bin/python

: "${TARGET:?TARGET must be speed or flow}"

STAMP=20261009_140229_322315_seed10

RUN="FARE_exps/${TARGET}/TraffiDent_Net_06/pilot/${STAMP}"

CKPT="${RUN}/candidate_best.pt"
MEM="${RUN}/memory.npz"

test -f "$CKPT"
test -f "$MEM"

P0STAMP=$(date +%Y%m%d_%H%M%S)

OUT="${RUN}/p0_ablation_val_${P0STAMP}"
LOG="FARE_logs/p0_ablation/${TARGET}.${P0STAMP}.log"

mkdir -p "$(dirname "$LOG")"

echo "FARE_P0_START $(date)"
echo "Target: $TARGET"
echo "Checkpoint: $CKPT"
echo "Memory: $MEM"
echo "Output: $OUT"

"$PYTHON" -u FARE/scripts/ablate.py \
    --checkpoint "$CKPT" \
    --split val \
    --severities 20 40 60 90 \
    --modes \
        full \
        retrieval_off \
        no_memory \
        random_memory \
        state_only \
        innovation_only \
        constant_alpha \
    --output "$OUT" \
    2>&1 | tee "$LOG"

echo "FARE_P0_FINISH $(date)"
