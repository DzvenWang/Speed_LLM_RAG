#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=32GB,walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N FARE_eval
set -euo pipefail
cd "${SPEED_LLM_RAG_ROOT:-$PBS_O_WORKDIR}"
source FARE/pbs/_activate_tfp.sh
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${NCPUS:-12}"

# Use either CHECKPOINT=<path> or RUN_DIR=<experiment directory>.
# CHECKPOINT_KIND=candidate|evidence|retrieval|integration|control
KIND="${CHECKPOINT_KIND:-candidate}"
if [[ -z "${CHECKPOINT:-}" ]]; then
    : "${RUN_DIR:?Pass CHECKPOINT=/path/to/checkpoint.pt or RUN_DIR=/path/to/run-dir}"
    case "$KIND" in
        candidate) CHECKPOINT="$RUN_DIR/candidate_best.pt" ;;
        evidence|retrieval|integration|control) CHECKPOINT="$RUN_DIR/${KIND}_best.pt" ;;
        *) echo "ERROR: unsupported CHECKPOINT_KIND=$KIND" >&2; exit 2 ;;
    esac
fi
if [[ ! -f "$CHECKPOINT" ]]; then
    echo "ERROR: checkpoint does not exist: $CHECKPOINT" >&2
    exit 2
fi
RUN_DIR="${RUN_DIR:-$(dirname "$CHECKPOINT")}" 
SPLIT="${SPLIT:-test}"
MODE="${MODE:-full}"
EVAL_KIND="${EVAL_KIND:-manual}"
SEVERITIES="${SEVERITIES:-20:40:60:90}"
STAMP=$(date '+%Y%m%d_%H%M%S')
JOB="${PBS_JOBID:-manual}"
DATASET="${DATASET:-unknown_dataset}"
TARGET="${TARGET:-unknown_target}"
mkdir -p "FARE_logs/evaluate/${TARGET}/${DATASET}"
LOG="FARE_logs/evaluate/${TARGET}/${DATASET}/FARE.eval.${KIND}.${JOB}.${STAMP}.live.log"
if [[ -n "${EVAL_OUTPUT:-}" ]]; then
    OUTPUT="$EVAL_OUTPUT"
elif [[ "$EVAL_KIND" == "auto" ]]; then
    # Canonical automatic post-training result, isolated from final best evaluation.
    if [[ "$KIND" == "candidate" ]]; then
        OUTPUT="$RUN_DIR/evaluation_candidate"
    else
        OUTPUT="$RUN_DIR/evaluation"
    fi
else
    # Manual evaluation never overwrites an earlier formal evaluation by default.
    OUTPUT="$RUN_DIR/manual_evaluation/${KIND}.${SPLIT}.${STAMP}.${JOB}"
fi
cmd=(python -u FARE/scripts/evaluate.py --checkpoint "$CHECKPOINT" --split "$SPLIT" --mode "$MODE" --output "$OUTPUT")
if [[ "$SPLIT" == "test" ]]; then
    IFS=':' read -r -a severity_array <<< "$SEVERITIES"
    if (( ${#severity_array[@]} == 0 )); then echo 'ERROR: no severities' >&2; exit 2; fi
    cmd+=(--severities "${severity_array[@]}")
fi
if [[ -n "${BATCH_SIZE:-}" ]]; then cmd+=(--batch-size "$BATCH_SIZE"); fi
printf 'FARE_GADI_EVALUATE_START checkpoint=%s split=%s severities=%s output=%s\n' \
    "$CHECKPOINT" "$SPLIT" "$SEVERITIES" "$OUTPUT" | tee -a "$LOG"
"${cmd[@]}" "$@" 2>&1 | awk '{print strftime("[%Y-%m-%d %H:%M:%S]"), $0; fflush()}' | tee -a "$LOG"
printf 'FARE_GADI_EVALUATE_DONE output=%s\n' "$OUTPUT" | tee -a "$LOG"
