#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=32GB,walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N FARE_pilot
set -euo pipefail
cd "${SPEED_LLM_RAG_ROOT:-$PBS_O_WORKDIR}"
source FARE/pbs/_activate_tfp.sh
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-3}"
DATASET="${DATASET:-TraffiDent_Net_06}"
# Force the dedicated v2.0.2 PILOT config unless explicitly overridden.
FARE_CONFIG="${FARE_CONFIG:-FARE/configs/pilot.yaml}"
BATCH_SIZE="${BATCH_SIZE:-32}"
TARGET="${TARGET:-speed}"
SEED="${SEED:-10}"
# Evaluation runs in THIS GPU allocation, after training has finished.
# No held Evaluate PBS job is submitted by submit_gadi.py.
AUTO_EVALUATE="${AUTO_EVALUATE:-1}"
EVAL_SPLITS="${EVAL_SPLITS:-val}"
SEVERITIES="${SEVERITIES:-20:40:60:90}"
mkdir -p "FARE_logs/${TARGET}/${DATASET}"
STAMP=$(date '+%Y%m%d_%H%M%S')
JOB="${PBS_JOBID:-manual}"
LOG="FARE_logs/${TARGET}/${DATASET}/FARE.${TARGET}.${DATASET}.seed${SEED}.${JOB}.${STAMP}.train.live.log"
cmd=(python -u FARE/scripts/train.py --dataset "$DATASET" --target "$TARGET" --seed "$SEED" --variant "${FARE_VARIANT:-full}")
if [[ -n "${BATCH_SIZE:-}" ]]; then cmd+=(--batch-size "$BATCH_SIZE"); fi
if [[ -n "${NUM_WORKERS:-}" ]]; then cmd+=(--num-workers "$NUM_WORKERS"); fi
if [[ -n "${FARE_DIAG_INTERVAL:-}" ]]; then cmd+=(--diag-interval "$FARE_DIAG_INTERVAL"); fi
if [[ -n "${FARE_DIAG_MAX_BATCHES:-}" ]]; then cmd+=(--diag-max-batches "$FARE_DIAG_MAX_BATCHES"); fi
if [[ -n "${FARE_PROGRESS_EVERY:-}" ]]; then cmd+=(--progress-every "$FARE_PROGRESS_EVERY"); fi
if [[ "${FARE_DISABLE_DIAGNOSTICS:-0}" == "1" ]]; then cmd+=(--no-online-diagnostics); fi
if [[ -n "${RUN_DIR:-}" ]]; then cmd+=(--run-dir "$RUN_DIR"); fi
if [[ -n "${FARE_CONFIG:-}" ]]; then cmd+=(--config "$FARE_CONFIG"); fi
if [[ -n "${BACKBONE_CHECKPOINT:-}" ]]; then cmd+=(--backbone-checkpoint "$BACKBONE_CHECKPOINT"); fi
# Hardware resource sampling continues through train and automatic evaluation.
# Logs are stored beside the PBS live log and are independent of checkpoints.
printf 'FARE_PILOT_CONFIG config=%s batch_size=%s splits=%s\n' "$FARE_CONFIG" "$BATCH_SIZE" "$EVAL_SPLITS"
MONITOR_INTERVAL="${FARE_RESOURCE_INTERVAL:-30}"
MONITOR_ENABLED="${FARE_RESOURCE_MONITOR:-1}"
MONITOR_PREFIX="${LOG%.train.live.log}.resources"
MONITOR_PID=""
export FARE_RESOURCE_OUTPUT_PREFIX="$MONITOR_PREFIX"
cleanup_monitor() {
    local prior_status=$?
    trap - EXIT
    set +e
    if [[ -n "$MONITOR_PID" ]]; then
        kill -TERM "$MONITOR_PID" 2>/dev/null
        wait "$MONITOR_PID" 2>/dev/null
    fi
    # Also regenerate summary after abnormal program exit if JSONL is available.
    if [[ -s "${MONITOR_PREFIX}.jsonl" ]]; then
        python FARE/scripts/resource_monitor.py --output-prefix "$MONITOR_PREFIX" --summarize >/dev/null 2>&1
    fi
    # Record PBS's own final-ish resource accounting as a separate text file.
    if [[ -n "${PBS_JOBID:-}" ]] && command -v qstat >/dev/null 2>&1; then
        qstat -f "$PBS_JOBID" >"${MONITOR_PREFIX}.pbs.txt" 2>/dev/null || true
    fi
    python -u FARE/scripts/report_telemetry.py --live-log "$LOG" \
        --resource-prefix "$MONITOR_PREFIX" 2>&1 | tee -a "$LOG"
    printf 'FARE_RESOURCE_MONITOR_FILES prefix=%s status=%s\n' "$MONITOR_PREFIX" "$prior_status" | tee -a "$LOG"
    exit "$prior_status"
}
if [[ "$MONITOR_ENABLED" == "1" ]]; then
    python -u FARE/scripts/resource_monitor.py \
        --parent-pid "$$" --interval "$MONITOR_INTERVAL" \
        --output-prefix "$MONITOR_PREFIX" \
        >"${MONITOR_PREFIX}.monitor.log" 2>&1 &
    MONITOR_PID=$!
fi
trap cleanup_monitor EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
if [[ "$AUTO_EVALUATE" == "1" ]]; then
    cmd+=(--auto-evaluate)
    if [[ "$EVAL_SPLITS" != "auto" ]]; then
        IFS=':' read -r -a eval_split_array <<< "$EVAL_SPLITS"
        if (( ${#eval_split_array[@]} == 0 )); then echo 'ERROR: empty EVAL_SPLITS' >&2; exit 2; fi
        cmd+=(--eval-splits "${eval_split_array[@]}")
    fi
    IFS=':' read -r -a severity_array <<< "$SEVERITIES"
    if (( ${#severity_array[@]} == 0 )); then echo 'ERROR: empty SEVERITIES' >&2; exit 2; fi
    cmd+=(--eval-severities "${severity_array[@]}")
fi
printf 'FARE_GADI_TRAIN_START dataset=%s target=%s seed=%s auto_evaluate=%s eval_splits=%s severities=%s run_dir=%s\n' \
    "$DATASET" "$TARGET" "$SEED" "$AUTO_EVALUATE" "$EVAL_SPLITS" "$SEVERITIES" "${RUN_DIR:-auto}" | tee -a "$LOG"
"${cmd[@]}" "$@" 2>&1 | awk '{print strftime("[%Y-%m-%d %H:%M:%S]"), $0; fflush()}' | tee -a "$LOG"
printf 'FARE_GADI_JOB_DONE dataset=%s target=%s evaluated=%s\n' "$DATASET" "$TARGET" "$AUTO_EVALUATE" | tee -a "$LOG"
