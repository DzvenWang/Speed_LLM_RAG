#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/mh20
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR}"
export SPEED_LLM_RAG_ROOT="${PBS_O_WORKDIR}"
export PYTHONUNBUFFERED=1
TARGET="${TARGET:-speed}"
mkdir -p "FARE_logs/${TARGET}"
python -u FARE/scripts/run_pipeline.py --target "${TARGET}" --stage train
python -u FARE/scripts/run_pipeline.py --target "${TARGET}" --stage eval
