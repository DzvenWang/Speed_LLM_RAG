#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=32GB,walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N FARE_P01

set -euo pipefail
cd "${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-/scratch/mh20/zw1165/Speed_LLM_RAG}}"
export SPEED_LLM_RAG_ROOT="$PWD"
source FARE/pbs/_activate_tfp.sh
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${NCPUS:-12}"
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

DATASET="${DATASET:-TraffiDent_Net_06}"
SEED="${SEED:-10}"
PILOT_STAMP="${PILOT_STAMP:-20261009_140229_322315_seed10}"
STAMP=$(date +%Y%m%d_%H%M%S)
JOB="${PBS_JOBID:-manual}"
OUT="${P01_OUTPUT:-FARE_exps/diagnostics_p01/${DATASET}/${STAMP}_${JOB}}"
LOG="FARE_logs/diagnostics_p01/${DATASET}/p01.${JOB}.${STAMP}.live.log"
mkdir -p "$OUT" "$(dirname "$LOG")"

run_target() {
    local TARGET="$1"
    local RUN="FARE_exps/${TARGET}/${DATASET}/pilot/${PILOT_STAMP}"
    local CKPT="${RUN}/candidate_best.pt"
    local MEMORY="${RUN}/memory.npz"
    test -s "$CKPT" || { echo "FARE_P01_MISSING_CHECKPOINT $CKPT" >&2; return 2; }
    test -s "$MEMORY" || { echo "FARE_P01_MISSING_MEMORY $MEMORY" >&2; return 2; }
    printf '[%s] FARE_P01_TARGET_START target=%s checkpoint=%s memory=%s\n' "$(date '+%F %T')" "$TARGET" "$CKPT" "$MEMORY"
    # evaluate.py loads memory from checkpoint, so ensure its recorded path
    # resolves to this run; diagnose_p01.py verifies the checkpoint metadata.
    python -u FARE/scripts/diagnose_p01.py \
        --checkpoint "$CKPT" \
        --target "$TARGET" \
        --output "$OUT/$TARGET" \
        --severities 20 40 60 90 \
        --batch-size "${P01_BATCH_SIZE:-8}" \
        --sensitivity-batches "${P01_SENSITIVITY_BATCHES:-8}" \
        --random-repeats "${P01_RANDOM_REPEATS:-3}" \
        --probe-rows "${P01_PROBE_ROWS:-64}" \
        --probe-regions "${P01_PROBE_REGIONS:-4}" \
        --probe-candidates "${P01_PROBE_CANDIDATES:-8}" \
        --verify-reference-rows "${P01_VERIFY_ROWS:-32}" \
        --max-batches "${P01_MAX_BATCHES:-0}" \
        --seed "$SEED"
    printf '[%s] FARE_P01_TARGET_DONE target=%s\n' "$(date '+%F %T')" "$TARGET"
}

# Pipefail ensures a Python exception produces a failed PBS job; all stdout
# including diagnostics is timestamped into a single live-log file.
{
    echo "FARE_P01_JOB_START $(date -Is) job=$JOB project=$PWD output=$OUT"
    run_target speed
    run_target flow
    python -u FARE/scripts/report_p01.py --root "$OUT"
    echo "FARE_P01_JOB_PASS $(date -Is) output=$OUT"
} 2>&1 | awk '{print strftime("[%Y-%m-%d %H:%M:%S]"), $0; fflush()}' | tee -a "$LOG"
