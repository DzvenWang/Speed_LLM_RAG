#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=32GB,walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N FARE62_E1
set -euo pipefail
: "${SPEED_LLM_RAG_ROOT:?Missing root}"
: "${FARE_PYTHON:?Missing absolute TFP Python}"
: "${FARE62_STAGE:?Missing stage}"
: "${TARGET:?Missing target}"
cd "$SPEED_LLM_RAG_ROOT"
[[ -x "$FARE_PYTHON" ]] || { echo "Missing Python $FARE_PYTHON" >&2; exit 2; }
export PYTHONPATH="$PWD/FARE:$PWD/Backbone:$PWD/Base_SupportBench:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=6
LOGDIR="FARE_logs/$TARGET/${FARE62_DATASET:-TraffiDent_Net_06}"
mkdir -p "$LOGDIR"
LOG="$LOGDIR/FARE62_E1.${FARE62_STAGE}.${FARE62_VARIANT:-all}.${PBS_JOBID:-manual}.live.log"
CMD=("$FARE_PYTHON" -u FARE/scripts/experiment1.py
  --target "$TARGET" --dataset "${FARE62_DATASET:-TraffiDent_Net_06}"
  --seed "${FARE62_SEED:-10}" --stage "$FARE62_STAGE"
  --config "${FARE62_CONFIG:-FARE/configs/experiment1.yaml}"
  --backbone-checkpoint "$BACKBONE_CHECKPOINT"
  --memory "$FARE_MEMORY"
  --experiment-dir "$FARE62_EXPERIMENT_DIR")
if [[ -n "${FARE62_VARIANT:-}" ]]; then CMD+=(--variant "$FARE62_VARIANT"); fi
if [[ "${FARE62_SMOKE:-0}" == 1 ]]; then CMD+=(--smoke); fi
"${CMD[@]}" 2>&1 | awk '{print strftime("[%Y-%m-%d %H:%M:%S]"),$0;fflush()}' | tee "$LOG"
echo "FARE62_E1_PBS_PASS ${FARE62_STAGE} ${FARE62_VARIANT:-all}"
