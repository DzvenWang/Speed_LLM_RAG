#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=32GB,walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N FARE_cal
set -euo pipefail
cd "${SPEED_LLM_RAG_ROOT:-$PBS_O_WORKDIR}"
source FARE/pbs/_activate_tfp.sh
export PYTHONUNBUFFERED=1
: "${CHECKPOINT:?Set CHECKPOINT=/path/to/controller_best.pt}"
DATASET="${DATASET:-unknown_dataset}"
TARGET="${TARGET:-unknown_target}"
mkdir -p "FARE_logs/${TARGET}/${DATASET}"
STAMP=$(date '+%Y%m%d_%H%M%S')
LOG="FARE_logs/${TARGET}/${DATASET}/FARE.${TARGET}.${DATASET}.${PBS_JOBID:-manual}.${STAMP}.calibration.live.log"
python -u FARE/scripts/calibrate.py --checkpoint "$CHECKPOINT" "$@" 2>&1 |
    awk '{print strftime("[%Y-%m-%d %H:%M:%S]"), $0; fflush()}' | tee "$LOG"
