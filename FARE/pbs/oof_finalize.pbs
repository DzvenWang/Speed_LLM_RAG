#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=32GB,walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N FARE503_final
set -euo pipefail
ROOT="${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-}}"
[[ -n "$ROOT" && -f "$ROOT/FARE/scripts/run_oof_pipeline.py" ]] || exit 2
cd "$ROOT"
PYTHON="${FARE_PYTHON:?Missing FARE_PYTHON}"
[[ -x "$PYTHON" ]] || exit 2
export PATH="$(dirname "$PYTHON"):$PATH"
export SPEED_LLM_RAG_ROOT="$ROOT" PYTHONUNBUFFERED=1
export PYTHONPATH="$ROOT/FARE:$ROOT/Backbone:$ROOT/Base_SupportBench:${PYTHONPATH:-}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-6}"
"$PYTHON" -c 'import torch;assert torch.cuda.is_available();print("OOF_FINALIZE_GPU",torch.cuda.get_device_name(0),flush=True)'
mkdir -p FARE_logs/oof
LOG="FARE_logs/oof/finalize.${PBS_JOBID:-manual}.live.log"
CMD=("$PYTHON" -u FARE/scripts/run_oof_pipeline.py --config "${FARE_CONFIG:-FARE/configs/formal.yaml}" --dataset "${DATASET:-TraffiDent_Net_06}" --target "${TARGET:-both}" --seed "${SEED:-10}" --nfolds "${OOF_FOLDS:-2}" --warmup "${OOF_WARMUP:-0.3}" --purge "${OOF_PURGE:-12}" --batch-size "${OOF_BATCH_SIZE:-64}" --workers "${OOF_WORKERS:-4}" --output-dir "${OOF_OUTPUT_DIR:-FARE_cache/oof_v503}" --finalize-only)
if [[ -n "${OOF_EPOCHS:-}" ]]; then CMD+=(--epochs "$OOF_EPOCHS"); fi
if [[ -n "${SPEED_CHECKPOINT:-}" ]]; then CMD+=(--speed-checkpoint "$SPEED_CHECKPOINT"); fi
if [[ -n "${FLOW_CHECKPOINT:-}" ]]; then CMD+=(--flow-checkpoint "$FLOW_CHECKPOINT"); fi
"${CMD[@]}" 2>&1 | awk '{print strftime("[%Y-%m-%d %H:%M:%S]"),$0;fflush()}' | tee "$LOG"
for t in speed flow; do
  if [[ "${TARGET:-both}" != both && "${TARGET}" != "$t" ]]; then continue; fi
  "$PYTHON" -u FARE/scripts/preflight.py --config "${FARE_CONFIG:-FARE/configs/formal.yaml}" --dataset "${DATASET:-TraffiDent_Net_06}" --target "$t" --oos-forecast-file "FARE_cache/oof_${t}_paired.npz"
done
echo FARE503_OOF_FINALIZE_AND_PREFLIGHT_PASS
