#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=32GB,walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N FARE3_full
set -euo pipefail
cd "${SPEED_LLM_RAG_ROOT:-$PBS_O_WORKDIR}"
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate TFP
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-6}"
TARGET="${TARGET:-speed}"
DATASET="${DATASET:-TraffiDent_Net_06}"
SEED="${SEED:-10}"
CONFIG="${FARE_CONFIG:-FARE/configs/pilot.yaml}"
mkdir -p "FARE_logs/$TARGET/$DATASET"
STAMP=$(date +%Y%m%d_%H%M%S)
LOG="FARE_logs/$TARGET/$DATASET/FARE3.$STAMP.seed$SEED.${PBS_JOBID:-manual}.live.log"
MONITOR_PREFIX="${LOG%.live.log}.resources"
python -u FARE/scripts/resource_monitor.py --parent-pid "$$" --interval "${FARE_RESOURCE_INTERVAL:-30}" --output-prefix "$MONITOR_PREFIX" >"${MONITOR_PREFIX}.monitor.log" 2>&1 &
MONITOR_PID=$!
cleanup() { local status=$?; trap - EXIT; kill -TERM "$MONITOR_PID" 2>/dev/null || true; wait "$MONITOR_PID" 2>/dev/null || true; exit "$status"; }
trap cleanup EXIT
CMD=(python -u FARE/scripts/run_pipeline.py --config "$CONFIG" --dataset "$DATASET" --target "$TARGET" --seed "$SEED")
if [[ -n "${BACKBONE_CHECKPOINT:-}" ]]; then CMD+=(--checkpoint "$BACKBONE_CHECKPOINT"); fi
if [[ -n "${FARE_OOS_FORECAST_FILE:-}" ]]; then CMD+=(--oos-forecast-file "$FARE_OOS_FORECAST_FILE"); fi
if [[ -n "${FARE_RUN_DIR:-}" ]]; then CMD+=(--run-dir "$FARE_RUN_DIR"); fi
if [[ -n "${FARE_RESUME:-}" ]]; then CMD+=(--resume "$FARE_RESUME"); fi
if [[ "${FARE_SMOKE:-0}" == 1 ]]; then CMD+=(--smoke); fi
if [[ "${FARE_EVAL_VAL:-0}" == 1 ]]; then CMD+=(--eval-val); else CMD+=(--test-only); fi
"${CMD[@]}" 2>&1 | awk '{ print strftime("[%Y-%m-%d %H:%M:%S]"), $0; fflush(); }' | tee "$LOG"
echo FARE3_TRAIN_EVALUATION_ANALYSIS_PASS
