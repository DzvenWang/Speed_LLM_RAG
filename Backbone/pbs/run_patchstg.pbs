#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=24GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -N PatchSTG
#PBS -j oe

set -euo pipefail

# Defaults match the normal local command:
#   python scripts/run_experiment.py --stage formal --seed 10
# Override at submission time when needed, e.g.
#   qsub -v STAGE=formal,SEED=20 pbs/run_patchstg.pbs
: "${STAGE:=formal}"
: "${SEED:=10}"
: "${TARGET:?TARGET must be set to speed or flow (submit with -v TARGET=speed or TARGET=flow)}"
case "$TARGET" in
  speed|flow) ;;
  *) echo "ERROR: TARGET must be speed or flow; got '$TARGET'" >&2; exit 2 ;;
esac
case "$STAGE" in
  development|formal) ;;
  *) echo "ERROR: STAGE must be development or formal; got '$STAGE'" >&2; exit 2 ;;
esac
if ! [[ "$SEED" =~ ^[0-9]+$ ]]; then
  echo "ERROR: SEED must be an integer; got '$SEED'" >&2
  exit 2
fi

# Formal training must evaluate s20/s40/s60/s90 after a successful checkpoint.
# There is intentionally no AUTO_EVAL switch for Formal.

ROOT="${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
# If submitted from the Backbone directory, promote to the repository root.
if [[ "$(basename "$ROOT")" == "Backbone" ]]; then ROOT="$(cd "$ROOT/.." && pwd)"; fi
PROJ="$ROOT/Backbone"
LOGROOT="$ROOT/Backbone_logs/$TARGET/PatchSTG"
ENVROOT="${TFP_ENV_ROOT:-${CONDA_PREFIX:-}}"
if [[ -z "$ENVROOT" ]]; then
  echo "ERROR: TFP_ENV_ROOT is not set. Submit from an activated TFP environment with TFP_ENV_ROOT=$CONDA_PREFIX." >&2
  exit 3
fi
PYTHON="$ENVROOT/bin/python"

mkdir -p "$LOGROOT"
STAMP=$(date +%Y%m%d_%H%M%S)
JOBID="${PBS_JOBID:-manual}"
LOG="$LOGROOT/PatchSTG.${TARGET}.${STAGE}.seed${SEED}.${JOBID}.${STAMP}.live.log"
touch "$LOG"

early_log() {
  printf '[%s] %s\n' "$(date '+%F %T')" "$*" | tee -a "$LOG"
}
if [[ ! -d "$PROJ" ]]; then
  early_log "ERROR: Backbone project directory not found: $PROJ" >&2
  exit 3
fi
if [[ ! -x "$PYTHON" ]]; then
  early_log "ERROR: Python not executable: $PYTHON" >&2
  exit 3
fi

cd "$PROJ"
export SPEED_LLM_RAG_ROOT="$ROOT"
export TRAFFIDENT_TARGET="$TARGET"
export PATH="$ENVROOT/bin:$PATH"
unset TRANSFORMERS_CACHE || true
export PYTHONPATH="$PROJ:$ROOT/Base_SupportBench:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
export BACKBONE_PBS_LIVE_LOG=1

# One parent live log owns the entire train -> evaluation chain.
exec > >("$PYTHON" -u "$PROJ/timestamp_stream.py" | tee -a "$LOG") 2>&1
trap 'rc=$?; echo "SCRIPT_EXIT_STATUS=$rc"' EXIT

echo "START PatchSTG target=$TARGET stage=$STAGE seed=$SEED job=$JOBID host=$(hostname)"
echo "ROOT=$ROOT"
echo "TRAFFIDENT_TARGET=$TRAFFIDENT_TARGET"
echo "PROJ=$PROJ"
echo "PYTHON=$PYTHON"
echo "LIVE_LOG=$LOG"
"$PYTHON" -V
nvidia-smi || true

echo "TRAIN START"
echo "RUN: $PYTHON -u scripts/run_experiment.py --stage $STAGE --seed $SEED --run-stamp $STAMP"
"$PYTHON" -u scripts/run_experiment.py \
  --stage "$STAGE" \
  --seed "$SEED" \
  --run-stamp "$STAMP"

# Resolve the exact checkpoint generated by this run stamp and config.
CHECKPOINT=$("$PYTHON" - "$PROJ/configs/backbone.yaml" "$STAGE" "$STAMP" "$SEED" <<'PY'
from pathlib import Path
import sys
from backbone.utils import load_yaml
cfg = load_yaml(sys.argv[1])
stage, stamp, seed = sys.argv[2], sys.argv[3], int(sys.argv[4])
print(Path(cfg['project']['exp_root']) / 'PatchSTG' / cfg['experiment']['subgraph'] / stage / f'{stamp}_seed{seed}' / 'best.pt')
PY
)
if [[ ! -f "$CHECKPOINT" ]]; then
  echo "ERROR: training returned successfully but best checkpoint was not found: $CHECKPOINT" >&2
  exit 4
fi
echo "TRAINING_CHECKPOINT=$CHECKPOINT"
echo "TRAINING_PHASE_PASS stage=$STAGE seed=$SEED"

if [[ "$STAGE" == "formal" ]]; then
  echo "POST_TRAINING_EVAL START checkpoint=$CHECKPOINT"
  "$PYTHON" -u scripts/post_training_evaluate.py \
    --model PatchSTG \
    --checkpoint "$CHECKPOINT" \
    --seed "$SEED" \
    --run-stamp "$STAMP" \
    --config "$PROJ/configs/backbone.yaml"
  echo "POST_TRAINING_EVAL PASS checkpoint=$CHECKPOINT"
fi

echo "FINISH PatchSTG target=$TARGET stage=$STAGE seed=$SEED job=$JOBID"
