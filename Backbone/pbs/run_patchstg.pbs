#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=24GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -N PatchSTG
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Backbone_logs/

set -euo pipefail

# Defaults match the normal local command:
#   python scripts/run_experiment.py --stage formal --seed 10
# Override at submission time when needed, e.g.
#   qsub -v STAGE=formal,SEED=20 pbs/run_patchstg.pbs
# Formal jobs automatically evaluate s20/s40/s60/s90 after training.
# Disable only when needed with:
#   qsub -v STAGE=formal,SEED=10,AUTO_EVAL=0 pbs/run_patchstg.pbs
: "${STAGE:=formal}"
: "${SEED:=10}"
case "$STAGE" in
  development|formal) ;;
  *) echo "ERROR: STAGE must be development or formal; got '$STAGE'" >&2; exit 2 ;;
esac
if ! [[ "$SEED" =~ ^[0-9]+$ ]]; then
  echo "ERROR: SEED must be an integer; got '$SEED'" >&2
  exit 2
fi

# Formal: auto-evaluate by default. Development: train/val only by default.
if [[ -z "${AUTO_EVAL+x}" ]]; then
  if [[ "$STAGE" == "formal" ]]; then AUTO_EVAL=1; else AUTO_EVAL=0; fi
fi
case "$AUTO_EVAL" in
  0|1) ;;
  *) echo "ERROR: AUTO_EVAL must be 0 or 1; got '$AUTO_EVAL'" >&2; exit 2 ;;
esac
if [[ "$STAGE" != "formal" && "$AUTO_EVAL" == "1" ]]; then
  echo "ERROR: AUTO_EVAL=1 is supported only for STAGE=formal" >&2
  exit 2
fi

ROOT="${SPEED_LLM_RAG_ROOT:-/scratch/mh20/zw1165/Speed_LLM_RAG}"
PROJ="$ROOT/Backbone"
LOGROOT="$ROOT/Backbone_logs"
ENVROOT="${TFP_ENV_ROOT:-/scratch/mh20/zw1165/envs/TFP}"
PYTHON="$ENVROOT/bin/python"

mkdir -p "$LOGROOT"
STAMP=$(date +%Y%m%d_%H%M%S)
JOBID="${PBS_JOBID:-manual}"
LOG="$LOGROOT/PatchSTG.${STAGE}.seed${SEED}.${JOBID}.${STAMP}.live.log"
touch "$LOG"

early_log() {
  printf '[%s] %s\n' "$(date '+%F %T')" "$*" | tee -a "$LOG"
}
if [[ ! -d "$PROJ" ]]; then
  early_log "ERROR: Backbone project directory not found: $PROJ" >&2
  exit 3
fi
if [[ ! -x "$PYTHON" ]]; then
  early_log "ERROR: Python not executable: $PYTHON" >&2
  exit 3
fi

cd "$PROJ"
export SPEED_LLM_RAG_ROOT="$ROOT"
export PATH="$ENVROOT/bin:$PATH"
unset TRANSFORMERS_CACHE || true
export PYTHONPATH="$PROJ:$ROOT/ExperimentCommon:$ROOT/Protocol:$ROOT/TraffiDent_SupportBench:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
export BACKBONE_PBS_LIVE_LOG=1

# One parent live log owns the entire train -> evaluation chain.
exec > >("$PYTHON" -u "$PROJ/timestamp_stream.py" | tee -a "$LOG") 2>&1
trap 'rc=$?; echo "SCRIPT_EXIT_STATUS=$rc"' EXIT

echo "START PatchSTG stage=$STAGE seed=$SEED auto_eval=$AUTO_EVAL job=$JOBID host=$(hostname)"
echo "ROOT=$ROOT"
echo "PROJ=$PROJ"
echo "PYTHON=$PYTHON"
echo "LIVE_LOG=$LOG"
"$PYTHON" -V
nvidia-smi || true

echo "TRAIN START"
echo "RUN: $PYTHON -u scripts/run_experiment.py --stage $STAGE --seed $SEED --run-stamp $STAMP"
"$PYTHON" -u scripts/run_experiment.py \
  --stage "$STAGE" \
  --seed "$SEED" \
  --run-stamp "$STAMP"

# Resolve the exact checkpoint generated by this run stamp and config.
CHECKPOINT=$("$PYTHON" - "$PROJ/configs/backbone.yaml" "$STAGE" "$STAMP" "$SEED" <<'PY'
from pathlib import Path
import sys
from backbone.utils import load_yaml
cfg = load_yaml(sys.argv[1])
stage, stamp, seed = sys.argv[2], sys.argv[3], int(sys.argv[4])
print(Path(cfg['project']['exp_root']) / 'PatchSTG' / cfg['experiment']['subgraph'] / stage / f'{stamp}_seed{seed}' / 'best.pt')
PY
)
if [[ ! -f "$CHECKPOINT" ]]; then
  echo "ERROR: training returned successfully but best checkpoint was not found: $CHECKPOINT" >&2
  exit 4
fi
echo "TRAINING_CHECKPOINT=$CHECKPOINT"
echo "TRAINING_PHASE_PASS stage=$STAGE seed=$SEED"

if [[ "$AUTO_EVAL" == "1" ]]; then
  echo "AUTO_EVAL START checkpoint=$CHECKPOINT"
  echo "AUTO_EVAL CONFIG severities=20,40,60,90 families=entry_random,sensor_outage,temporal_outage,regional_outage,directional_outage"
  "$PYTHON" -u scripts/run_checkpoint_evaluations.py \
    --checkpoint "$CHECKPOINT" \
    --expected-seed "$SEED" \
    --run-stamp "$STAMP" \
    --config "$PROJ/configs/backbone.yaml" \
    --stdout-only
  echo "AUTO_EVAL PASS checkpoint=$CHECKPOINT"
else
  echo "AUTO_EVAL SKIP stage=$STAGE AUTO_EVAL=$AUTO_EVAL"
fi

echo "FINISH PatchSTG stage=$STAGE seed=$SEED auto_eval=$AUTO_EVAL job=$JOBID"
