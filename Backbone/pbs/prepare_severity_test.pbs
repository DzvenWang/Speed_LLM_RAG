#!/bin/bash
#PBS -P mh20
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=32GB
#PBS -l walltime=03:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -N BackboneSeverityPrep
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Backbone_logs/out/
set -euo pipefail
: "${SEVERITY:?Set SEVERITY to 20, 40, 60, or 90}"
case "$SEVERITY" in 20|40|60|90) ;; *) echo "SEVERITY must be 20/40/60/90" >&2; exit 2;; esac
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG
PROJ="$ROOT/Backbone"
LOGROOT="$ROOT/Backbone_logs"
ENVROOT=/scratch/mh20/zw1165/envs/TFP
PYTHON="$ENVROOT/bin/python"
CFG="$PROJ/configs/backbone_eval_s${SEVERITY}.yaml"
mkdir -p "$LOGROOT"
STAMP=$(date +%Y%m%d_%H%M%S)
LOG="$LOGROOT/BackboneSeverityPrep.s${SEVERITY}.${PBS_JOBID}.${STAMP}.live.log"
export PATH="$ENVROOT/bin:$PATH"
unset TRANSFORMERS_CACHE || true
export PYTHONPATH="$PROJ:$ROOT/ExperimentCommon:$ROOT/Protocol:$ROOT/TraffiDent_SupportBench:${PYTHONPATH:-}"
export BACKBONE_TIMESTAMP_STREAM=1 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
exec > >("$PYTHON" -u "$PROJ/timestamp_stream.py" | tee -a "$LOG") 2>&1
trap 'rc=$?; echo "SCRIPT_EXIT_STATUS=$rc"' EXIT
cd "$PROJ"
echo "START Backbone severity cache prep s${SEVERITY} job=$PBS_JOBID host=$(hostname)"
"$PYTHON" -u scripts/preflight.py --stage evaluation --config "$CFG"
"$PYTHON" -u scripts/prepare_data.py --stage evaluation --config "$CFG"
"$PYTHON" -u scripts/validate_cache.py --stage evaluation --config "$CFG"
