#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=04:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -N PatchSTGCheckpointEval
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Backbone_logs/
set -euo pipefail

ROOT="${SPEED_LLM_RAG_ROOT:-/scratch/mh20/zw1165/Speed_LLM_RAG}"
PROJ="$ROOT/Backbone"
LOGROOT="$ROOT/Backbone_logs"
ENVROOT="/scratch/mh20/zw1165/envs/TFP"
PYTHON="$ENVROOT/bin/python"

: "${SEVERITY:?Set SEVERITY=20|40|60|90}"
: "${CHECKPOINT:?Set CHECKPOINT to the PatchSTG best.pt to evaluate}"
case "$SEVERITY" in
  20|40|60|90) ;;
  *) echo "SEVERITY must be 20/40/60/90" >&2; exit 2 ;;
esac

SEED="${SEED:-10}"
if [[ "$CHECKPOINT" != /* ]]; then
  CHECKPOINT="$ROOT/$CHECKPOINT"
fi

mkdir -p "$LOGROOT"
STAMP=$(date +%Y%m%d_%H%M%S)
LOG="$LOGROOT/PatchSTG.checkpoint_eval.s${SEVERITY}.seed${SEED}.${PBS_JOBID}.${STAMP}.live.log"

export SPEED_LLM_RAG_ROOT="$ROOT"
export PATH="$ENVROOT/bin:$PATH"
unset TRANSFORMERS_CACHE || true
export PYTHONPATH="$PROJ:$ROOT/ExperimentCommon:$ROOT/Protocol:$ROOT/TraffiDent_SupportBench:${PYTHONPATH:-}"
export BACKBONE_TIMESTAMP_STREAM=1
export PYTHONUNBUFFERED=1
export PYTHONDONTWRITEBYTECODE=1

exec > >("$PYTHON" -u "$PROJ/timestamp_stream.py" | tee -a "$LOG") 2>&1
trap 'rc=$?; echo "SCRIPT_EXIT_STATUS=$rc"' EXIT

cd "$PROJ"
echo "START PatchSTG explicit checkpoint evaluation severity=${SEVERITY} seed=${SEED} job=${PBS_JOBID} host=$(hostname)"
echo "CHECKPOINT=$CHECKPOINT"
echo "LOG_FILE=$LOG"
"$PYTHON" -V
nvidia-smi || true

if [[ ! -f "$CHECKPOINT" ]]; then
  echo "ERROR checkpoint not found: $CHECKPOINT" >&2
  exit 3
fi

"$PYTHON" -u scripts/verify_official_sources.py
EVAL_ARGS=(
  --checkpoint "$CHECKPOINT"
  --severity "$SEVERITY"
  --expected-seed "$SEED"
  --config "$PROJ/configs/backbone.yaml"
)
if [[ -n "${LAYOUT_SNAPSHOT:-}" ]]; then
  EVAL_ARGS+=(--layout-snapshot "$LAYOUT_SNAPSHOT")
fi
if [[ "${ALLOW_CURRENT_LAYOUT_MISMATCH:-0}" == "1" ]]; then
  EVAL_ARGS+=(--allow-current-layout-mismatch)
fi
"$PYTHON" -u scripts/evaluate_checkpoint.py "${EVAL_ARGS[@]}"

echo "FINISHED PatchSTG explicit checkpoint evaluation severity=${SEVERITY} seed=${SEED}"
