#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=4
#PBS -l ngpus=1
#PBS -l mem=16GB
#PBS -l walltime=00:30:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -N BackboneNewSmoke
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Backbone_logs/
set -euo pipefail
: "${MODEL:?Submit with MODEL=PatchSTG}"
case "$MODEL" in PatchSTG) ;; *) echo "Unknown MODEL=$MODEL"; exit 2;; esac
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG
PROJ="$ROOT/Backbone"; ENVROOT=/scratch/mh20/zw1165/envs/TFP; PY="$ENVROOT/bin/python"
LOGROOT="$ROOT/Backbone_logs"; mkdir -p "$LOGROOT"; STAMP=$(date +%Y%m%d_%H%M%S)
LOG="$LOGROOT/BackboneNewSmoke.${MODEL}.${PBS_JOBID}.${STAMP}.live.log"
cd "$PROJ"; export PATH="$ENVROOT/bin:$PATH"; unset TRANSFORMERS_CACHE || true
export PYTHONPATH="$PROJ:$ROOT/Protocol:$ROOT/TraffiDent_SupportBench:${PYTHONPATH:-}" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
exec > >(tee -a "$LOG") 2>&1
trap 'rc=$?; echo "SCRIPT_EXIT_STATUS=$rc"' EXIT
echo "START recent adapter smoke model=$MODEL job=$PBS_JOBID host=$(hostname)"
nvidia-smi || true
"$PY" -u scripts/verify_official_sources.py
"$PY" -u scripts/preflight.py --model "$MODEL" --stage screening
"$PY" -u scripts/validate_cache.py --stage screening
"$PY" -u scripts/smoke_recent_gpu.py --model "$MODEL"
