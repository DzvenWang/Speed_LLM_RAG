#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=32GB,walltime=12:00:00,jobfs=10GB
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N STDNSpecialV4
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Backbone/STDN_Special/logs/

set -euo pipefail

ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Backbone
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
EXP=${EXP:?Submit with qsub -v EXP=e2_pat30 STDN_Special/pbs/run_single.pbs}
STAGE=${STAGE:-screening}
SEED=${SEED:-10}
STAMP="stdn_v4_${EXP}_$(date +%Y%m%d_%H%M%S)"
LOGDIR="$ROOT/STDN_Special/logs"
mkdir -p "$LOGDIR"
LIVE="$LOGDIR/${STAMP}.${PBS_JOBID}.live.log"

exec > >(awk '{ print strftime("[%Y-%m-%d %H:%M:%S]"), $0; fflush(); }' | tee -a "$LIVE") 2>&1

cd "$ROOT"
echo "START STDN_Special_v4 EXP=$EXP STAGE=$STAGE SEED=$SEED JOB=$PBS_JOBID HOST=$(hostname)"
echo "PYTHON=$PY"
"$PY" -V
nvidia-smi || true

"$PY" -u scripts/verify_official_sources.py
"$PY" -u scripts/validate_cache.py --stage "$STAGE"

# v4 hard gate: STDN uses TOD/DOW in temporal embedding and dynamic graph.
"$PY" -u STDN_Special/audit_time_features.py --stage "$STAGE"

# Exercise the exact in-memory cfg.models.STDN recipe before GPU training.
"$PY" -u STDN_Special/run_diagnostic.py \
  --experiment "$EXP" --stage "$STAGE" --seed "$SEED" \
  --run-stamp "${STAMP}_preflight" --preflight-only

"$PY" -u STDN_Special/run_diagnostic.py \
  --experiment "$EXP" --stage "$STAGE" --seed "$SEED" --run-stamp "$STAMP"

"$PY" -u STDN_Special/verify_effective_log.py --log "$LIVE" --experiment "$EXP"

echo "FINISH STDN_Special_v4 EXP=$EXP VERIFIED=PASS"
