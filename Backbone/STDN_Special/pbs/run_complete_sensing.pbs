#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=32GB,walltime=12:00:00,jobfs=10GB
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -N STDNComplete
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/Backbone/STDN_Special/logs/

set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/Backbone
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
INPUT_KEY=${INPUT_KEY:?Run probe first, then submit with INPUT_KEY=...}
FULL_KEY=${FULL_KEY:?Run probe first, then submit with FULL_KEY=...}
STAMP="stdn_diag_complete_$(date +%Y%m%d_%H%M%S)"
LOGDIR="$ROOT/STDN_Special/logs"
mkdir -p "$LOGDIR"
LIVE="$LOGDIR/${STAMP}.${PBS_JOBID}.live.log"
exec > >(awk '{ print strftime("[%Y-%m-%d %H:%M:%S]"), $0; fflush(); }' | tee -a "$LIVE") 2>&1

cd "$ROOT"
"$PY" -u scripts/verify_official_sources.py
"$PY" -u scripts/validate_cache.py --stage screening
"$PY" -u STDN_Special/audit_time_features.py --stage screening
"$PY" -u STDN_Special/run_complete_sensing.py \
  --input-key "$INPUT_KEY" \
  --full-key "$FULL_KEY" \
  --stage screening --seed 10 --run-stamp "$STAMP"
