#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
set -euo pipefail

TARGET=${TARGET:-${TRAFFIDENT_TARGET:-speed}}
SEED=${SEED:-10}
DATASET=${DATASET:-TraffiDent_Net_06}
ABLATION=${ABLATION:-full}
case "$TARGET" in speed|flow) ;; *) echo "ERROR TARGET=$TARGET (expected speed|flow)"; exit 2;; esac
[[ "$SEED" =~ ^[0-9]+$ ]] || { echo "ERROR SEED must be a nonnegative integer"; exit 2; }

ROOT=${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-$PWD}}
ENVROOT=${TFP_ENV_ROOT:-/scratch/mh20/zw1165/envs/TFP}
PYTHON="$ENVROOT/bin/python"
[[ -x "$PYTHON" ]] || { echo "ERROR Python not executable: $PYTHON"; exit 3; }

export SPEED_LLM_RAG_ROOT="$ROOT"
export TRAFFIDENT_TARGET="$TARGET"
export PYTHONUNBUFFERED=1
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$ROOT/Mask_RAFT-STLA:$ROOT/Base_SupportBench:${PYTHONPATH:-}"
export PATH="$ENVROOT/bin:$PATH"

cd "$ROOT"
mkdir -p "Mask_RAFT-STLA_logs/$TARGET"
STAMP=$(date +%Y%m%d_%H%M%S)
JOBID=${PBS_JOBID:-local}
LOG="Mask_RAFT-STLA_logs/$TARGET/Mask_RAFT-STLA.${TARGET}.formal.seed${SEED}.${JOBID}.${STAMP}.live.log"

# Prefix every line written to the main live log, including Python warnings/errors
# and multi-line external command output. This keeps one canonical timestamp format.
timestamp_stream() {
  awk '{ print strftime("[%Y-%m-%d %H:%M:%S]"), $0; fflush(); }'
}
log_line() {
  printf '%s\n' "$*" | timestamp_stream | tee -a "$LOG"
}
run_logged() {
  "$@" 2>&1 | timestamp_stream | tee -a "$LOG"
  local rc=${PIPESTATUS[0]}
  return "$rc"
}

log_line "START model=Mask_RAFT-STLA target=$TARGET seed=$SEED job=$JOBID host=$(hostname)"
log_line "ROOT=$ROOT PYTHON=$PYTHON"
run_logged "$PYTHON" -V
run_logged nvidia-smi || true

# Gadi gpuvolta allocation requires 12 CPUs per V100; keep ncpus=12.
GPU_LOG="${LOG%.live.log}.gpu.csv"
GPU_MON_PID=""
if command -v nvidia-smi >/dev/null 2>&1; then
  nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,utilization.memory,memory.used,memory.total,power.draw --format=csv -l 30 > "$GPU_LOG" 2>&1 &
  GPU_MON_PID=$!
fi
cleanup_gpu_monitor() {
  if [[ -n "${GPU_MON_PID:-}" ]]; then kill "$GPU_MON_PID" 2>/dev/null || true; wait "$GPU_MON_PID" 2>/dev/null || true; fi
}
trap cleanup_gpu_monitor EXIT

run_logged "$PYTHON" -u Mask_RAFT-STLA/scripts/preflight.py --target "$TARGET" --dataset "$DATASET"
log_line "PERF_CONFIG project=Mask_RAFT-STLA ncpus=12"
EXTRA_ARGS=()
if [[ -n "${RESUME_CHECKPOINT:-}" ]]; then EXTRA_ARGS+=(--resume "$RESUME_CHECKPOINT"); fi
if [[ -n "${BATCH_SIZE:-}" ]]; then EXTRA_ARGS+=(--batch-size "$BATCH_SIZE"); fi
run_logged "$PYTHON" -u Mask_RAFT-STLA/scripts/train.py --target "$TARGET" --seed "$SEED" --dataset "$DATASET" --ablation "$ABLATION" --run-stamp "$STAMP" "${EXTRA_ARGS[@]}"

log_line "FINISH model=Mask_RAFT-STLA target=$TARGET seed=$SEED"
