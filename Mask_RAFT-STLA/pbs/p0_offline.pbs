#!/bin/bash
#PBS -P mh20
#PBS -q normal
#PBS -l ncpus=12
#PBS -l mem=32GB
#PBS -l walltime=04:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
set -euo pipefail
# Find runtime helper from the submission working directory (PBS scripts can be spooled).
_RUNTIME=""
for _dir in "${SPEED_LLM_RAG_ROOT:-}" "${PBS_O_WORKDIR:-}" "${PWD:-}"; do
  [[ -n "$_dir" && -d "$_dir" ]] || continue
  _dir="$(cd "$_dir" && pwd -P)"
  while :; do
    if [[ -f "$_dir/Mask_RAFT-STLA/pbs/runtime.sh" ]]; then
      _RUNTIME="$_dir/Mask_RAFT-STLA/pbs/runtime.sh"; break 2
    fi
    [[ "$_dir" == / ]] && break
    _dir="$(dirname "$_dir")"
  done
done
[[ -n "$_RUNTIME" ]] || { echo 'ERROR: runtime.sh not found. Submit qsub from within repository tree or set SPEED_LLM_RAG_ROOT.' >&2; exit 2; }
source "$_RUNTIME"
: "${FULL_CHECKPOINT:?Set FULL_CHECKPOINT to FULL best.pt}"
[[ "$FULL_CHECKPOINT" = /* ]] || FULL_CHECKPOINT="$ROOT/$FULL_CHECKPOINT"
EXTRA=()
if [[ -n "${NO_RETRIEVAL_CHECKPOINT:-}" ]]; then
  [[ "$NO_RETRIEVAL_CHECKPOINT" = /* ]] || NO_RETRIEVAL_CHECKPOINT="$ROOT/$NO_RETRIEVAL_CHECKPOINT"
  EXTRA+=(--no-retrieval-checkpoint "$NO_RETRIEVAL_CHECKPOINT")
fi
exec "$PYTHON" -u Mask_RAFT-STLA/scripts/p0_diagnose.py \
  --checkpoint "$FULL_CHECKPOINT" --severities 20 40 60 90 "${EXTRA[@]}"
