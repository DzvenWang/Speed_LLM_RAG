#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=05:00:00
#PBS -l storage=gdata/mh20+scratch/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N PreQwenProbe
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development}; SEED=${SEED:-10}; MODEL_SIZE=${MODEL_SIZE:-0.5b}; MODE=${MODE:-lora}
source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "PreQwenProbe" "$STAGE" "${MODEL_SIZE}.${MODE}.seed${SEED}"
cd "$ROOT"
echo "START Qwen Support-Value Probe model=$MODEL_SIZE mode=$MODE $(date '+%F %T')"
"$PY" scripts/qwen_reasoning_preflight.py --stage "$STAGE"
"$PY" scripts/run_qwen_support_value_probe.py --stage "$STAGE" --seed "$SEED" --model-size "$MODEL_SIZE" --mode "$MODE"
echo "Qwen Support-Value Probe PASS model=$MODEL_SIZE mode=$MODE $(date '+%F %T')"
