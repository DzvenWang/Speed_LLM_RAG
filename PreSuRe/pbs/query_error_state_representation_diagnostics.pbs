#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l walltime=12:00:00
#PBS -l storage=gdata/mh20+scratch/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N QErrDiag
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development};SEED=${SEED:-10}
source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "QErrDiag" "$STAGE" "seed${SEED}"
presure_install_exit_trap
cd "$ROOT"
echo "================================================================================"
echo "START PreSuRe v0.9.5.1 Representation Diagnostics $(date '+%F %T')"
echo "PatchSTG: all-module hidden-layer sweep (parent blocks included), then Top-2 3-seed confirmation"
echo "Recent error: manifest window_start chronology; Train-only history for Validation features"
echo "Physical transition retained from v0.9.5"
echo "Layer / representation / representative-seed selection uses Train-dev only"
echo "Final Validation remains untouched until all selections are frozen"
echo "No retrieval/support candidates / Oracle choices / Qwen / Dual Memory are inputs"
echo "================================================================================"
"$PY" scripts/prepare_query_error_state_representation_diagnostics.py --stage "$STAGE"
"$PY" scripts/query_error_state_representation_diagnostics_preflight.py --stage "$STAGE"
"$PY" scripts/run_query_error_state_representation_diagnostics.py --stage "$STAGE" --seed "$SEED"
echo "================================================================================"
echo "PreSuRe v0.9.5.1 Representation Diagnostics PASS $(date '+%F %T')"
echo "================================================================================"
