#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=08:00:00
#PBS -l storage=gdata/mh20+scratch/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N QErrState
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development};SEED=${SEED:-10}
source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "QErrState" "$STAGE" "seed${SEED}"
presure_install_exit_trap
cd "$ROOT"
echo "========================================================================"
echo "START PreSuRe v0.9.5 Query Error-State Representation $(date '+%F %T')"
echo "Evidence: frozen PatchSTG hidden + causal recent backbone error + physical transition"
echo "Ablations selected on Train-dev only; Final Validation is evaluation-only"
echo "No retrieval/support candidates, Oracle choices, Qwen or Dual Memory are model inputs"
echo "========================================================================"
"$PY" scripts/prepare_query_error_state_artifacts.py --stage "$STAGE"
"$PY" scripts/query_error_state_preflight.py --stage "$STAGE"
"$PY" scripts/run_query_error_state_probe.py --stage "$STAGE" --seed "$SEED"
echo "========================================================================"
echo "PreSuRe v0.9.5 Query Error-State Representation PASS $(date '+%F %T')"
echo "========================================================================"
