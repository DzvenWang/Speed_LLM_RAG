#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=08:00:00
#PBS -l storage=gdata/mh20+scratch/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N PreUtilA1
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development}
SEED=${SEED:-10}
source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "PreUtilA1" "$STAGE" "seed${SEED}"
presure_install_exit_trap
cd "$ROOT"
echo "============================================================"
echo "START PreSuRe v0.9A.1 Safe Top-Selection $(date '+%F %T')"
echo "Warm-start: completed v0.9A Predictive-Utility Reranker"
echo "Same 24-candidate pool; no Dual Memory and no Qwen"
echo "New loss: listwise Top-1 + focal sign + absolute barrier + retained utility/hard ranking"
echo "Selection score: mu + lambda*beneficial_logit - beta*sigma"
echo "ABSTAIN threshold: calibrated on Train-dev with explicit coverage floor"
echo "============================================================"
"$PY" scripts/predictive_utility_safe_selection_preflight.py --stage "$STAGE"
"$PY" scripts/run_predictive_utility_safe_selection_probe.py --stage "$STAGE" --seed "$SEED"
echo "============================================================"
echo "PreSuRe v0.9A.1 Safe Top-Selection PASS $(date '+%F %T')"
echo "============================================================"
