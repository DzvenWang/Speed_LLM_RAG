#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l walltime=12:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -N PreSuReV12
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/

set -eo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
OUTROOT="$LOGROOT/out"
STAGE=${STAGE:-development}; SEED=${SEED:-10}
mkdir -p "$LOGROOT" "$OUTROOT"
STAMP="${LOG_STAMP:-$(date +%Y%m%d_%H%M%S)}"; JOB_ID="${PBS_JOBID:-manual}"; JOB_NUM="${JOB_ID%%.*}"
LIVE_LOG="$LOGROOT/PreSuReV12.${STAGE}.seed${SEED}.${STAMP}.${JOB_NUM}.gadi-pbs.live.log"
export PYTHONUNBUFFERED=1 PYTHONIOENCODING=UTF-8
exec > >(
  while IFS= read -r line || [[ -n "$line" ]]; do printf '[%(%Y-%m-%d %H:%M:%S)T] %s\n' -1 "$line"; done | tee -a "$LIVE_LOG"
) 2>&1

echo "LIVE_LOG=$LIVE_LOG"; echo "PBS_JOBID=$JOB_ID"; echo "LOG_STAMP=$STAMP"; echo "PBS_OU_DIR=$OUTROOT"
echo "================================================================================"
echo "START PreSuRe v1.2.1 Dual-Query Retrieval-Conditioned Forecasting"
echo "Dual Query -> K0=24 -> Top8 -> historical episode encoder -> support-set self-attention -> node-horizon cross-attention -> retrieval forecast -> adaptive mixture"
echo "Stage gate: Dev Masked MAE >=1.5% and Final >=1.0%; Final Validation locked until best Dev epoch frozen"
echo "================================================================================"
on_exit(){ status=$?; trap - EXIT; echo "================================================================================"; if [ "$status" -eq 0 ]; then echo "PreSuRe v1.2.1 PASS"; else echo "PreSuRe v1.2.1 FAIL"; fi; echo "SCRIPT_EXIT_STATUS=$status"; echo "LIVE_LOG=$LIVE_LOG"; echo "PBS_OU_DIR=$OUTROOT"; echo "================================================================================"; exit "$status"; }
trap on_exit EXIT
set +u
source ~/.bashrc
conda activate TFP
set -u
cd "$ROOT"
python tests/smoke_v12.py
python scripts/preflight.py --stage "$STAGE"
bash scripts/run_v12_pipeline.sh "$STAGE"
