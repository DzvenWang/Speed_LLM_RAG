#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=04:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
# Build the shared ReShift-STLA v0.2 caches of one target once.  Required: TARGET, BACKBONE_CHECKPOINT.
set -euo pipefail
ROOT="${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-}}"
[[ -d "$ROOT/ReShift-STLA" ]] || { echo 'Missing ReShift-STLA under SPEED_LLM_RAG_ROOT'; exit 2; }
cd "$ROOT"; source ReShift-STLA/pbs/reshift/runtime.sh
: "${TARGET:?TARGET required}"; : "${BACKBONE_CHECKPOINT:?BACKBONE_CHECKPOINT required}"
export TRAFFIDENT_TARGET="$TARGET" BACKBONE_MODE="${BACKBONE_MODE:-incomplete}"
LOGDIR="$ROOT/ReShift_v2_logs/$TARGET/$BACKBONE_MODE"; mkdir -p "$LOGDIR"
LOG="$LOGDIR/ReShift2.prepare.${TARGET}.${DATASET:-TraffiDent_Net_06}.${PBS_JOBID:-local}.live.log"
set +e
"$PYTHON" -u ReShift-STLA/scripts/reshift2/prepare.py --target "$TARGET" --dataset "${DATASET:-TraffiDent_Net_06}" \
  --backbone-checkpoint "$BACKBONE_CHECKPOINT" 2>&1 | "$PYTHON" -u ReShift-STLA/scripts/timestamp_filter.py | tee -a "$LOG"
code=${PIPESTATUS[0]}; set -e; exit "$code"
