#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
set -euo pipefail
ROOT="${SPEED_LLM_RAG_ROOT:-${PBS_O_WORKDIR:-}}"
[[ -d "$ROOT/CoRSTA" ]] || { echo 'Missing project root'; exit 2; }
cd "$ROOT"
source CoRSTA/pbs/runtime.sh
: "${TARGET:?TARGET required}"
: "${BACKBONE_CHECKPOINT:?BACKBONE_CHECKPOINT required}"
: "${MASK_PROJ_CHECKPOINT:?MASK_PROJ_CHECKPOINT required}"
DATASET="${DATASET:-TraffiDent_Net_06}"
SEED="${SEED:-10}"
STAGE="${CORSTA_V2_STAGE:-train}"
CORSTA_V2_CONFIG="${CORSTA_V2_CONFIG:-$ROOT/CoRSTA/configs/v0_2/corsta_v023.yaml}"
LOGDIR="$ROOT/CoRSTA_v023_logs/$TARGET/${BACKBONE_MODE:-incomplete}"
mkdir -p "$LOGDIR"
LOG="$LOGDIR/CoRSTA_v023.${TARGET}.${DATASET}.seed${SEED}.${PBS_JOBID:-local}.live.log"
args=(--stage "$STAGE" --target "$TARGET" --dataset "$DATASET" --seed "$SEED"
 --backbone-checkpoint "$BACKBONE_CHECKPOINT" --mask-proj-checkpoint "$MASK_PROJ_CHECKPOINT")
[[ -z "${RUN_DIR:-}" ]] || args+=(--run-dir "$RUN_DIR")
[[ -z "${CORSTA_V2_CONFIG:-}" ]] || args+=(--config "$CORSTA_V2_CONFIG")
[[ -z "${PREDICTION_MODE:-}" ]] || args+=(--prediction-mode "$PREDICTION_MODE")
[[ -z "${CF_GRAPH_PATH:-}" ]] || args+=(--cf-graph-path "$CF_GRAPH_PATH")
[[ -z "${BATCH_INITIAL:-}" ]] || args+=(--batch-initial "$BATCH_INITIAL")
[[ -z "${TRAIN_WORKERS:-}" ]] || args+=(--workers "$TRAIN_WORKERS")
set +e
"$PYTHON" -u CoRSTA/scripts/v0_2/run.py "${args[@]}" 2>&1 | "$PYTHON" -u CoRSTA/scripts/timestamp_filter.py | tee -a "$LOG"
status=("${PIPESTATUS[@]}")
set -e
for code in "${status[@]}"; do
  if [[ "$code" -ne 0 ]]; then
    printf '[%s] CORSTA_V2_PBS_FAILED code=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$code" | tee -a "$LOG"
    exit "$code"
  fi
done
printf '[%s] CORSTA_V2_PBS_PASS\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" | tee -a "$LOG"
