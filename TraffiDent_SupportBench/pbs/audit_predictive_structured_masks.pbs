#!/bin/bash
#PBS -P mh20
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=24GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/mh20
#PBS -j oe
#PBS -N PredMaskAudit

set -euo pipefail

PROJECT_ROOT="/scratch/mh20/zw1165/Speed_LLM_RAG"
PROCESS_ROOT="$PROJECT_ROOT/TraffiDent_SupportBench"
CONDA_BASE="/scratch/mh20/zw1165/miniconda"
CONDA_ENV="/scratch/mh20/zw1165/envs/TFP"

SUBGRAPH="${SUBGRAPH:-TraffiDent_Net_06}"
SPLIT="${SPLIT:-val}"                 # val or test
BUDGET="${BUDGET:-development}"      # development or full
DISTRIBUTION="${DISTRIBUTION:-id}"   # id, ood, all
SEVERITY="${SEVERITY:-0.40}"
MAX_GROUPS="${MAX_GROUPS:-512}"
RATIO_TARGET="${RATIO_TARGET:-1.05}"
STRICT="${STRICT:-0}"

ART="$PROJECT_ROOT/artifacts/supportbench/$SUBGRAPH"
FEATURES="$ART/${SPLIT}_support_features_v2.csv"
OUT="$ART/audits/predictive_structured_${SPLIT}_${DISTRIBUTION}_s${SEVERITY}"

cd "$PROCESS_ROOT"
set +u
source "$CONDA_BASE/etc/profile.d/conda.sh"
conda activate "$CONDA_ENV"
set -u
export PYTHONPATH="$PROCESS_ROOT:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${PBS_NCPUS:-4}"
export MKL_NUM_THREADS="${PBS_NCPUS:-4}"

mkdir -p "$OUT" "$PROCESS_ROOT/logs"
LIVE_LOG="$PROCESS_ROOT/logs/PredMaskAudit.${PBS_JOBID:-manual}.live.log"
: > "$LIVE_LOG"
exec > >(python -u "$PROCESS_ROOT/timestamp_stream.py" | tee -a "$LIVE_LOG") 2>&1
trap 'rc=$?; echo "PredMaskAudit exiting rc=$rc"; echo "LIVE_LOG=$LIVE_LOG"' EXIT

[[ -s derived/audit_predictive_structured_masks.py ]] || { echo "missing derived/audit_predictive_structured_masks.py" >&2; exit 2; }

ARGS=(
  --output-dir "$OUT"
  --subgraph "$SUBGRAPH"
  --split "$SPLIT"
  --budget "$BUDGET"
  --distribution "$DISTRIBUTION"
  --severity "$SEVERITY"
  --max-groups "$MAX_GROUPS"
  --context-ratio-target "$RATIO_TARGET"
)

# Existing Stage-A CSV is optional and is used only as a semantic consistency
# cross-check. OOD auditing works directly from canonical views even if the CSV
# contains ID rows only.
if [[ -s "$FEATURES" ]]; then
  ARGS+=(--features "$FEATURES")
fi
if [[ "$STRICT" == "1" ]]; then
  ARGS+=(--strict)
fi

python -u derived/audit_predictive_structured_masks.py "${ARGS[@]}"

echo "RESULT_FILES:"
find "$OUT" -maxdepth 1 -type f -printf '%f\t%s bytes\n' | sort
echo "AUDIT_DIR=$OUT"
