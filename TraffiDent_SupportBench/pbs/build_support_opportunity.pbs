#!/bin/bash
#PBS -P mh20
#PBS -q normal
#PBS -l ncpus=8
#PBS -l mem=16GB
#PBS -l walltime=12:00:00
#PBS -l storage=scratch/mh20
#PBS -j oe
#PBS -N SupportOpportunity

# Build Validation/Test candidate pools and a future-free Support Opportunity
# challenge. Validation fits every calibration threshold; Test only applies the
# frozen Validation calibrator.
set -euo pipefail

PROJECT_ROOT="/scratch/mh20/zw1165/Speed_LLM_RAG"
PROCESS_ROOT="$PROJECT_ROOT/TraffiDent_SupportBench"
CONDA_BASE="/scratch/mh20/zw1165/miniconda"
CONDA_ENV="/scratch/mh20/zw1165/envs/TFP"

# Can be overridden at submission time, e.g.
# qsub -v SUBGRAPH=TraffiDent_Net_01 pbs/build_support_opportunity.pbs
SUBGRAPH="${SUBGRAPH:-TraffiDent_Net_06}"
BUDGET="${BUDGET:-development}"
MEMORY_BUDGET="${MEMORY_BUDGET:-development}"
K="${K:-64}"

DATA="$PROJECT_ROOT/data/processed/traffident/supportbench/$SUBGRAPH"
ART="$PROJECT_ROOT/artifacts/supportbench/$SUBGRAPH"
VAL_PROTOCOL="$DATA/protocols/resolved/challenge_val_${BUDGET}.csv"
TEST_PROTOCOL="$DATA/protocols/resolved/challenge_test_${BUDGET}.csv"

VAL_POOL="$ART/val_challenge_pool.npz"
TEST_POOL="$ART/test_challenge_pool.npz"
VAL_SO="$ART/val_support_opportunity.csv"
TEST_SO="$ART/test_support_opportunity.csv"
VAL_CAL="$ART/val_support_opportunity.calibrator.json"
VAL_COMP="$ART/val_support_opportunity__family_composition.json"
TEST_COMP="$ART/test_support_opportunity__family_composition.json"

cd "$PROCESS_ROOT"

if [[ ! -f "$CONDA_BASE/etc/profile.d/conda.sh" ]]; then
    echo "ERROR: conda initialization script not found: $CONDA_BASE/etc/profile.d/conda.sh" >&2
    exit 2
fi
if [[ ! -x "$CONDA_ENV/bin/python" ]]; then
    echo "ERROR: TFP Python not found: $CONDA_ENV/bin/python" >&2
    exit 2
fi
if [[ ! -f "$VAL_PROTOCOL" ]]; then
    echo "ERROR: Validation challenge protocol not found: $VAL_PROTOCOL" >&2
    exit 3
fi
if [[ ! -f "$TEST_PROTOCOL" ]]; then
    echo "ERROR: Test challenge protocol not found: $TEST_PROTOCOL" >&2
    exit 3
fi

set +u
source "$CONDA_BASE/etc/profile.d/conda.sh"
conda activate "$CONDA_ENV"
set -u

# Required for imports such as: from supportbench.config import load_config
export PYTHONPATH="$PROCESS_ROOT:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${PBS_NCPUS:-8}"
export MKL_NUM_THREADS="${PBS_NCPUS:-8}"
export OPENBLAS_NUM_THREADS="${PBS_NCPUS:-8}"
export NUMEXPR_NUM_THREADS="${PBS_NCPUS:-8}"

mkdir -p "$ART" "$PROCESS_ROOT/logs"

JOB_TOKEN="${PBS_JOBID:-manual}"
LIVE_LOG="$PROCESS_ROOT/logs/SupportOpportunity.${JOB_TOKEN}.live.log"
: > "$LIVE_LOG"

# Reuse the project's timestamped live-log helper.
exec > >(python -u "$PROCESS_ROOT/timestamp_stream.py" | tee -a "$LIVE_LOG") 2>&1

on_exit() {
    rc=$?
    echo "============================================================"
    echo "Support Opportunity PBS exiting rc=${rc}"
    echo "LIVE_LOG=${LIVE_LOG}"
    echo "============================================================"
}
trap on_exit EXIT

stage() {
    echo
    echo "============================================================"
    echo "$1"
    echo "============================================================"
}

stage "Support Opportunity build: environment"
echo "PBS_JOBID=${PBS_JOBID:-unknown}"
echo "host=$(hostname)"
echo "workdir=$PROCESS_ROOT"
echo "subgraph=$SUBGRAPH"
echo "budget=$BUDGET"
echo "memory_budget=$MEMORY_BUDGET"
echo "candidate_k=$K"
echo "ncpus=${PBS_NCPUS:-8}"
echo "conda_prefix=${CONDA_PREFIX:-N/A}"
echo "python=$(command -v python)"
python --version
python - <<'PY'
import supportbench
print("supportbench import PASS:", supportbench.__file__)
PY

stage "STAGE 01/04: Build Validation candidate pool"
python -u derived/build_candidate_pool.py \
  --subgraph "$SUBGRAPH" \
  --views-file "$VAL_PROTOCOL" \
  --budget "$BUDGET" \
  --memory-budget "$MEMORY_BUDGET" \
  --k "$K" \
  --output "$VAL_POOL"

[[ -s "$VAL_POOL" ]] || { echo "ERROR: missing/empty $VAL_POOL" >&2; exit 4; }

stage "STAGE 02/04: Build Test candidate pool"
# The Validation stage creates/reuses the multi-view Train-memory feature cache;
# Test should therefore reuse exactly the same Train-memory representation.
python -u derived/build_candidate_pool.py \
  --subgraph "$SUBGRAPH" \
  --views-file "$TEST_PROTOCOL" \
  --budget "$BUDGET" \
  --memory-budget "$MEMORY_BUDGET" \
  --k "$K" \
  --output "$TEST_POOL"

[[ -s "$TEST_POOL" ]] || { echo "ERROR: missing/empty $TEST_POOL" >&2; exit 4; }

stage "STAGE 03/04: Fit Validation Support Opportunity calibrator"
python -u derived/build_support_opportunity.py \
  --subgraph "$SUBGRAPH" \
  --candidate-pool "$VAL_POOL" \
  --fit-calibrator \
  --output "$VAL_SO"

[[ -s "$VAL_SO" ]] || { echo "ERROR: missing/empty $VAL_SO" >&2; exit 5; }
[[ -s "$VAL_CAL" ]] || { echo "ERROR: missing/empty $VAL_CAL" >&2; exit 5; }
[[ -s "$VAL_COMP" ]] || { echo "ERROR: missing/empty $VAL_COMP" >&2; exit 5; }

stage "STAGE 04/04: Apply frozen Validation calibrator to Test"
python -u derived/build_support_opportunity.py \
  --subgraph "$SUBGRAPH" \
  --candidate-pool "$TEST_POOL" \
  --calibrator "$VAL_CAL" \
  --output "$TEST_SO"

[[ -s "$TEST_SO" ]] || { echo "ERROR: missing/empty $TEST_SO" >&2; exit 6; }
[[ -s "$TEST_COMP" ]] || { echo "ERROR: missing/empty $TEST_COMP" >&2; exit 6; }

stage "Support Opportunity summary"
python - "$VAL_SO" "$TEST_SO" "$VAL_CAL" "$VAL_COMP" "$TEST_COMP" <<'PY'
import json
import sys
from pathlib import Path
import pandas as pd

val_so, test_so, cal_path, val_comp_path, test_comp_path = map(Path, sys.argv[1:])

for name, path in [("Validation", val_so), ("Test", test_so)]:
    df = pd.read_csv(path)
    counts = df["opportunity_group"].value_counts().reindex(["low", "medium", "high"], fill_value=0)
    rates = counts / max(len(df), 1)
    print(f"{name}: queries={len(df):,}")
    print("  group_counts:", {k: int(v) for k, v in counts.items()})
    print("  group_rates :", {k: round(float(v), 4) for k, v in rates.items()})
    print(f"  SO mean/std : {df['support_opportunity'].mean():.6f} / {df['support_opportunity'].std():.6f}")

cal = json.loads(cal_path.read_text())
print("Validation calibrator:")
print("  fitted_split=", cal.get("fitted_split"))
print("  future_free=", cal.get("future_free"))
print("  low_threshold=", cal.get("opportunity_low_threshold"))
print("  high_threshold=", cal.get("opportunity_high_threshold"))

for name, path in [("Validation", val_comp_path), ("Test", test_comp_path)]:
    comp = json.loads(path.read_text())
    hc = comp.get("high_composition", {})
    wr = comp.get("within_family_high_rate", {})
    max_family = max(hc, key=hc.get) if hc else None
    max_fraction = hc.get(max_family, 0.0) if max_family is not None else 0.0
    print(f"{name} High-SO family composition:")
    print("  high_composition=", {k: round(float(v), 4) for k, v in hc.items()})
    print("  within_family_high_rate=", {k: round(float(v), 4) for k, v in wr.items()})
    print(f"  max_family={max_family}, fraction={max_fraction:.4f}")
PY

stage "Support Opportunity build completed"
echo "VAL_POOL=$VAL_POOL"
echo "TEST_POOL=$TEST_POOL"
echo "VAL_SO=$VAL_SO"
echo "VAL_CAL=$VAL_CAL"
echo "VAL_COMP=$VAL_COMP"
echo "TEST_SO=$TEST_SO"
echo "TEST_COMP=$TEST_COMP"
echo "RESULT=PASS"
