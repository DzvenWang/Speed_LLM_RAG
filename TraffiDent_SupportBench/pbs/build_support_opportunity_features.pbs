#!/bin/bash
#PBS -P mh20
#PBS -q normal
#PBS -l ncpus=8
#PBS -l mem=16GB
#PBS -l walltime=06:00:00
#PBS -l storage=scratch/mh20
#PBS -j oe
#PBS -N SOFeaturesV2

set -euo pipefail
PROJECT_ROOT="/scratch/mh20/zw1165/Speed_LLM_RAG"
PROCESS_ROOT="$PROJECT_ROOT/TraffiDent_SupportBench"
CONDA_BASE="/scratch/mh20/zw1165/miniconda"
CONDA_ENV="/scratch/mh20/zw1165/envs/TFP"
SUBGRAPH="${SUBGRAPH:-TraffiDent_Net_06}"
BUDGET="${BUDGET:-development}"
MEMORY_BUDGET="${MEMORY_BUDGET:-development}"
K="${K:-64}"
REBUILD_POOL="${REBUILD_POOL:-0}"

DATA="$PROJECT_ROOT/data/processed/traffident/supportbench/$SUBGRAPH"
ART="$PROJECT_ROOT/artifacts/supportbench/$SUBGRAPH"
VAL_PROTOCOL="$DATA/protocols/resolved/challenge_val_${BUDGET}.csv"
TEST_PROTOCOL="$DATA/protocols/resolved/challenge_test_${BUDGET}.csv"
VAL_POOL="$ART/val_challenge_pool.npz"
TEST_POOL="$ART/test_challenge_pool.npz"
VAL_FEAT="$ART/val_support_features_v2.csv"
TEST_FEAT="$ART/test_support_features_v2.csv"
VAL_CAL="$ART/val_support_features_v2.calibrator.json"

cd "$PROCESS_ROOT"
set +u
source "$CONDA_BASE/etc/profile.d/conda.sh"
conda activate "$CONDA_ENV"
set -u
export PYTHONPATH="$PROCESS_ROOT:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${PBS_NCPUS:-8}"
export MKL_NUM_THREADS="${PBS_NCPUS:-8}"
mkdir -p "$ART" "$PROCESS_ROOT/logs"
LIVE_LOG="$PROCESS_ROOT/logs/SOFeaturesV2.${PBS_JOBID:-manual}.live.log"
: > "$LIVE_LOG"
exec > >(python -u "$PROCESS_ROOT/timestamp_stream.py" | tee -a "$LIVE_LOG") 2>&1
trap 'rc=$?; echo "SOFeaturesV2 exiting rc=$rc"; echo "LIVE_LOG=$LIVE_LOG"' EXIT

if [[ "$REBUILD_POOL" == "1" || ! -s "$VAL_POOL" ]]; then
  python -u derived/build_candidate_pool.py --subgraph "$SUBGRAPH" --views-file "$VAL_PROTOCOL" \
    --budget "$BUDGET" --memory-budget "$MEMORY_BUDGET" --k "$K" --output "$VAL_POOL"
else
  echo "Reuse existing Validation pool: $VAL_POOL"
fi
if [[ "$REBUILD_POOL" == "1" || ! -s "$TEST_POOL" ]]; then
  python -u derived/build_candidate_pool.py --subgraph "$SUBGRAPH" --views-file "$TEST_PROTOCOL" \
    --budget "$BUDGET" --memory-budget "$MEMORY_BUDGET" --k "$K" --output "$TEST_POOL"
else
  echo "Reuse existing Test pool: $TEST_POOL"
fi

python -u derived/build_support_opportunity_features.py \
  --subgraph "$SUBGRAPH" --candidate-pool "$VAL_POOL" --fit-calibrator --output "$VAL_FEAT"
[[ -s "$VAL_CAL" ]] || { echo "missing $VAL_CAL" >&2; exit 4; }
python -u derived/build_support_opportunity_features.py \
  --subgraph "$SUBGRAPH" --candidate-pool "$TEST_POOL" --calibrator "$VAL_CAL" --output "$TEST_FEAT"

python - "$VAL_FEAT" "$TEST_FEAT" <<'PY'
import sys, pandas as pd
for name,p in [('Val',sys.argv[1]),('Test',sys.argv[2])]:
    d=pd.read_csv(p)
    print(name, 'queries=',len(d))
    for c in ['predictive_context_percentile','support_scope','memory_coverage_percentile','retrieval_difficulty','context_scope_interaction']:
        print(' ',c,'mean/std=',round(d[c].mean(),5),round(d[c].std(),5))
    print(' by-family scope=',d.groupby('family')['support_scope'].mean().round(4).to_dict())
PY

echo "RESULT=PASS"
echo "VAL_FEATURES=$VAL_FEAT"
echo "TEST_FEATURES=$TEST_FEAT"
echo "VAL_FEATURE_CALIBRATOR=$VAL_CAL"
