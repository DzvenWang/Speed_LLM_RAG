#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l walltime=01:30:00
#PBS -l mem=48GB
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N PreNeedGate
set -euo pipefail

ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development}
SEED=${SEED:-10}

source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "PreNeedGate" "$STAGE" "seed${SEED}"
trap 'rc=$?; echo "SCRIPT_EXIT_STATUS=$rc"; exit $rc' EXIT

cd "$ROOT"
echo "============================================================"
echo "START Need-Gated Utility Probe $(date '+%F %T')"
echo "Reuse v0.7.1 Utility-A + v0.7.2 Need-q90; no model retraining"
echo "Diagnostics: all/top50/top20/top10/top5 Need -> Utility-A ranking"
echo "Train-only policy calibration -> fixed Validation correction policy"
echo "============================================================"

"$PY" scripts/need_gated_probe_preflight.py --stage "$STAGE"
"$PY" scripts/run_need_gated_utility_probe.py --stage "$STAGE" --seed "$SEED"

echo "============================================================"
echo "Need-Gated Utility Probe PASS $(date '+%F %T')"
echo "============================================================"
