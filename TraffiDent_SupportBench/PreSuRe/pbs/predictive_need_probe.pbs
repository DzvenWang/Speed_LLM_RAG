#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=12:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N PreNeedProbe
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development}
SEED=${SEED:-10}
source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "PreNeedProbe" "$STAGE" "seed${SEED}"
presure_install_exit_trap
export PYTHONPATH="$ROOT:/scratch/mh20/zw1165/Speed_LLM_RAG/Backbone:/scratch/mh20/zw1165/Speed_LLM_RAG/ExperimentCommon:/scratch/mh20/zw1165/Speed_LLM_RAG/TraffiDent_SupportBench:${PYTHONPATH:-}"
cd "$ROOT"
echo "============================================================"
echo "START Predictive Need + Support Utility Probe $(date '+%F %T')"
echo "Reuse v0.7 artifacts/M1/M3; no Oracle A-F and no M0-M5 rerun"
echo "A=query+support; B=A+predicted need; C=A+true need privileged diagnostic"
echo "============================================================"
"$PY" scripts/probe_preflight.py --stage "$STAGE"
"$PY" scripts/run_predictive_need_probe.py --stage "$STAGE" --seed "$SEED"
echo "============================================================"
echo "Predictive Need Probe PASS $(date '+%F %T')"
echo "============================================================"
