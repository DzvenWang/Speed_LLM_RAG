#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=02:00:00
#PBS -l storage=gdata/mh20+scratch/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N PreProposalMeta
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development}
SEED=${SEED:-10}
source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "PreProposalMeta" "$STAGE" "seed${SEED}"
cd "$ROOT"
echo "============================================================"
echo "START Regret-Aware Support Proposal Meta-Ranking Probe $(date '+%F %T')"
echo "Experts: frozen Generic / Hard-q90 / Pred10 / Pred20"
echo "Each expert contributes one Top1 support proposal; duplicates are merged"
echo "Meta objective: proposal utility + pairwise ranking + beneficial/harmful + expected regret"
echo "Validation future and Oracle Proposal are diagnostics only"
echo "============================================================"
"$PY" scripts/proposal_meta_ranker_preflight.py --stage "$STAGE"
"$PY" scripts/run_regret_aware_support_proposal_meta_probe.py --stage "$STAGE" --seed "$SEED"
echo "============================================================"
echo "Regret-Aware Support Proposal Meta-Ranking Probe PASS $(date '+%F %T')"
echo "============================================================"
