#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l walltime=08:00:00
#PBS -l storage=gdata/mh20+scratch/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N PreQwenTrain
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development}; SEED=${SEED:-10}; MODEL_SIZE=${MODEL_SIZE:-0.5b}
source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "PreQwenTrain" "$STAGE" "${MODEL_SIZE}.seed${SEED}"
cd "$ROOT"
echo "START Qwen Support-Value LoRA SFT model=$MODEL_SIZE $(date '+%F %T')"
"$PY" scripts/qwen_reasoning_preflight.py --stage "$STAGE"
"$PY" scripts/train_qwen_support_value_reasoner.py --stage "$STAGE" --seed "$SEED" --model-size "$MODEL_SIZE"
echo "Qwen Support-Value LoRA SFT PASS model=$MODEL_SIZE $(date '+%F %T')"
