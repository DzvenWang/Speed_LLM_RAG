#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N PreFullPipe
set -euo pipefail

ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development}
SEED=${SEED:-10}

source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "PreFullPipe" "$STAGE" "seed${SEED}"
presure_install_exit_trap

export PYTHONPATH="$ROOT:/scratch/mh20/zw1165/Speed_LLM_RAG/Backbone:/scratch/mh20/zw1165/Speed_LLM_RAG/ExperimentCommon:/scratch/mh20/zw1165/Speed_LLM_RAG/TraffiDent_SupportBench:${PYTHONPATH:-}"
cd "$ROOT"

banner() {
  echo
  echo "============================================================"
  echo "$1 $(date '+%F %T')"
  echo "============================================================"
}

banner "START PreSuRe Single-GPU Full Pipeline stage=$STAGE seed=$SEED"
echo "One PBS allocation / one V100 for the entire pipeline"
echo "Order: preflight -> backbone artifacts -> retrieval/node features -> base Oracles + E24 -> M0/M1/M2/M3 -> M3-Top4 diagnostics + SoftMix diagnostic -> pairwise M4 compatibility learning -> continuous M5 gate -> summary"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-<unset>}"
nvidia-smi

banner "PHASE 0/7 PREFLIGHT"
"$PY" scripts/preflight.py --stage "$STAGE"
echo "PASS PHASE 0/7 PREFLIGHT"

banner "PHASE 1/7 PREPARE BACKBONE ARTIFACTS"
"$PY" scripts/prepare_backbone_artifacts.py --stage "$STAGE"
echo "PASS PHASE 1/7 PREPARE BACKBONE ARTIFACTS"

banner "PHASE 2/7 BUILD RETRIEVAL + SENSING-CONDITIONED NODE FEATURES"
"$PY" scripts/build_retrieval_candidates.py --stage "$STAGE"
echo "PASS PHASE 2/7 BUILD RETRIEVAL + NODE FEATURES"

banner "PHASE 3/7 BASE ORACLE DIAGNOSTICS A->B->C->E->F->D + E24"
for ORACLE_TYPE in A B C E F D; do
  banner "START Oracle-${ORACLE_TYPE}"
  "$PY" scripts/run_oracle.py \
    --stage "$STAGE" \
    --seed "$SEED" \
    --oracle-type "$ORACLE_TYPE"
  echo "PASS Oracle-${ORACLE_TYPE} $(date '+%F %T')"
done
"$PY" scripts/run_local_diagnostics.py --stage "$STAGE" --seed "$SEED" --diagnostic E24
echo "PASS PHASE 3/7 BASE ORACLE DIAGNOSTICS"

banner "PHASE 4/7 NUMERICAL VARIANTS M0->M1->M2->M3"
for VARIANT in M0 M1 M2 M3; do
  banner "START ${VARIANT}"
  "$PY" scripts/run_variant.py --variant "$VARIANT" --stage "$STAGE" --seed "$SEED"
  echo "PASS ${VARIANT} $(date '+%F %T')"
done
echo "PASS PHASE 4/7 M0-M3"

banner "PHASE 5/7 POST-M3 LOCAL SUPPORT + SOFT-MIX DIAGNOSTICS"
"$PY" scripts/run_local_diagnostics.py --stage "$STAGE" --seed "$SEED" --diagnostic E_M3TOP4
"$PY" scripts/run_local_diagnostics.py --stage "$STAGE" --seed "$SEED" --diagnostic D_M3TOP4
"$PY" scripts/run_local_diagnostics.py --stage "$STAGE" --seed "$SEED" --diagnostic SOFTMIX_M3TOP4
echo "PASS PHASE 5/7 POST-M3 DIAGNOSTICS"

banner "PHASE 6/7 PAIRWISE SUPPORT COMPATIBILITY M4 -> CONTINUOUS SAFE GATE M5"
for VARIANT in M4 M5; do
  banner "START ${VARIANT}"
  "$PY" scripts/run_variant.py --variant "$VARIANT" --stage "$STAGE" --seed "$SEED"
  echo "PASS ${VARIANT} $(date '+%F %T')"
done
echo "PASS PHASE 6/7 M4-M5"

banner "PHASE 7/7 SUMMARIZE"
"$PY" scripts/summarize.py --stage "$STAGE"
echo "PASS PHASE 7/7 SUMMARIZE"

banner "PreSuRe Single-GPU Full Pipeline PASS"
echo "All phases completed in one PBS job and one V100 allocation."
nvidia-smi
