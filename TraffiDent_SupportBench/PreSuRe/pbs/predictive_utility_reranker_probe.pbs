#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=08:00:00
#PBS -l storage=gdata/mh20+scratch/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N PreUtility09A
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development}
SEED=${SEED:-10}
source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "PreUtility09A" "$STAGE" "seed${SEED}"
presure_install_exit_trap
cd "$ROOT"
echo "============================================================"
echo "START PreSuRe v0.9A Predictive-Utility Retrieval $(date '+%F %T')"
echo "Same 24-candidate pool; legacy M3 Top-4 compression disabled"
echo "Target: node-horizon best-alpha relative predictive utility"
echo "Loss: heteroscedastic utility + pairwise rank + benefit + similar-but-harmful negatives"
echo "Risk score: mu - beta*sigma; beta calibrated on Train-dev only"
echo "Qwen / Dual Memory are intentionally not part of v0.9A"
echo "============================================================"
"$PY" scripts/predictive_utility_reranker_preflight.py --stage "$STAGE"
"$PY" scripts/run_predictive_utility_reranker_probe.py --stage "$STAGE" --seed "$SEED"
echo "============================================================"
echo "PreSuRe v0.9A Predictive-Utility Retrieval PASS $(date '+%F %T')"
echo "============================================================"
