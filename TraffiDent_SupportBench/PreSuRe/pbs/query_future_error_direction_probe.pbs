#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=06:00:00
#PBS -l storage=gdata/mh20+scratch/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N QErrDir
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development}
SEED=${SEED:-10}
source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "QErrDir" "$STAGE" "seed${SEED}"
presure_install_exit_trap
cd "$ROOT"
echo "===================================================================="
echo "START PreSuRe v0.9.4 Query Future-Error Direction Probe $(date '+%F %T')"
echo "Query-only diagnostic; no support candidates / no Qwen / no Dual Memory"
echo "Target: signed future PatchSTG error E*=Y_future-Y_base"
echo "Direction: positive = PatchSTG underprediction / positive correction demand"
echo "Exact v0.9A train/dev/final-val IDs are reused"
echo "===================================================================="
"$PY" scripts/query_future_error_direction_preflight.py --stage "$STAGE"
"$PY" scripts/run_query_future_error_direction_probe.py --stage "$STAGE" --seed "$SEED"
echo "===================================================================="
echo "PreSuRe v0.9.4 Query Future-Error Direction Probe PASS $(date '+%F %T')"
echo "===================================================================="
