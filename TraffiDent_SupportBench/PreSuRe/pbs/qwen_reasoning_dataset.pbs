#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=03:00:00
#PBS -l storage=gdata/mh20+scratch/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N PreQwenData
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development}; SEED=${SEED:-10}
source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "PreQwenData" "$STAGE" "seed${SEED}"
cd "$ROOT"
echo "START Qwen Support-Value Reasoning Dataset $(date '+%F %T')"
"$PY" scripts/qwen_reasoning_preflight.py --stage "$STAGE"
"$PY" scripts/build_qwen_reasoning_dataset.py --stage "$STAGE" --seed "$SEED"
echo "Qwen Support-Value Reasoning Dataset PASS $(date '+%F %T')"
