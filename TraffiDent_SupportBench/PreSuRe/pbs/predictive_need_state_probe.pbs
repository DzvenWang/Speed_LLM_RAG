#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l walltime=02:30:00
#PBS -l mem=48GB
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N PreNeedState
set -euo pipefail

ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development}
SEED=${SEED:-10}

source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "PreNeedState" "$STAGE" "seed${SEED}"
trap 'rc=$?; echo "SCRIPT_EXIT_STATUS=$rc"; exit $rc' EXIT

cd "$ROOT"
echo "============================================================"
echo "START Predictive Need State Probe $(date '+%F %T')"
echo "Exact-residual route retained only as v0.7.1 reference; no exact residual model rerun"
echo "Tasks: Need q75/q90 -> Direction q75/q90 -> Magnitude-3 -> Signed-State -> State-conditioned Top4 utility"
echo "All thresholds are Train-only and horizon-specific; Validation future is diagnostic only"
echo "============================================================"

"$PY" scripts/state_probe_preflight.py --stage "$STAGE"
"$PY" scripts/run_predictive_need_state_probe.py --stage "$STAGE" --seed "$SEED"

echo "============================================================"
echo "Predictive Need State Probe PASS $(date '+%F %T')"
echo "============================================================"
