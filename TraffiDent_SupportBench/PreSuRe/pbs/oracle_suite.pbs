#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N PreOracleSuite
set -euo pipefail

ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development}
SEED=${SEED:-10}

source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "PreOracleSuite" "$STAGE" "seed${SEED}"
presure_install_exit_trap
export PYTHONPATH="$ROOT:/scratch/mh20/zw1165/Speed_LLM_RAG/Backbone:/scratch/mh20/zw1165/Speed_LLM_RAG/ExperimentCommon:/scratch/mh20/zw1165/Speed_LLM_RAG/TraffiDent_SupportBench:${PYTHONPATH:-}"
cd "$ROOT"

echo "============================================================"
echo "START PreOracleSuite stage=$STAGE seed=$SEED"
echo "One PBS allocation / one V100; Oracle order: A B C E F D"
echo "============================================================"
nvidia-smi

for ORACLE_TYPE in A B C E F D; do
  echo
  echo "============================================================"
  echo "START Oracle-${ORACLE_TYPE} $(date '+%F %T')"
  echo "============================================================"
  "$PY" scripts/run_oracle.py \
    --stage "$STAGE" \
    --seed "$SEED" \
    --oracle-type "$ORACLE_TYPE"
  echo "PASS Oracle-${ORACLE_TYPE} $(date '+%F %T')"
done

echo "============================================================"
echo "PreOracleSuite PASS: A B C E F D completed on the same GPU allocation"
echo "============================================================"
