#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/mh20+gdata/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N PreVariantSuite
set -euo pipefail

ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development}
SEED=${SEED:-10}
VARIANT_START=${VARIANT_START:-M0}

source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "PreVariantSuite" "$STAGE" "seed${SEED}"
presure_install_exit_trap
export PYTHONPATH="$ROOT:/scratch/mh20/zw1165/Speed_LLM_RAG/Backbone:/scratch/mh20/zw1165/Speed_LLM_RAG/ExperimentCommon:/scratch/mh20/zw1165/Speed_LLM_RAG/TraffiDent_SupportBench:${PYTHONPATH:-}"
cd "$ROOT"

echo "============================================================"
echo "START PreVariantSuite stage=$STAGE seed=$SEED start=$VARIANT_START"
echo "One PBS allocation / one V100; canonical order: M0 M1 M2 M3 M4 M5"
echo "============================================================"
nvidia-smi

case "$VARIANT_START" in
  M0|M1|M2|M3|M4|M5) ;;
  *) echo "ERROR invalid VARIANT_START=$VARIANT_START (expected M0..M5)" >&2; exit 2 ;;
esac

started=0
for VARIANT in M0 M1 M2 M3 M4 M5; do
  if [[ "$VARIANT" == "$VARIANT_START" ]]; then
    started=1
  fi
  if [[ "$started" -eq 0 ]]; then
    continue
  fi
  echo
  echo "============================================================"
  echo "START $VARIANT $(date '+%F %T')"
  echo "============================================================"
  "$PY" scripts/run_variant.py \
    --variant "$VARIANT" \
    --stage "$STAGE" \
    --seed "$SEED"
  echo "PASS $VARIANT $(date '+%F %T')"
done

echo "============================================================"
echo "PreVariantSuite PASS: ${VARIANT_START}->M5 completed on the same GPU allocation"
echo "============================================================"
