#!/bin/bash
#PBS -P mh20
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=03:00:00
#PBS -l storage=gdata/mh20+scratch/mh20
#PBS -j oe
#PBS -o /scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs/out/
#PBS -N PreDeployRoute
set -euo pipefail
ROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe
LOGROOT=/scratch/mh20/zw1165/Speed_LLM_RAG/PreSuRe_logs
PY=/scratch/mh20/zw1165/envs/TFP/bin/python
STAGE=${STAGE:-development}
SEED=${SEED:-10}
source "$ROOT/scripts/pbs_live_log.sh"
presure_live_log_start "PreDeployRoute" "$STAGE" "seed${SEED}"
cd "$ROOT"
echo "============================================================"
echo "START Deployment-Aligned Utility Router Probe $(date '+%F %T')"
echo "Train: PredNeed-Top10 + PredNeed-Top20 Specialists"
echo "Router: Generic / Hard-q90 / Pred10 / Pred20 expert preference"
echo "All deployment thresholds from Train predicted Need only"
echo "Validation true q90 / oracle router are diagnostic only"
echo "============================================================"
"$PY" scripts/deployment_aligned_router_preflight.py
"$PY" scripts/run_deployment_aligned_utility_router_probe.py --stage "$STAGE" --seed "$SEED"
echo "============================================================"
echo "Deployment-Aligned Utility Router Probe PASS $(date '+%F %T')"
echo "============================================================"
