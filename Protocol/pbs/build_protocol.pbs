#!/bin/bash
#PBS -P PROJECT_CODE
#PBS -q gpuvolta
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/PROJECT_CODE+gdata/PROJECT_CODE
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
PROTOCOL_ROOT="$(pwd)"
ROOT="${SPEED_LLM_RAG_ROOT:-$(cd "${PROTOCOL_ROOT}/.." && pwd)}"
export SPEED_LLM_RAG_ROOT="$ROOT"
PY="${PYTHON:-$(command -v python)}"
STAGE="${STAGE:-development}"
CONFIG="${CONFIG:-${PROTOCOL_ROOT}/configs/protocol_s40.yaml}"

"$PY" scripts/build_protocol.py --stage "$STAGE" --config "$CONFIG"
